---
/**
 * /contact — "Book your Fit Call."
 *
 * Same editorial register as the other pages: eyebrow + typewriter H1, a
 * standfirst, then the Fit Call enquiry form. Copy lives in src/data/contact.ts;
 * the contact email comes from src/config/site.ts.
 *
 * FORM HANDLING — Netlify Forms (no third-party service):
 *   - The <form> carries `data-netlify="true"`, a matching hidden `form-name`
 *     field, and a `netlify-honeypot` field for spam. Netlify detects the form
 *     in the static HTML at deploy time and handles submissions itself.
 *   - The script POSTs the fields (url-encoded, incl. form-name) to Netlify and
 *     shows the inline success state; native validation runs first.
 *   - Netlify stores submissions in the site's Forms dashboard. To get them in
 *     the Outlook/M365 inbox, add ONE email notification in the Netlify UI:
 *       Site configuration → Forms → Form notifications → Add notification →
 *       Email notification → send to SITE.contactEmail (hello@knotless.com.au).
 *   - Netlify Forms only processes on the deployed Netlify site (not local dev).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { href as withBase } from '../lib/href';
import { SITE } from '../config/site';
import { CONTACT } from '../data/contact';

// Form name registered with Netlify (shown in the Forms dashboard). The hidden
// `form-name` field below must match this exactly.
const FORM_NAME = 'fit-call';
const FORM_ACTION = withBase('/contact');
---

<BaseLayout title="Contact Us" description={CONTACT.metaDescription}>
  <section class="pt-20 sm:pt-28">
    <p class="text-label uppercase tracking-tagline text-ink">{CONTACT.eyebrow}</p>
    <h1 class="mt-5 text-[2.4rem] font-semibold leading-[1.02] tracking-[-0.035em] text-ink min-[420px]:text-[2.9rem] sm:text-[3.75rem] md:text-[4.25rem] lg:text-[5.75rem] xl:text-[6.75rem]">
      Book your Fit <span class="emph-type" data-word="Call."
        ><span class="sr-only">Call.</span><span class="ew" aria-hidden="true"
          ><span class="ew-sizer">Call.</span><span class="ew-live"><span class="ew-typed">Call.</span><span class="ew-caret"></span></span></span
        ></span
      ></span>
    </h1>

    <p class="mt-8 max-w-text text-base text-ink sm:text-lg">{CONTACT.body}</p>

    <!-- Fit Call enquiry form, handled by Netlify Forms. `name` + the hidden
         `form-name` must match; `netlify-honeypot` names the anti-spam field.
         Native validation runs first; the script below submits via fetch and
         shows the inline success state. -->
    <form
      class="contact-form mt-12 max-w-text sm:mt-14"
      name={FORM_NAME}
      method="POST"
      action={FORM_ACTION}
      data-netlify="true"
      netlify-honeypot="bot-field"
      novalidate
      aria-describedby="form-status"
    >
      <!-- Required by Netlify for the dashboard/notification routing. -->
      <input type="hidden" name="form-name" value={FORM_NAME} />
      <!-- Honeypot: hidden from people; bots that fill it are dropped by Netlify. -->
      <p class="hidden" aria-hidden="true">
        <label>
          Don’t fill this in if you’re human:
          <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
        {
          CONTACT.fields.map((field) => (
            <div class:list={[field.id === 'name' || field.id === 'company' ? '' : 'sm:col-span-2']}>
              <label for={field.id} class="label block text-ink">
                {field.label}
                {field.optional && <span class="ml-1.5 lowercase tracking-normal text-warm-grey">(optional)</span>}
              </label>
              <input
                id={field.id}
                name={field.id}
                type={field.type}
                autocomplete={field.autocomplete}
                required={field.required}
                class="mt-2 w-full rounded-sm border border-warm-grey bg-white px-4 py-3 text-[1rem] text-ink transition-colors placeholder:text-warm-grey focus:border-ink focus:outline-none focus:ring-1 focus:ring-ink sm:text-base"
              />
            </div>
          ))
        }
      </div>

      <!-- Submit: the primary-button treatment, as a real <button> for the form. -->
      <button
        type="submit"
        class="contact-submit mt-10 inline-block rounded-sm border border-ink bg-ink px-7 py-3 text-label font-medium uppercase tracking-label text-cream no-underline transition-colors hover:bg-cream hover:text-ink disabled:cursor-not-allowed disabled:opacity-60"
      >
        {CONTACT.submitLabel}
      </button>

      <p id="form-status" role="status" aria-live="polite" class="sr-only"></p>
    </form>

    <!-- Success state: hidden until a successful submit, then swapped in.
         `data-reveal` reuses the fade-up + accent-rule draw-in; the strike is
         drawn through "Request". aria-live announces it to screen readers. -->
    <div
      class="contact-success mt-12 hidden max-w-text sm:mt-14"
      data-reveal
      aria-live="polite"
      tabindex="-1"
    >
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        <span class="strike-word">{CONTACT.success.headingWord}</span>{CONTACT.success.headingRest}
      </h2>
      <p class="mt-6 text-base text-ink sm:text-lg">{CONTACT.success.body}</p>
    </div>

    <p class="mt-8 text-base text-ink">
      {CONTACT.altLabel}{' '}
      <a
        href={`mailto:${SITE.contactEmail}`}
        class="font-semibold text-ink underline decoration-warm-grey underline-offset-4 transition-colors hover:decoration-ink"
        >{SITE.contactEmail}</a
      >
    </p>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.querySelector('.contact-form');
    if (!form) return;
    const status = form.querySelector('#form-status');
    const submit = form.querySelector('.contact-submit');
    const success = document.querySelector('.contact-success');
    const submitLabel = submit ? submit.textContent : '';

    const setStatus = (msg) => {
      if (status) status.textContent = msg;
    };

    const showSuccess = () => {
      // Clear the form and restore the button first, so no submitted data lingers
      // in the DOM and a returning user never sees a stale "Sending…".
      if (submit) {
        submit.disabled = false;
        submit.textContent = submitLabel;
      }
      setStatus('');
      form.reset();
      form.classList.add('hidden');

      if (success) {
        success.classList.remove('hidden');
        // Move focus + let aria-live announce immediately (not gated by the anim).
        success.focus();
        // Add .is-visible on the next frames so the fade-up / accent-rule / strike
        // transitions run from their start state instead of snapping. Under
        // reduced motion the CSS defines no transitions, so it just shows drawn.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => success.classList.add('is-visible')),
        );
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Native validation: surface the browser's own messages on invalid fields.
      if (!form.checkValidity()) {
        form.reportValidity();
        setStatus('Please complete the required fields.');
        return;
      }

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        // Netlify Forms: POST the fields url-encoded (including form-name and the
        // honeypot) to the site. Netlify matches on form-name and stores/notifies.
        const body = new URLSearchParams(new FormData(form)).toString();
        const res = await fetch(form.getAttribute('action') || '/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error('Request failed');
        showSuccess();
      } catch (err) {
        setStatus('Something went wrong. Please email us instead.');
        if (submit) {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
      }
    });
  })();
</script>
