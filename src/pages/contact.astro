---
/**
 * /contact
 *
 * Rebuilt on the system /what-we-do settled: the shared type ladder with its
 * step-down under 50rem of HEIGHT, the measured thread, the cursor-light rules,
 * and no utility classes. What went with it: the typewriter H1, the eyebrow,
 * and the "pressed in" success wipe.
 *
 * The hero does NOT hold the screen on its own here, and that is the one place
 * this page departs from the other two. On those, what follows the hero is a
 * section; here it is the form the page exists for, and a hero that pushes the
 * first field under the fold is a hero that costs enquiries.
 *
 * Fields are ruled, not boxed. A bordered input is a box, four of them are four
 * boxes, and the page already has a vocabulary for "a thing on a line".
 *
 * FORM HANDLING — Netlify Forms (no third-party service):
 *   - The <form> carries `data-netlify="true"`, a matching hidden `form-name`
 *     field, and a `netlify-honeypot` field for spam. Netlify detects the form
 *     in the static HTML at deploy time and handles submissions itself.
 *   - The script POSTs the fields (url-encoded, incl. form-name) to Netlify and
 *     shows the inline success state; native validation runs first.
 *   - Netlify stores submissions in the site's Forms dashboard. To get them in
 *     the Outlook/M365 inbox, add ONE email notification in the Netlify UI:
 *       Site configuration → Forms → Form notifications → Add notification →
 *       Email notification → send to SITE.contactEmail (hello@knotless.com.au).
 *   - Netlify Forms only processes on the deployed Netlify site (not local dev).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { href as withBase } from '../lib/href';
import { SITE } from '../config/site';
import { CONTACT } from '../data/contact';

// Form name registered with Netlify (shown in the Forms dashboard). The hidden
// `form-name` field below must match this exactly.
const FORM_NAME = 'fit-call';
const FORM_ACTION = withBase('/contact');
---

<BaseLayout title="Contact Us" description={CONTACT.metaDescription}>
  {/* --- The ask ---------------------------------------------------------- */}
  {/* No opening thread: the thread marks a section within a page, and the top
      of a page is not one. */}
  <section class="chero" data-reveal>
    <h1 class="chero__h r" style="--i: 0">{CONTACT.heading}</h1>
    <p class="chero__body r" style="--i: 1">{CONTACT.body}</p>
  </section>

  {/* --- The form --------------------------------------------------------- */}
  {/* Netlify Forms: `name` + the hidden `form-name` must match, and
      `netlify-honeypot` names the anti-spam field. Native validation runs
      first; the script below submits via fetch and shows the success state. */}
  <section class="cform" data-reveal>
    <form
      class="form r"
      style="--i: 0"
      name={FORM_NAME}
      method="POST"
      action={FORM_ACTION}
      data-netlify="true"
      netlify-honeypot="bot-field"
      novalidate
      aria-describedby="form-status"
    >
      {/* Required by Netlify for the dashboard/notification routing. */}
      <input type="hidden" name="form-name" value={FORM_NAME} />
      {/* Honeypot: hidden from people; bots that fill it are dropped by Netlify. */}
      <p class="form__pot" aria-hidden="true">
        <label>
          Don’t fill this in if you’re human:
          <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <div class="form__grid">
        {
          CONTACT.fields.map((field) => (
            <div class:list={['field', !field.half && 'field--full']}>
              <label class="meta field__label" for={field.id}>
                {field.label}
              </label>
              <input
                class="field__input"
                id={field.id}
                name={field.id}
                type={field.type}
                inputmode={field.inputmode}
                autocomplete={field.autocomplete}
                placeholder={field.placeholder || undefined}
                required
              />
              <span class="field__rule" data-catch="line" aria-hidden="true" />
            </div>
          ))
        }
      </div>

      <button type="submit" class="form__submit">{CONTACT.submitLabel}</button>

      {/* Visible, not sr-only, so a failed submit is not silent for sighted
          users; `:empty` keeps the live region registered and out of the layout
          until it has something to say. Not display:none — that drops it from
          the a11y tree and some screen readers then miss the announcement. */}
      <p id="form-status" class="form__status" role="status" aria-live="polite"></p>
    </form>

    {/* Swapped in for the form on a successful submit. */}
    <div class="sent" data-sent hidden aria-live="polite" tabindex="-1">
      <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <h2 class="sent__h r" style="--i: 1">{CONTACT.success.heading}</h2>
      <p class="sent__body r" style="--i: 2">{CONTACT.success.body}</p>
    </div>

    <p class="alt r" style="--i: 1">
      <span class="alt__label">{CONTACT.altLabel}</span>{' '}
      <a class="alt__link" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
    </p>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.querySelector('.form');
    if (!form) return;
    const status = form.querySelector('#form-status');
    const submit = form.querySelector('.form__submit');
    const sent = document.querySelector('[data-sent]');
    const submitLabel = submit ? submit.textContent : '';

    const setStatus = (msg) => {
      if (status) status.textContent = msg;
    };

    /* A person types "knotless.com.au". type="url" wants a scheme, so the
       browser would reject the only spelling anyone uses. Add it for them,
       before validation, and only when it is missing. */
    const site = form.querySelector('#website');
    const normaliseUrl = () => {
      if (!site) return;
      const v = site.value.trim();
      if (v && !/^[a-z][a-z0-9+.-]*:\/\//i.test(v)) site.value = 'https://' + v;
    };

    const showSuccess = () => {
      // Clear the form and restore the button first, so no submitted data
      // lingers in the DOM and a returning reader never sees a stale "Sending…".
      if (submit) {
        submit.disabled = false;
        submit.textContent = submitLabel;
      }
      setStatus('');
      form.reset();
      form.hidden = true;

      if (sent) {
        sent.hidden = false;
        // Focus + aria-live announce immediately, not gated by the animation.
        sent.focus();
        // .is-visible on the next two frames so the reveal runs from its start
        // state instead of snapping. Under reduced motion the CSS defines no
        // transitions, so it simply shows.
        requestAnimationFrame(() => requestAnimationFrame(() => sent.classList.add('is-visible')));
      }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      normaliseUrl();

      // Native validation: surface the browser's own messages on invalid fields.
      if (!form.checkValidity()) {
        form.reportValidity();
        setStatus('Please complete the three fields.');
        return;
      }

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        // Netlify Forms: POST the fields url-encoded (including form-name and
        // the honeypot). Netlify matches on form-name and stores/notifies.
        const body = new URLSearchParams(new FormData(form)).toString();
        const res = await fetch(form.getAttribute('action') || '/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body,
        });
        if (!res.ok) throw new Error('Request failed');
        showSuccess();
      } catch (err) {
        setStatus('Something went wrong. Please email us instead.');
        if (submit) {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
      }
    });
  })();
</script>

<style>
  /* --- The ask ----------------------------------------------------------- */
  /* Air above the headline where there is screen for it, on the same gates the
     other two pages use: none on a phone or a short viewport, where it would
     come straight out of the first field. */
  .chero {
    padding-top: 0;
  }
  @media (min-width: 48rem) and (min-height: 46rem) {
    .chero {
      padding-top: clamp(1.5rem, 4vh, 3rem);
    }
  }
  @media (min-width: 48rem) and (min-height: 50rem) {
    .chero {
      padding-top: clamp(2.5rem, 7vh, 5rem);
    }
  }
  .chero__h {
    margin: 0;
    /* The local display step the inner pages share: 72px at 1440, a fifth above
       the section headings, and nowhere near --text-display, which is the size
       the homepage sets a wordmark at rather than a sentence. */
    font-size: clamp(2.5rem, 1.4rem + 3.9vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    color: var(--color-cream);
    text-wrap: balance;
    max-width: 16ch;
  }
  .chero__body {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-cream-dim);
    /* 52ch — the site's prose measure, and calibrated rather than assumed: a ch
       is the width of a ZERO, which in Inter is 0.63em while the average
       character is nearer 0.5em. */
    max-width: 52ch;
  }
  /* A laptop is a WIDE screen and a SHORT one — a 1440x900 display is a 1440x760
     viewport once the browser takes its chrome — so the type steps down by
     HEIGHT, which is the constraint that actually binds there. */
  @media (max-height: 50rem) {
    .chero__h {
      font-size: clamp(2.25rem, 1.6rem + 2vw, 3.25rem);
    }
    .chero__body {
      font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
      margin-top: clamp(1rem, 2vh, 1.5rem);
    }
  }

  /* --- The form ---------------------------------------------------------- */
  .cform {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }
  .form__pot {
    display: none;
  }
  .form {
    max-width: 44rem;
  }
  .form__grid {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.25rem);
  }
  @media (min-width: 48rem) {
    .form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--grid-cell);
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }

  /* A field is a label, a line, and what you write on it. The bordered box it
     replaces was a rectangle inside a page that has no other rectangles, and
     three of them read as a form bolted to the design rather than set in it. */
  .field {
    position: relative;
    display: grid;
  }
  .field__label {
    color: var(--color-cream-dim);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .field__input {
    margin-top: 0.7rem;
    padding: 0 0 0.7rem;
    width: 100%;
    background: none;
    border: 0;
    border-radius: 0;
    font-family: var(--font-sans);
    /* 16px is the floor at which iOS Safari stops zooming the page on focus,
       and it is the design's mobile body minimum as well. */
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.4;
    letter-spacing: var(--tracking-tight);
    color: var(--color-cream);
    appearance: none;
  }
  .field__input::placeholder {
    color: var(--color-wire-lit);
  }
  .field__input:focus {
    outline: none; /* replaced below — never simply removed (§11.7) */
  }
  .field__input:focus-visible {
    outline: 2px solid var(--color-ember);
    outline-offset: 6px;
    border-radius: 2px;
  }
  /* The rule is an element, not a border, so it catches the cursor light like
     every other rule on the site — and so it can brighten on focus without the
     input's own box changing size. */
  .field__rule {
    display: block;
    height: 1px;
    background-color: var(--color-line);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .field:focus-within .field__rule {
    background-color: var(--color-cream);
  }
  .field:focus-within .field__label {
    color: var(--color-cream);
  }
  /* The browser's own invalid state, shown only once the reader has been told —
     :user-invalid fires after they have interacted, not while they are typing
     the first character of an email address. */
  .field__input:user-invalid ~ .field__rule {
    background-color: var(--color-wire-lit);
  }

  /* The action. The pill every other call to action on the site wears, as a
     real <button> because it submits a form. */
  .form__submit {
    margin-top: clamp(2.25rem, 4vw, 3rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0 1.6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background-color: var(--color-terracotta);
    color: var(--color-on-accent);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .form__submit:hover,
  .form__submit:focus-visible {
    background-color: var(--color-accent-hover-bg);
    color: var(--color-accent-hover-fg);
  }
  .form__submit:disabled {
    cursor: not-allowed;
    opacity: 0.7;
  }
  @media (max-width: 639px) {
    .form__submit {
      min-height: 2.75rem;
      padding: 0 1.25rem;
    }
  }

  /* Wire, not ember: the page already spends its one accent on the button, and
     a second terracotta mark in the same composition is 11.3. */
  .form__status {
    margin: 1.5rem 0 0;
    border-left: 2px solid var(--color-wire);
    padding-left: 1rem;
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--color-cream);
  }
  .form__status:empty {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* --- Sent -------------------------------------------------------------- */
  .sent__h {
    margin: 1.25rem 0 0;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    color: var(--color-cream);
  }
  .sent__body {
    margin: 1.25rem 0 0;
    font-size: clamp(1.0625rem, 0.95rem + 0.55vw, 1.3125rem);
    line-height: 1.5;
    color: var(--color-cream-dim);
    max-width: 52ch;
  }

  /* --- The other way to reach us ----------------------------------------- */
  .alt {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    font-size: var(--text-md);
    line-height: 1.6;
    color: var(--color-cream-dim);
  }
  .alt__link {
    color: var(--color-cream);
    text-decoration: underline;
    text-decoration-color: var(--color-wire);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .alt__link:hover,
  .alt__link:focus-visible {
    text-decoration-color: var(--color-cream);
  }
</style>
