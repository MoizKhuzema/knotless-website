---
/**
 * Homepage — seven sections. Copy lives in src/data/homepage.ts; founder names,
 * titles, emails and phones in src/config/site.ts.
 *
 * THE ARGUMENT, in order. Each section only earns its place by being the
 * answer to the question the one above it raises:
 *
 *   hero            the claim: we tell you what AI is worth, including when
 *                   the answer is nothing
 *   problem         who says so? three businesses, three stages of the same
 *                   failure, and the finding underneath them
 *   what you get    fine, so what do you actually do about it
 *   industries      and who do you do it for (and why only two)
 *   pricing         what does it cost. Published, because a page that sells
 *                   "we show the working" cannot hide its own number
 *   get started     what happens next
 *
 * SECTION RHYTHM (§05, the two-tier rule). Every section owns its own top
 * break, so the rhythm reads down this file. They all take
 * --spacing-section-lg: with six sections the two-tier rhythm was being
 * asked to mark five boundaries, and a rhythm with five exceptions is not one.
 * If a pair ever needs to read as a single movement, the minor tier is still
 * there for it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import TorchStage from '../components/home/TorchStage.astro';
import HeroSection from '../components/home/HeroSection.astro';
import ProblemSection from '../components/home/ProblemSection.astro';
import WhatYouGetSection from '../components/home/WhatYouGetSection.astro';
import IndustriesSection from '../components/home/IndustriesSection.astro';
import PricingSection from '../components/home/PricingSection.astro';
import GetStartedSection from '../components/home/GetStartedSection.astro';
import { META } from '../data/homepage';
import { graph, organization, website, webPage } from '../lib/schema';

const title = 'Home';
const description = META.description;
const origin = Astro.site!.origin;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Connected @graph: the canonical Organization + WebSite, plus this WebPage.
// Founder Person nodes stay on /about — the @ids are origin-anchored, so
// duplicating them here would add nothing.
const schema = graph([
  organization(origin),
  website(origin),
  webPage(origin, { url: pageUrl, name: title, description }),
]);
---

<!-- The hero carries its own plain mark at the top left now, which is why the
     sticky bar stays away until the hero has gone: the same wordmark on screen
     twice is one too many.

     KnotIntro is gone. The overlay's whole sequence was a thread that
     ties itself, pulls straight and LANDS on the terracotta strike inside the
     hero lockup — it finds that rect with [data-strike] and bails if it is not
     there. With the lockup gone the animation has no destination, so leaving
     the component mounted would just run a gate script that hides the page and
     then tears itself down. -->
<BaseLayout title={title} description={description} schema={schema} bleed>
  {/* One torch lights both: it starts at the bottom of the hero and rides up,
      turns and grows into the problem section as the page scrolls. They are
      wrapped together because the light is continuous across them. */}
  <TorchStage>
    <HeroSection />
    <ProblemSection />
  </TorchStage>
  <WhatYouGetSection />
  <IndustriesSection />
  <PricingSection />
  <GetStartedSection />
</BaseLayout>
