---
/**
 * Homepage — three sections: hero, what you get, how to get started. Copy
 * lives in src/data/homepage.ts.
 *
 * SECTION RHYTHM (§05, the two-tier rule). Two breaks, both major:
 *
 *   hero            -> what you get        144px   the mark and the promise
 *                                                  end, the argument begins
 *   what you get    -> how to get started  144px   the substance ends, the
 *                                                  close begins
 *
 * Each section owns its own top break, so the rhythm reads down this file.
 * There is no minor tier on this page: with the middle section gone, both
 * remaining breaks are movements, and §05's warning cuts the other way — a
 * 96px break between the only two things on the page would read as a stumble,
 * not a rest.
 *
 * The pricing calculator §09 reserves a slot for drops in between What you get
 * and How to get started, on the same .sidehead grid: one file here and one
 * line below. That is where --spacing-section earns its place, taking the
 * rhythm to 144/96/144.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import KnotIntro from '../components/KnotIntro.astro';
import HeroSection from '../components/home/HeroSection.astro';
import WhatYouGetSection from '../components/home/WhatYouGetSection.astro';
import GetStartedSection from '../components/home/GetStartedSection.astro';
import { META } from '../data/homepage';
import { graph, organization, website, webPage } from '../lib/schema';

const title = 'Home';
const description = META.description;
const origin = Astro.site!.origin;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Connected @graph: the canonical Organization + WebSite, plus this WebPage.
const schema = graph([
  organization(origin),
  website(origin),
  webPage(origin, { url: pageUrl, name: title, description }),
]);
---

<!-- navReveal: the hero carries both the wordmark and the call to action, so
     the nav's flanks stay empty until the hero's button scrolls under the bar.
     See Nav.astro. -->
<BaseLayout title={title} description={description} schema={schema} navReveal bleed>
  {/* First in the slot on purpose: its gate script is synchronous, so it must
      run while the parser is still ABOVE the hero. Revealing the overlay any
      later would show the hero and then cover it. */}
  <KnotIntro />
  <HeroSection />
  <WhatYouGetSection />
  <GetStartedSection />
</BaseLayout>
