---
/**
 * Homepage. Hero (Treatment B — "Strike") + the three content sections, all in
 * the same editorial register. Copy lives in src/data/homepage.ts; founder
 * names and site-wide values in src/config/site.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVisual from '../components/hero/HeroVisual.astro';
import AssessmentSection from '../components/home/AssessmentSection.astro';
import FoundersSection from '../components/home/FoundersSection.astro';
import FinalCtaSection from '../components/home/FinalCtaSection.astro';
import { HERO } from '../data/homepage';
import { graph, organization, website, webPage } from '../lib/schema';

const title = 'Home';
const description = HERO.subhead;
const origin = Astro.site!.origin;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Connected @graph: the canonical Organization + WebSite, plus this WebPage.
const schema = graph([
  organization(origin),
  website(origin),
  webPage(origin, { url: pageUrl, name: title, description }),
]);
---

<BaseLayout title={title} description={description} schema={schema}>
  <HeroVisual />
  <AssessmentSection />
  <FoundersSection />
  <FinalCtaSection />
</BaseLayout>
