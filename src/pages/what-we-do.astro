---
/**
 * /what-we-do — "One product. The whole story."
 *
 * Same editorial register as the homepage: accent-rule + heading blocks,
 * disclosure accordions for the stages and FAQs, a two-outcomes fork for the
 * build, and the reversed-Ink final CTA. Copy lives in src/data/whatWeDo.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButton from '../components/CtaButton.astro';
import { graph, webPage, service } from '../lib/schema';
import {
  WWD_INTRO,
  WWD_QUESTIONS,
  WWD_STAGES,
  WWD_IMPLEMENTATION,
  WWD_FAQS,
  WWD_FINAL_CTA,
} from '../data/whatWeDo';

const whoBullets = [
  WWD_IMPLEMENTATION.whoFirst,
  WWD_IMPLEMENTATION.whoDelivery,
  WWD_IMPLEMENTATION.whoLast,
];

// Plain-text intro body for the meta description (strip the emphasis markers).
const introDescription = WWD_INTRO.bodyParts
  .map((p) => (typeof p === 'string' ? p : p.strong))
  .join('');

const origin = Astro.site!.origin;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// Service node (provided by the Organization) + this WebPage.
const schema = graph([
  webPage(origin, { url: pageUrl, name: 'What We Do', description: introDescription }),
  service(origin, {
    url: pageUrl,
    name: 'AI Assessment and Implementation',
    serviceType: 'Artificial intelligence consulting',
    description: introDescription,
  }),
]);
---

<BaseLayout title="What We Do" description={introDescription} schema={schema}>
  <!-- Section 1 — page intro. On mobile it fills the first screen (content
       centred) so the next section sits below the fold and reveals on scroll;
       top-aligned from sm up. -->
  <section class="hero-screen sm:pt-28">
    <p class="text-label uppercase tracking-tagline text-ink">{WWD_INTRO.eyebrow}</p>
    <h1 class="mt-5 text-[2.4rem] font-semibold leading-[1.02] tracking-[-0.035em] text-ink min-[420px]:text-[2.9rem] sm:text-[3.75rem] md:text-[4.25rem] lg:text-[5.75rem] xl:text-[6.75rem]">
      One <span class="emph-type" data-word="product."
        ><span class="sr-only">product.</span><span class="ew" aria-hidden="true"
          ><span class="ew-sizer">product.</span><span class="ew-live"><span class="ew-typed">product.</span><span class="ew-caret"></span></span></span
        ></span
      ><br />Whole story.
    </h1>
    <p class="mt-8 max-w-text text-base text-ink sm:text-lg">
      {
        WWD_INTRO.bodyParts.map((p) =>
          typeof p === 'string' ? p : <strong class="font-semibold text-terracotta">{p.strong}</strong>,
        )
      }
    </p>
    <div class="mt-8">
      <CtaButton href={WWD_INTRO.cta.href}>{WWD_INTRO.cta.label}</CtaButton>
    </div>
  </section>

  <!-- Section 2 — the questions people bring us -->
  <section class="pt-section-lg">
    <div data-reveal>
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {WWD_QUESTIONS.heading}
      </h2>
      <p class="mt-6 max-w-text text-base text-ink">{WWD_QUESTIONS.lead}</p>
    </div>

    {/* A horizontal, snap-scrolling carousel on every viewport: swipe / trackpad
        on touch, plus prev/next arrows and gentle autoplay on desktop. The next
        card peeks to signal there's more. */}
    <div data-reveal class="relative mt-10 sm:mt-14">
      <button
        type="button"
        class="vig-prev absolute left-1 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-warm-grey bg-cream text-ink transition-colors hover:bg-ink hover:text-cream sm:flex"
        aria-label="Previous statements"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
      </button>
      <button
        type="button"
        class="vig-next absolute right-1 top-1/2 z-20 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-warm-grey bg-cream text-ink transition-colors hover:bg-ink hover:text-cream sm:flex"
        aria-label="Next statements"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
      </button>
      <div class="vig-track -mx-gutter flex snap-x snap-mandatory gap-4 overflow-x-auto px-gutter pb-4 sm:mx-0 sm:gap-6 sm:px-0">
        {
          WWD_QUESTIONS.vignettes.map((v) => (
            <article
              class="group flex w-[80%] shrink-0 snap-center flex-col rounded-sm border border-warm-grey p-5 transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:border-ink hover:bg-ink sm:w-[46%] sm:p-7 lg:w-[31%]"
            >
              <p class="text-lg font-medium leading-snug tracking-tight text-ink transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:text-cream">
                “{v.quote}”
              </p>
              <p class="mt-3 text-sm italic text-ink transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:text-cream sm:mt-4">
                {v.who}
              </p>
            </article>
          ))
        }
      </div>
    </div>

    <!-- No max-width so the closing line stays on one row where space allows. -->
    <p data-reveal class="mt-14 text-base text-ink">{WWD_QUESTIONS.close}</p>
  </section>

  <!-- Section 3 — what you get at each stage -->
  <section class="pt-section-lg">
    <div data-reveal class="max-w-text">
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {WWD_STAGES.heading}
      </h2>
      <p class="mt-6 text-base text-ink">{WWD_STAGES.lead}</p>
    </div>

    {/* Stage selector: pick one stage, see only its detail. Tabs are scrollable
        pills on mobile and a vertical rail on desktop — distinct from the
        homepage stepper/rows and the questions carousel. Progressive: with no JS,
        the first panel shows. */}
    <div data-reveal class="mt-10 sm:mt-14 sm:grid sm:grid-cols-12 sm:gap-10 lg:gap-14">
      <div
        role="tablist"
        aria-label="Assessment stages"
        class="stage-tabs -mx-gutter flex gap-2 overflow-x-auto px-gutter pb-1 sm:col-span-5 sm:mx-0 sm:flex-col sm:gap-0 sm:overflow-visible sm:border-l sm:border-warm-grey sm:px-0 sm:pb-0 lg:col-span-4"
      >
        {
          WWD_STAGES.stages.map((stage, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${stage.id}`}
              aria-controls={`panel-${stage.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class="stage-tab"
            >
              {stage.title}
            </button>
          ))
        }
      </div>

      <div class="mt-8 sm:col-span-7 sm:mt-0 lg:col-span-8">
        {
          WWD_STAGES.stages.map((stage, i) => (
            <div
              role="tabpanel"
              id={`panel-${stage.id}`}
              aria-labelledby={`tab-${stage.id}`}
              hidden={i !== 0}
              tabindex="0"
              class="stage-panel"
            >
              <p class="text-base italic leading-snug text-ink">{stage.oneLiner}</p>
              <div class="mt-6 grid gap-8 sm:grid-cols-2">
                <div>
                  <p class="text-base font-semibold text-ink">{WWD_STAGES.labels.whatWeDo}</p>
                  <ul class="mt-3 space-y-2.5">
                    {stage.whatWeDo.map((item) => (
                      <li class="flex gap-3 text-ink">
                        <span aria-hidden="true" class="mt-[0.62em] h-px w-3 shrink-0 bg-warm-grey" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="text-base font-semibold text-ink">{WWD_STAGES.labels.walkAway}</p>
                  <ul class="mt-3 space-y-2.5">
                    {stage.walkAway.map((item) => (
                      <li class="flex gap-3 text-ink">
                        <span aria-hidden="true" class="mt-[0.62em] h-px w-3 shrink-0 bg-warm-grey" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 4 — implementation -->
  <section class="pt-section-lg">
    <div data-reveal class="max-w-text">
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {WWD_IMPLEMENTATION.heading}
      </h2>
    </div>

    {/* Decision fork: after the findings, two honest outcomes branch from one
         point. A small org-chart fork on desktop; a left-spine branch on mobile. */}
    <div data-reveal class="mt-12 sm:mt-16">
      <div class="relative grid gap-y-10 pl-6 sm:grid-cols-2 sm:gap-x-16 sm:pl-0">
        <!-- desktop: a terracotta decision node at the centre + a line the two
             outcomes flank symmetrically (right-aligned left / left-aligned right) -->
        <span class="absolute left-1/2 top-0 hidden h-2.5 w-2.5 -translate-x-1/2 rounded-full bg-terracotta sm:block" aria-hidden="true"></span>
        <span class="absolute bottom-0 left-1/2 top-3 hidden w-px -translate-x-1/2 bg-warm-grey sm:block" aria-hidden="true"></span>
        <!-- mobile: a left spine + node the two outcomes branch from -->
        <span class="absolute left-1 top-2 bottom-2 w-px bg-warm-grey sm:hidden" aria-hidden="true"></span>
        <span class="absolute left-1 top-0 h-2.5 w-2.5 -translate-x-1/2 rounded-full bg-terracotta sm:hidden" aria-hidden="true"></span>

        <div class="relative sm:pt-6 sm:text-right">
          <span class="absolute right-full top-[0.7em] h-px w-5 bg-warm-grey sm:hidden" aria-hidden="true"></span>
          <p class="text-base font-semibold text-ink">{WWD_IMPLEMENTATION.fork.no.label}</p>
          <p class="mt-3 text-ink sm:ml-auto sm:max-w-prose">{WWD_IMPLEMENTATION.fork.no.body}</p>
        </div>
        <div class="relative sm:pt-6">
          <span class="absolute right-full top-[0.7em] h-px w-5 bg-warm-grey sm:hidden" aria-hidden="true"></span>
          <p class="text-base font-semibold text-terracotta">{WWD_IMPLEMENTATION.fork.yes.label}</p>
          <p class="mt-3 text-ink">{WWD_IMPLEMENTATION.fork.yes.lead}</p>
          <ul class="mt-4 space-y-2.5">
            {
              WWD_IMPLEMENTATION.fork.yes.points.map((item) => (
                <li class="flex gap-3 text-ink">
                  <span aria-hidden="true" class="mt-[0.62em] h-px w-3 shrink-0 bg-warm-grey" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Who does the work: the founders, the delivery choice, the single channel —
         set as hairline-separated principles (distinct from the dash lists). -->
    <div data-reveal class="mt-16 max-w-text">
      <p class="text-base font-semibold text-ink">{WWD_IMPLEMENTATION.whoHeading}</p>
      <div class="mt-6 border-t border-warm-grey">
        {whoBullets.map((item) => <p class="border-b border-warm-grey py-4 text-ink">{item}</p>)}
      </div>
    </div>
  </section>

  <!-- Section 5 — FAQs -->
  <section class="pt-section-lg">
    <div data-reveal>
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {WWD_FAQS.heading}
      </h2>
    </div>

    <div class="mt-12 border-t border-warm-grey">
      {
        WWD_FAQS.items.map((item) => (
          <details data-reveal class="border-b border-warm-grey">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-lg font-semibold tracking-tight text-ink [&::-webkit-details-marker]:hidden">
              <span>{item.q}</span>
              <svg
                class="disclosure-chevron h-5 w-5 shrink-0 text-warm-grey"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <p class="max-w-prose pb-6 text-ink">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Section 6 — final CTA (reversed Ink panel) -->
  <section class="pt-section-lg">
    <div data-reveal class="on-ink flex flex-col items-center rounded-sm px-6 py-20 text-center">
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight sm:text-3xl">{WWD_FINAL_CTA.heading}</h2>
      <p class="mt-4 max-w-prose text-base text-cream">{WWD_FINAL_CTA.body}</p>
      <div class="mt-9">
        <CtaButton href={WWD_FINAL_CTA.cta.href} variant="inverse">
          {WWD_FINAL_CTA.cta.label}
        </CtaButton>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // "Sound familiar?" carousel: prev/next arrows, native swipe/trackpad scroll,
  // and gentle autoplay on desktop (paused on hover/focus, off-screen, hidden
  // tab, and under reduced motion). Mobile relies on swipe (no autoplay).
  (() => {
    const track = document.querySelector('.vig-track');
    if (!track) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = () => window.matchMedia('(min-width: 640px)').matches;
    const prev = document.querySelector('.vig-prev');
    const next = document.querySelector('.vig-next');

    const stepX = () => {
      const card = track.querySelector('article');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 16;
      return card ? card.offsetWidth + gap : track.clientWidth;
    };
    const maxLeft = () => track.scrollWidth - track.clientWidth;
    const go = (dir) => {
      const behavior = reduce ? 'auto' : 'smooth';
      if (dir > 0 && track.scrollLeft >= maxLeft() - 2) return track.scrollTo({ left: 0, behavior });
      if (dir < 0 && track.scrollLeft <= 2) return track.scrollTo({ left: maxLeft(), behavior });
      track.scrollBy({ left: dir * stepX(), behavior });
    };
    if (prev) prev.addEventListener('click', () => go(-1));
    if (next) next.addEventListener('click', () => go(1));

    // Autoplay ping-pongs so it never makes a long jump back to the start.
    let timer = null;
    let dir = 1;
    const tick = () => {
      if (dir > 0 && track.scrollLeft >= maxLeft() - 2) dir = -1;
      else if (dir < 0 && track.scrollLeft <= 2) dir = 1;
      track.scrollBy({ left: dir * stepX(), behavior: 'smooth' });
    };
    const start = () => {
      if (reduce || timer || !wide()) return;
      timer = setInterval(tick, 4500);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };
    ['pointerenter', 'focusin'].forEach((e) => track.addEventListener(e, stop));
    ['pointerleave', 'focusout'].forEach((e) => track.addEventListener(e, start));
    [prev, next].forEach((b) => {
      if (!b) return;
      b.addEventListener('pointerenter', stop);
      b.addEventListener('pointerleave', start);
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
        { threshold: 0.2 },
      ).observe(track);
    } else {
      start();
    }
  })();
</script>

<script is:inline>
  // "What you get at each stage" tabs: show one stage panel at a time, with
  // roving-tabindex + arrow-key support. No-JS shows the first panel only.
  (() => {
    const tablist = document.querySelector('[role="tablist"][aria-label="Assessment stages"]');
    if (!tablist) return;
    const tabs = [...tablist.querySelectorAll('[role="tab"]')];
    const select = (tab, focus) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls'));
        if (panel) panel.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        let n = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = tabs[(i + 1) % tabs.length];
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = tabs[(i - 1 + tabs.length) % tabs.length];
        else if (e.key === 'Home') n = tabs[0];
        else if (e.key === 'End') n = tabs[tabs.length - 1];
        if (n) {
          e.preventDefault();
          select(n, true);
        }
      });
    });
  })();
</script>

<style>
  /* Disclosure chevron (stages + FAQ): rotates when its <details> is open. */
  .disclosure-chevron {
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  details[open] .disclosure-chevron {
    transform: rotate(180deg);
  }

  /* "Sound familiar?" carousel: hide the scrollbar (still scrollable via swipe,
     trackpad and the arrows). */
  .vig-track {
    scrollbar-width: none; /* Firefox */
  }
  .vig-track::-webkit-scrollbar {
    display: none; /* WebKit / Chromium */
  }
  .stage-tabs {
    scrollbar-width: none;
  }
  .stage-tabs::-webkit-scrollbar {
    display: none;
  }

  /* Stage tabs: pills on mobile, a vertical rail on desktop. */
  .stage-tab {
    flex-shrink: 0;
    white-space: nowrap;
    border: 1px solid var(--color-warm-grey);
    border-radius: 9999px;
    padding: 0.5rem 1rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .stage-tab[aria-selected='true'] {
    background-color: var(--color-ink);
    color: var(--color-cream);
    border-color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .stage-tab {
      white-space: normal;
      border: 0;
      border-left: 2px solid transparent;
      border-radius: 0;
      margin-left: -1px;
      padding: 0.625rem 1.25rem;
      text-align: left;
      font-size: var(--text-base);
      color: var(--color-warm-grey);
    }
    .stage-tab:hover {
      color: var(--color-ink);
    }
    .stage-tab[aria-selected='true'] {
      background-color: transparent;
      border-left-color: var(--color-terracotta);
      color: var(--color-ink);
      font-weight: 600;
    }
  }
  .stage-panel:focus-visible {
    outline: none;
  }
</style>
