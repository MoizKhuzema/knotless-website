---
/**
 * /what-we-do — "One product. The whole story."
 *
 * Same editorial register as the homepage: accent-rule + heading blocks,
 * oversized warm-grey numerals for the stages, hairline-separated rows, the
 * reversed-Ink final CTA. Copy lives in src/data/whatWeDo.ts; the delivery
 * bullet and Privacy-Act wording are pulled from src/config/site.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButton from '../components/CtaButton.astro';
import { SITE } from '../config/site';
import {
  WWD_INTRO,
  WWD_QUESTIONS,
  WWD_PROCESS,
  WWD_STAGES,
  WWD_IMPLEMENTATION,
  WWD_FAQS,
  WWD_FINAL_CTA,
} from '../data/whatWeDo';

// The delivery bullet is the one place the page reaches into site.ts, so the
// build regions and Privacy-Act phrasing stay single-sourced.
const [primary, lowerCost] = SITE.deliveryLocations;
const deliveryBullet = `Technical delivery is handled by a small set of vetted partner firms in ${SITE.deliveryLocations.join(
  ' and ',
)}. You choose where your build is delivered: ${primary} delivery, or ${lowerCost} delivery at a lower cost. Either way it’s disclosed up front, with every data flow ${SITE.privacyActWording} the Australian Privacy Act.`;
const whoBullets = [WWD_IMPLEMENTATION.whoFirst, deliveryBullet, WWD_IMPLEMENTATION.whoLast];

// Plain-text intro body for the meta description (strip the emphasis markers).
const introDescription = WWD_INTRO.bodyParts
  .map((p) => (typeof p === 'string' ? p : p.strong))
  .join('');
---

<BaseLayout title="What we do" description={introDescription}>
  <!-- Section 1 — page intro (same register as the hero) -->
  <section class="pt-20 pb-section sm:pt-28">
    <p class="text-label uppercase tracking-tagline text-ink">{WWD_INTRO.eyebrow}</p>
    <h1 class="mt-5 text-[2.8rem] font-semibold leading-[1.04] tracking-tight text-ink sm:text-5xl">
      {WWD_INTRO.heading.map((line, i) => (i === 0 ? line : <><br />{line}</>))}
    </h1>
    <p class="r r-2 mt-7 max-w-text text-lg text-ink">
      {
        WWD_INTRO.bodyParts.map((p) =>
          typeof p === 'string' ? p : <strong class="font-semibold text-terracotta">{p.strong}</strong>,
        )
      }
    </p>
  </section>

  <!-- Section 2 — the questions people bring us -->
  <section class="pt-section-lg">
    <div data-reveal>
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {WWD_QUESTIONS.heading}
      </h2>
      <p class="mt-6 max-w-text text-lg text-ink">{WWD_QUESTIONS.lead}</p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 sm:auto-rows-fr">
      {
        WWD_QUESTIONS.vignettes.map((v) => (
          <article
            data-reveal
            class="flex h-full flex-col rounded-sm border border-warm-grey p-6 sm:p-7"
          >
            <p class="text-xl font-medium leading-snug tracking-tight text-ink">“{v.quote}”</p>
            <p class="mt-4 italic text-ink">{v.who}</p>
          </article>
        ))
      }
    </div>

    <!-- No max-width so the closing line stays on one row where space allows. -->
    <p data-reveal class="mt-14 text-lg text-ink">{WWD_QUESTIONS.close}</p>
  </section>

  <!-- Process strip — steps stretched edge-to-edge, joined by equal-length
       connecting arrows (a growing hairline + arrowhead). Stacks with
       down-arrows on mobile. -->
  <section class="pt-section-lg">
    <ol
      data-reveal
      class="flex flex-col items-center gap-4 border-y border-warm-grey py-8 text-base font-medium text-ink sm:flex-row sm:gap-4"
    >
      {
        WWD_PROCESS.map((step, i) => (
          <>
            {i > 0 && (
              <li
                aria-hidden="true"
                class="flex items-center justify-center text-warm-grey sm:flex-1"
              >
                <span class="hidden h-px flex-1 bg-warm-grey sm:block" />
                <svg
                  class="h-5 w-5 shrink-0 rotate-90 sm:-ml-px sm:rotate-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </li>
            )}
            <li class="shrink-0 text-center">{step}</li>
          </>
        ))
      }
    </ol>
  </section>

  <!-- Section 3 — what you get at each stage -->
  <section class="pt-section-lg">
    <div data-reveal class="max-w-text">
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {WWD_STAGES.heading}
      </h2>
      <p class="mt-6 text-lg text-ink">{WWD_STAGES.lead}</p>
    </div>

    <div class="mt-16 border-t border-warm-grey">
      {
        WWD_STAGES.stages.map((stage) => (
          <article
            id={stage.id}
            data-reveal
            class="scroll-mt-24 border-b border-warm-grey py-12 sm:grid sm:grid-cols-12 sm:gap-x-8 sm:gap-y-0"
          >
            {/* Left: the stage identity. Name is a quiet label; the self-ID
                tagline is the prominent line a visitor scans to recognise
                themselves. */}
            <div class="sm:col-span-4">
              <p class="label text-ink">{stage.title}</p>
              <p class="mt-3 text-xl font-medium leading-snug tracking-tight text-ink">
                {stage.oneLiner}
              </p>
            </div>

            {/* Right: what we do / what you walk away with. */}
            <div class="mt-8 grid gap-8 sm:col-span-8 sm:mt-0 sm:grid-cols-2">
              <div>
                <p class="label text-ink">{WWD_STAGES.labels.whatWeDo}</p>
                <ul class="mt-3 space-y-2.5">
                  {stage.whatWeDo.map((item) => (
                    <li class="flex gap-3 text-ink">
                      <span aria-hidden="true" class="mt-[0.62em] h-px w-3 shrink-0 bg-warm-grey" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="label text-ink">{WWD_STAGES.labels.walkAway}</p>
                <ul class="mt-3 space-y-2.5">
                  {stage.walkAway.map((item) => (
                    <li class="flex gap-3 text-ink">
                      <span aria-hidden="true" class="mt-[0.62em] h-px w-3 shrink-0 bg-warm-grey" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Section 4 — implementation -->
  <section class="pt-section-lg">
    <div data-reveal class="max-w-text">
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {WWD_IMPLEMENTATION.heading}
      </h2>
    </div>

    <p data-reveal class="mt-6 max-w-prose text-lg text-ink">{WWD_IMPLEMENTATION.walkAway}</p>

    <div data-reveal class="mt-12 max-w-text">
      <p class="label text-ink">{WWD_IMPLEMENTATION.buildHeading}</p>
      <p class="mt-3 text-ink">{WWD_IMPLEMENTATION.buildLead}</p>
      <ul class="mt-4 space-y-2.5">
        {
          WWD_IMPLEMENTATION.build.map((item) => (
            <li class="flex gap-3 text-ink">
              <span aria-hidden="true" class="mt-[0.62em] h-px w-3 shrink-0 bg-warm-grey" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div data-reveal class="mt-12 max-w-text">
      <p class="label text-ink">{WWD_IMPLEMENTATION.whoHeading}</p>
      <ul class="mt-4 space-y-2.5">
        {
          whoBullets.map((item) => (
            <li class="flex gap-3 text-ink">
              <span aria-hidden="true" class="mt-[0.62em] h-px w-3 shrink-0 bg-warm-grey" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <p data-reveal class="mt-10 max-w-prose text-lg text-ink">{WWD_IMPLEMENTATION.close}</p>
  </section>

  <!-- Section 5 — FAQs -->
  <section class="pt-section-lg">
    <div data-reveal>
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {WWD_FAQS.heading}
      </h2>
    </div>

    <dl class="mt-12 border-t border-warm-grey">
      {
        WWD_FAQS.items.map((item) => (
          <div data-reveal class="border-b border-warm-grey py-8 sm:grid sm:grid-cols-12 sm:gap-8">
            <dt class="text-lg font-semibold tracking-tight text-ink sm:col-span-4">{item.q}</dt>
            <dd class="mt-3 max-w-prose text-ink sm:col-span-8 sm:mt-0">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Section 6 — final CTA (reversed Ink panel) -->
  <section class="pt-section-lg">
    <div data-reveal class="on-ink flex flex-col items-center rounded-sm px-6 py-20 text-center">
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-3xl font-semibold tracking-tight sm:text-4xl">{WWD_FINAL_CTA.heading}</h2>
      <p class="mt-4 max-w-prose text-lg text-cream">{WWD_FINAL_CTA.body}</p>
      <div class="mt-9">
        <CtaButton href={WWD_FINAL_CTA.cta.href} variant="inverse">
          {WWD_FINAL_CTA.cta.label}
        </CtaButton>
      </div>
    </div>
  </section>
</BaseLayout>
