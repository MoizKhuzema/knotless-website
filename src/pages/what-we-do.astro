---
/**
 * /what-we-do
 *
 * Rebuilt on the homepage's system rather than the utility-class layout it had:
 * the measured thread opening every section, glass panes on the page's own
 * column grid, the cursor-light variants (ring / line / dot), the shared type
 * ladder, and the reversed panel to close.
 *
 * The old page's machinery is gone with it — a snap-scrolling carousel with
 * autoplay, a roving-tabindex tab rail, and disclosure accordions. Three
 * interaction models on one page, none of them used anywhere else on the site.
 * The content underneath was six quotes, two lists and seven commitments, and
 * that is what it is set as now.
 *
 * Copy lives in src/data/whatWeDo.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButton from '../components/CtaButton.astro';
import { graph, webPage, service } from '../lib/schema';
import {
  WWD_HERO,
  WWD_META,
  WWD_QUESTIONS,
  WWD_ASSESSMENT,
  WWD_IMPLEMENTATION,
  WWD_CLOSE,
} from '../data/whatWeDo';

const origin = Astro.site!.origin;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = graph([
  webPage(origin, { url: pageUrl, name: 'What We Do', description: WWD_META.description }),
  service(origin, {
    url: pageUrl,
    name: 'AI Assessment and Implementation',
    serviceType: 'Artificial intelligence consulting',
    description: WWD_META.description,
  }),
]);
---

<BaseLayout title="What We Do" description={WWD_META.description} schema={schema}>
  {/* --- Section 1 — hero ------------------------------------------------ */}
  <section class="whero" data-reveal>
    <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
    <h1 class="whero__h r" style="--i: 1">{WWD_HERO.heading}</h1>
    <p class="whero__body r" style="--i: 2">{WWD_HERO.body}</p>
  </section>

  {/* --- Section 2 — sound familiar? ------------------------------------- */}
  <section class="sect">
    <div data-reveal>
      <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <h2 class="h-section sect__h r" style="--i: 1">{WWD_QUESTIONS.heading}</h2>
      <p class="sect__lead r" style="--i: 2">{WWD_QUESTIONS.lead}</p>
    </div>

    {/* One row, scrolled. The controls sit above the track rather than over the
        cards: an arrow floating on top of a quote covers the thing it is there
        to help you read. */}
    <div class="vwrap" data-reveal>
      <div class="vnav r" style="--i: 0">
        <button type="button" class="vbtn" data-vig="-1" aria-label="Previous statements">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
        </button>
        <button type="button" class="vbtn" data-vig="1" aria-label="Next statements">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg>
        </button>
      </div>

      {/* tabindex + a label make the track a real keyboard stop: a scroll
          container is only reachable by keyboard if it can be focused, and left
          and right then step it by a card. */}
      <ul
        class="vtrack r"
        data-vig-track
        tabindex="0"
        role="group"
        aria-label="What clients tell us"
        style="--i: 1"
      >
        {
          WWD_QUESTIONS.vignettes.map((v) => (
            <li class="vcard" data-catch="ring">
              <p class="vcard__q">“{v.quote}”</p>
              <span class="vcard__rule" data-catch="line" aria-hidden="true" />
              <p class="vcard__who">{v.who}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* --- Section 3 — the Assessment -------------------------------------- */}
  <section class="sect">
    <div data-reveal>
      <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <h2 class="h-section sect__h r" style="--i: 1">{WWD_ASSESSMENT.heading}</h2>
    </div>

    {/* Two panes, no ordinals and no connector: the homepage's stages carry
        both because they are a sequence, and these two are facets of one
        thing. */}
    <ul class="apanes" data-reveal>
      {
        WWD_ASSESSMENT.blocks.map((block, i) => (
          <li class="apane r" data-catch="ring" style={`--i: ${i}`}>
            <h3 class="apane__h">{block.title}</h3>
            <span class="apane__rule" data-catch="line" aria-hidden="true" />
            <ul class="alist">
              {block.points.map((point) => (
                <li class="aitem">
                  <span class="adot" data-catch="dot" aria-hidden="true" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  {/* --- Section 4 — implementation --------------------------------------- */}
  <section class="sect">
    <div data-reveal>
      <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <h2 class="h-section sect__h r" style="--i: 1">{WWD_IMPLEMENTATION.heading}</h2>
    </div>

    {/* No pane here, on purpose. Two pane-heavy sections and the cream slab sit
        either side of this one; set plainly on the page it gives the eye a rest
        and stops the page reading as a stack of boxes. */}
    <div class="impl" data-reveal>
      <span class="impl__rule r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <ul class="impl__list">
        {
          WWD_IMPLEMENTATION.points.map((point, i) => (
            <li class="impl__item r" style={`--i: ${i + 1}`}>
              <span class="adot" data-catch="dot" aria-hidden="true" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* --- Section 5 — the close -------------------------------------------- */}
  <section class="sect">
    <div class="wclose" data-reveal>
      <div class="wclose__inner">
        <span class="rule-thread wclose__rule r" data-catch="line" aria-hidden="true" style="--i: 0"
        ></span>
        <h2 class="h-section wclose__h r" style="--i: 1">{WWD_CLOSE.heading}</h2>
        <p class="wclose__body r" style="--i: 2">{WWD_CLOSE.body}</p>
        <div class="wclose__cta r" style="--i: 3">
          <CtaButton href={WWD_CLOSE.cta.href} variant="inverse">{WWD_CLOSE.cta.label}</CtaButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /* The "Sound familiar?" row: arrows, keyboard, and a slow drift.
   *
   * Native overflow does the scrolling — swipe, trackpad and momentum come free
   * and behave the way the platform's do. Everything here only moves scrollLeft.
   *
   * The drift PING-PONGS rather than looping to the start. A jump from the last
   * card back to the first is the one movement a reader cannot follow, because
   * nothing on screen explains it.
   *
   * It stops for: a pointer over it, focus inside it, a hidden tab, being
   * scrolled off screen, and prefers-reduced-motion — under which it never
   * starts at all. Motion that carries content has to be interruptible by the
   * person reading it.
   */
  (() => {
    const track = document.querySelector('[data-vig-track]');
    if (!track) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const step = () => {
      const card = track.querySelector('li');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card ? card.getBoundingClientRect().width + gap : track.clientWidth;
    };
    const maxLeft = () => track.scrollWidth - track.clientWidth;
    const go = (dir) => {
      const behavior = reduce.matches ? 'auto' : 'smooth';
      const at = track.scrollLeft;
      if (dir > 0 && at >= maxLeft() - 2) return track.scrollTo({ left: 0, behavior });
      if (dir < 0 && at <= 2) return track.scrollTo({ left: maxLeft(), behavior });
      track.scrollBy({ left: dir * step(), behavior });
    };

    document.querySelectorAll('[data-vig]').forEach((btn) => {
      btn.addEventListener('click', () => go(Number(btn.dataset.vig)));
    });

    /* A focused scroll container already takes arrow keys, but it scrolls by a
       few pixels. Stepping by a card is what makes the row usable without a
       pointer. */
    track.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      go(e.key === 'ArrowRight' ? 1 : -1);
    });

    let timer = null;
    let dir = 1;
    const tick = () => {
      if (dir > 0 && track.scrollLeft >= maxLeft() - 2) dir = -1;
      else if (dir < 0 && track.scrollLeft <= 2) dir = 1;
      track.scrollBy({ left: dir * step(), behavior: 'smooth' });
    };
    const stop = () => {
      clearInterval(timer);
      timer = null;
    };
    const start = () => {
      if (timer || reduce.matches || document.hidden || !onScreen) return;
      timer = setInterval(tick, 6000);
    };

    let onScreen = false;
    ['pointerenter', 'focusin'].forEach((ev) => track.addEventListener(ev, stop));
    ['pointerleave', 'focusout'].forEach((ev) => track.addEventListener(ev, start));
    document.querySelectorAll('[data-vig]').forEach((btn) => {
      btn.addEventListener('pointerenter', stop);
      btn.addEventListener('pointerleave', start);
      btn.addEventListener('focus', stop);
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduce.addEventListener('change', () => (reduce.matches ? stop() : start()));

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          onScreen = entries[0].isIntersecting;
          onScreen ? start() : stop();
        },
        { threshold: 0.25 },
      ).observe(track);
    } else {
      onScreen = true;
      start();
    }
  })();
</script>

<style>
  /* --- Section rhythm, shared with the homepage --------------------------- */
  .sect {
    padding-top: var(--spacing-section-lg);
  }
  .sect__h {
    margin: 1.25rem 0 0;
  }
  .sect__lead {
    margin: 1.5rem 0 0;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-cream-dim);
    max-width: 52ch;
  }

  /* --- Section 1 — hero -------------------------------------------------- */
  /* A page hero, not the homepage's full-screen brand moment, so it needs the
     clearance stated rather than inherited from main's padding. main--contained
     now derives its own from --nav-space; this is the extra air a hero wants on
     top of it. Measured nav-bottom to headline: 105 / 119 / 183 against the
     homepage's 314 / 376 / 233.

     Not matched exactly, and deliberately: the homepage's figure is slack from
     a 100svh hero anchored to its bottom, and 314px on a 844px phone would put
     the headline 40% down an inner page before a word was read. */
  .whero {
    padding-top: clamp(2rem, 6vw, 6rem);
  }
  .whero__h {
    margin: 1.25rem 0 0;
    /* Was --text-display: 104px at 1440, which is the size the homepage would
       set a wordmark at, not a sentence. The scale has --text-h2 at 60 and
       nothing between, so this is a local step — 72px, a fifth above the
       section headings it has to lead. */
    font-size: clamp(2.5rem, 1.4rem + 3.9vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    color: var(--color-cream);
    /* The headline is five words; balanced it never leaves one of them alone
       on the last line. */
    text-wrap: balance;
    max-width: 16ch;
  }
  .whero__body {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-cream-dim);
    /* 52ch measures about 69 characters, the target the design sets. */
    max-width: 52ch;
  }
  /* --- Section 2 — the vignettes ----------------------------------------- */
  .vwrap {
    margin-top: clamp(2rem, 3vw, 3rem);
  }

  /* The controls. Above the track and right-aligned, so they sit where the row
     ends rather than on top of the quotes. Glass, like everything else that is
     a surface on this site. */
  .vnav {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .vbtn {
    display: grid;
    place-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    cursor: pointer;
    color: var(--color-cream-dim);
    background-color: var(--color-glass-soft);
    border: 1px solid var(--color-glass-soft-edge);
    box-shadow: inset 0 1px 0 var(--color-glass-soft-spec);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .vbtn svg {
    width: 1rem;
    height: 1rem;
  }
  .vbtn:hover,
  .vbtn:focus-visible {
    color: var(--color-cream);
    border-color: var(--color-glass-edge);
  }

  /* One row. The gap is a grid cell, so the first card's edge still starts on a
     line even though a scrolling track cannot hold alignment once it moves. */
  .vtrack {
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem;
    display: flex;
    gap: var(--grid-cell);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .vtrack::-webkit-scrollbar {
    display: none;
  }
  .vtrack:focus-visible {
    outline: 2px solid var(--color-ember);
    outline-offset: 6px;
    border-radius: var(--radius-lg);
  }
  .vcard {
    flex: 0 0 auto;
    /* Under one full card, so part of the next is always showing — that peek is
       the only thing telling a reader the row continues. */
    width: 82%;
    scroll-snap-align: start;
  }
  @media (min-width: 48rem) {
    .vcard {
      width: 46%;
    }
  }
  @media (min-width: 64rem) {
    .vcard {
      width: 31%;
    }
  }

  /* The page's pane, identical to the homepage's: low-alpha fill, hairline
     edge, specular top line, blur, and no drop shadow — a shadow is what makes
     the nav read as floating, and these sit IN the page. */
  .vcard,
  .apane {
    position: relative;
    padding: clamp(1.25rem, 2vw, 1.5rem);
    border-radius: var(--radius-lg);
    background-color: var(--color-glass-soft);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--color-glass-soft-edge);
    box-shadow: inset 0 1px 0 var(--color-glass-soft-spec);
  }

  .vcard__q {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.4;
    letter-spacing: var(--tracking-display);
    color: var(--color-cream);
    text-wrap: balance;
  }
  /* The card's one rule, as an element so it catches the cursor light. */
  .vcard__rule,
  .apane__rule,
  .impl__rule {
    display: block;
    height: 1px;
    background-color: var(--color-line);
  }
  .vcard__rule {
    margin: 1.1rem 0;
  }
  .vcard__who {
    margin: 0;
    /* Italic: it is a note about the speaker, not more of the quote. */
    font-style: italic;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-cream-dim);
    text-wrap: balance;
  }

  /* --- Section 3 — the Assessment ---------------------------------------- */
  .apanes {
    list-style: none;
    margin: clamp(2rem, 3vw, 3rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 48rem) {
    .apanes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--grid-cell);
    }
  }

  .apane__h {
    margin: 0 0 1.1rem;
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    color: var(--color-cream);
  }
  .alist {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
  }
  .aitem,
  .impl__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0 0.75rem;
    padding: 0.5rem 0;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-cream-dim);
    /* balance, not pretty: these are two- and three-line items, and pretty only
       rebalances the tail of a longer paragraph. */
    text-wrap: balance;
  }

  /* The marker: the pane's own material at the smallest weight it has, a bead
     rather than a glyph. */
  .adot {
    margin-top: calc((1.55em - 0.5rem) / 2 - 0.04em);
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-glass-soft);
    border: 1px solid var(--color-glass-soft-edge);
    box-shadow: inset 0 1px 0 var(--color-glass-soft-spec);
    backdrop-filter: blur(6px) saturate(140%);
    -webkit-backdrop-filter: blur(6px) saturate(140%);
  }

  /* --- Section 4 — implementation ---------------------------------------- */
  .impl {
    margin-top: clamp(2rem, 3vw, 3rem);
  }
  .impl__list {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
  }
  /* Two columns that read DOWN, not across. Plain row flow put items 1 and 2
     side by side, so the eye going down the left column read 1, 3, 5, 7 — a
     list whose order is nonsense. Four explicit rows with column flow fills the
     left column first: 1-4, then 5-7. */
  @media (min-width: 64rem) {
    .impl__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(4, auto);
      grid-auto-flow: column;
      column-gap: var(--grid-cell);
    }
  }

  /* --- Section 5 — the close --------------------------------------------- */
  .wclose {
    background-color: var(--color-invert-bg);
    color: var(--color-invert-fg);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 5vw, 6rem);
    position: relative;
  }
  .wclose__inner {
    position: relative;
  }
  /* Ink on paper, keeping .rule-thread's tick pattern so it takes the shared
     line variant and catches the light like every other rule. */
  .wclose__rule {
    color: var(--color-invert-line);
  }
  .wclose__h {
    margin: 1.25rem 0 0;
    color: var(--color-invert-fg);
  }
  .wclose__body {
    margin: 1.5rem 0 0;
    font-size: var(--text-lead);
    line-height: 1.5;
    letter-spacing: var(--tracking-tight);
    color: var(--color-invert-fg-dim);
    max-width: 52ch;
  }
  .wclose__cta {
    margin-top: clamp(2.5rem, 4vw, 3.25rem);
  }
</style>
