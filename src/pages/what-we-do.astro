---
/**
 * /what-we-do
 *
 * Rebuilt on the homepage's system rather than the utility-class layout it had:
 * the measured thread opening every section, glass panes on the page's own
 * column grid, the cursor-light variants (ring / line / dot), the shared type
 * ladder, and the reversed panel to close.
 *
 * The old page's machinery is gone with it — a snap-scrolling carousel with
 * autoplay, a roving-tabindex tab rail, and disclosure accordions. Three
 * interaction models on one page, none of them used anywhere else on the site.
 * The content underneath was six quotes, two lists and seven commitments, and
 * that is what it is set as now.
 *
 * Copy lives in src/data/whatWeDo.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButton from '../components/CtaButton.astro';
import { graph, webPage, service } from '../lib/schema';
import {
  WWD_HERO,
  WWD_META,
  WWD_QUESTIONS,
  WWD_ASSESSMENT,
  WWD_IMPLEMENTATION,
  WWD_CLOSE,
} from '../data/whatWeDo';

const origin = Astro.site!.origin;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = graph([
  webPage(origin, { url: pageUrl, name: 'What We Do', description: WWD_META.description }),
  service(origin, {
    url: pageUrl,
    name: 'AI Assessment and Implementation',
    serviceType: 'Artificial intelligence consulting',
    description: WWD_META.description,
  }),
]);
---

<BaseLayout title="What We Do" description={WWD_META.description} schema={schema}>
  {/* --- Section 1 — hero ------------------------------------------------ */}
  <section class="whero" data-reveal>
    <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
    <h1 class="whero__h r" style="--i: 1">{WWD_HERO.heading}</h1>
    <p class="whero__body r" style="--i: 2">{WWD_HERO.body}</p>
    <div class="whero__cta r" style="--i: 3">
      <CtaButton href={WWD_HERO.cta.href}>{WWD_HERO.cta.label}</CtaButton>
    </div>
  </section>

  {/* --- Section 2 — sound familiar? ------------------------------------- */}
  <section class="sect">
    <div data-reveal>
      <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <h2 class="h-section sect__h r" style="--i: 1">{WWD_QUESTIONS.heading}</h2>
      <p class="sect__lead r" style="--i: 2">{WWD_QUESTIONS.lead}</p>
    </div>

    {/* Six panes, two up. They were a snap-scrolling carousel with autoplay,
        which hid four of the six behind a gesture — and the whole point of the
        section is the RANGE, so the one thing it could not afford was showing
        one at a time. */}
    <ul class="vgrid" data-reveal>
      {
        WWD_QUESTIONS.vignettes.map((v, i) => (
          <li class="vcard r" data-catch="ring" style={`--i: ${i}`}>
            <p class="vcard__q">“{v.quote}”</p>
            <span class="vcard__rule" data-catch="line" aria-hidden="true" />
            <p class="vcard__who">{v.who}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* --- Section 3 — the Assessment -------------------------------------- */}
  <section class="sect">
    <div data-reveal>
      <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <h2 class="h-section sect__h r" style="--i: 1">{WWD_ASSESSMENT.heading}</h2>
    </div>

    {/* Two panes, no ordinals and no connector: the homepage's stages carry
        both because they are a sequence, and these two are facets of one
        thing. */}
    <ul class="apanes" data-reveal>
      {
        WWD_ASSESSMENT.blocks.map((block, i) => (
          <li class="apane r" data-catch="ring" style={`--i: ${i}`}>
            <h3 class="apane__h">{block.title}</h3>
            <span class="apane__rule" data-catch="line" aria-hidden="true" />
            <ul class="alist">
              {block.points.map((point) => (
                <li class="aitem">
                  <span class="adot" data-catch="dot" aria-hidden="true" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  {/* --- Section 4 — implementation --------------------------------------- */}
  <section class="sect">
    <div data-reveal>
      <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <h2 class="h-section sect__h r" style="--i: 1">{WWD_IMPLEMENTATION.heading}</h2>
    </div>

    {/* No pane here, on purpose. Two pane-heavy sections and the cream slab sit
        either side of this one; set plainly on the page it gives the eye a rest
        and stops the page reading as a stack of boxes. */}
    <div class="impl" data-reveal>
      <span class="impl__rule r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <ul class="impl__list">
        {
          WWD_IMPLEMENTATION.points.map((point, i) => (
            <li class="impl__item r" style={`--i: ${i + 1}`}>
              <span class="adot" data-catch="dot" aria-hidden="true" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* --- Section 5 — the close -------------------------------------------- */}
  <section class="sect">
    <div class="wclose" data-reveal>
      <div class="wclose__inner">
        <span class="rule-thread wclose__rule r" data-catch="line" aria-hidden="true" style="--i: 0"
        ></span>
        <h2 class="h-section wclose__h r" style="--i: 1">{WWD_CLOSE.heading}</h2>
        <p class="wclose__body r" style="--i: 2">{WWD_CLOSE.body}</p>
        <div class="wclose__cta r" style="--i: 3">
          <CtaButton href={WWD_CLOSE.cta.href} variant="inverse">{WWD_CLOSE.cta.label}</CtaButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Section rhythm, shared with the homepage --------------------------- */
  .sect {
    padding-top: var(--spacing-section-lg);
  }
  .sect__h {
    margin: 1.25rem 0 0;
  }
  .sect__lead {
    margin: 1.5rem 0 0;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-cream-dim);
    max-width: 52ch;
  }

  /* --- Section 1 — hero -------------------------------------------------- */
  .whero__h {
    margin: 1.25rem 0 0;
    font-size: var(--text-display);
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    color: var(--color-cream);
    /* The headline is five words; balanced it never leaves one of them alone
       on the last line. */
    text-wrap: balance;
    max-width: 16ch;
  }
  .whero__body {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-cream-dim);
    /* 52ch measures about 69 characters, the target the design sets. */
    max-width: 52ch;
  }
  .whero__cta {
    margin-top: clamp(2rem, 3vw, 2.75rem);
  }

  /* --- Section 2 — the vignettes ----------------------------------------- */
  .vgrid {
    list-style: none;
    margin: clamp(2rem, 3vw, 3rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  /* Two up from 64rem, not 48rem. At 768 two columns are 306px wide and these
     panes carry a 21px quote — the same reasoning that moved the founder cards
     up a breakpoint. */
  @media (min-width: 64rem) {
    .vgrid {
      /* One grid cell, so the panes are seven whole cells each and all four
         edges land on lines. */
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--grid-cell);
    }
  }

  /* The page's pane, identical to the homepage's: low-alpha fill, hairline
     edge, specular top line, blur, and no drop shadow — a shadow is what makes
     the nav read as floating, and these sit IN the page. */
  .vcard,
  .apane {
    position: relative;
    padding: clamp(1.25rem, 2vw, 1.5rem);
    border-radius: var(--radius-lg);
    background-color: var(--color-glass-soft);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--color-glass-soft-edge);
    box-shadow: inset 0 1px 0 var(--color-glass-soft-spec);
  }

  .vcard__q {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.4;
    letter-spacing: var(--tracking-display);
    color: var(--color-cream);
    text-wrap: balance;
  }
  /* The card's one rule, as an element so it catches the cursor light. */
  .vcard__rule,
  .apane__rule,
  .impl__rule {
    display: block;
    height: 1px;
    background-color: var(--color-line);
  }
  .vcard__rule {
    margin: 1.1rem 0;
  }
  .vcard__who {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-cream-dim);
    text-wrap: balance;
  }

  /* --- Section 3 — the Assessment ---------------------------------------- */
  .apanes {
    list-style: none;
    margin: clamp(2rem, 3vw, 3rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 48rem) {
    .apanes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--grid-cell);
    }
  }

  .apane__h {
    margin: 0 0 1.1rem;
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    color: var(--color-cream);
  }
  .alist {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
  }
  .aitem,
  .impl__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0 0.75rem;
    padding: 0.5rem 0;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-cream-dim);
    /* balance, not pretty: these are two- and three-line items, and pretty only
       rebalances the tail of a longer paragraph. */
    text-wrap: balance;
  }

  /* The marker: the pane's own material at the smallest weight it has, a bead
     rather than a glyph. */
  .adot {
    margin-top: calc((1.55em - 0.5rem) / 2 - 0.04em);
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-glass-soft);
    border: 1px solid var(--color-glass-soft-edge);
    box-shadow: inset 0 1px 0 var(--color-glass-soft-spec);
    backdrop-filter: blur(6px) saturate(140%);
    -webkit-backdrop-filter: blur(6px) saturate(140%);
  }

  /* --- Section 4 — implementation ---------------------------------------- */
  .impl {
    margin-top: clamp(2rem, 3vw, 3rem);
  }
  .impl__list {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
  }
  /* Two columns that read DOWN, not across. Plain row flow put items 1 and 2
     side by side, so the eye going down the left column read 1, 3, 5, 7 — a
     list whose order is nonsense. Four explicit rows with column flow fills the
     left column first: 1-4, then 5-7. */
  @media (min-width: 64rem) {
    .impl__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(4, auto);
      grid-auto-flow: column;
      column-gap: var(--grid-cell);
    }
  }

  /* --- Section 5 — the close --------------------------------------------- */
  .wclose {
    background-color: var(--color-invert-bg);
    color: var(--color-invert-fg);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 5vw, 6rem);
    position: relative;
  }
  .wclose__inner {
    position: relative;
  }
  /* Ink on paper, keeping .rule-thread's tick pattern so it takes the shared
     line variant and catches the light like every other rule. */
  .wclose__rule {
    color: var(--color-invert-line);
  }
  .wclose__h {
    margin: 1.25rem 0 0;
    color: var(--color-invert-fg);
  }
  .wclose__body {
    margin: 1.5rem 0 0;
    font-size: var(--text-lead);
    line-height: 1.5;
    letter-spacing: var(--tracking-tight);
    color: var(--color-invert-fg-dim);
    max-width: 52ch;
  }
  .wclose__cta {
    margin-top: clamp(2.5rem, 4vw, 3.25rem);
  }
</style>
