---
/**
 * /lab/ — motion harness. NOT a site page.
 *
 * Never linked, noindex + robots-disallowed + sitemap-excluded, and explicitly
 * outside DESIGN.md. It exists so a motion piece can be built and judged on its
 * own before anything is wired into the hero.
 *
 * Two pieces live here, each with one question.
 *
 * `field` — phase 1, the ribbon field, full viewport. The question is whether
 * the coverage holds edge to edge at every frame and every width. It cannot be
 * judged in a box the way the knot can, because covering the screen is the
 * whole requirement.
 *
 * `knot` / `seq` — phase 3 and the earlier converge, at three fixed widths. The
 * question is whether the shape reads as a KNOT rather than a squiggle, at
 * every knottedness value and at phone size.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lab" bare noindex>
  <div class="lab">
    <header class="lab__head">
      <h1>Hero intro — pieces in isolation</h1>
      <p>
        Not a site page. Pick the field mode for phases 1-2 full-viewport, or the knot modes to
        judge whether the shape reads as tied at every <code>k</code> and every width.
      </p>
    </header>

    {/* Phase 1 in isolation, full viewport. It covers the screen from the first
        frame, so it cannot be judged in a 1440x620 box the way the knot could —
        the whole question is whether the coverage holds edge to edge. */}
    <div class="field" data-field-stage hidden>
      <canvas data-field-canvas></canvas>
      <div class="field__hud">
        <button type="button" data-field-play>play</button>
        <label>
          t <output data-out="ft">0ms</output>
          <input type="range" data-ft min="0" max="1400" step="5" value="0" />
        </label>
        <label>
          rows <output data-out="rows">13</output>
          <input type="range" data-rows min="6" max="24" step="1" value="13" />
        </label>
        <label>
          wave <output data-out="amp">0.038</output>
          <input type="range" data-amp min="0" max="0.09" step="0.002" value="0.038" />
        </label>
        <button type="button" data-field-exit>close</button>
      </div>
    </div>

    <div class="lab__controls">
      <label>
        mode
        <select data-mode>
          <option value="knot" selected>knot only</option>
          <option value="seq">phases 1-3</option>
          <option value="field">phases 1-2 — field + collapse (full viewport)</option>
        </select>
      </label>
      <label>
        backdrop
        <select data-bd>
          <option value="ink" selected>ink (matches current site)</option>
          <option value="cream">cream</option>
        </select>
      </label>
      <label>
        t <output data-out="t">0.00</output>
        <input type="range" data-t min="0" max="1" step="0.005" value="1" />
      </label>
      <label>
        shape
        <select data-shape>
          <option value="trefoil" selected>D trefoil</option>
          <option value="overhand">B overhand</option>
          <option value="cinched">C cinched</option>
          <option value="pretzel">A pretzel (current)</option>
        </select>
      </label>
      <label>
        k <output data-out="k">1.00</output>
        <input type="range" data-k min="0" max="1" step="0.01" value="1" />
      </label>
      <label>
        width <output data-out="w">0.085</output>
        <input type="range" data-w min="0.03" max="0.14" step="0.005" value="0.085" />
      </label>
      <label>
        cut D <output data-out="d">0.95</output>
        <input type="range" data-d min="0.2" max="1.3" step="0.02" value="0.95" />
      </label>
      <label class="lab__check">
        <input type="checkbox" data-gaps checked /> over/under gaps
      </label>
      <label class="lab__check">
        <input type="checkbox" data-marks /> mark crossings
      </label>
    </div>

    <!-- Three real widths, not one canvas scaled. A knot that reads at 1440 can
         collapse into a blob at 390, and 390 is where most readers meet it. -->
    <div class="lab__stage">
      <figure><figcaption>1440 × 620</figcaption><canvas data-canvas width="1440" height="620"></canvas></figure>
      <figure><figcaption>768 × 500</figcaption><canvas data-canvas width="768" height="500"></canvas></figure>
      <figure><figcaption>390 × 420</figcaption><canvas data-canvas width="390" height="420"></canvas></figure>
    </div>
  </div>
</BaseLayout>

<style>
  .lab {
    min-height: 100vh;
    padding: 2rem clamp(1rem, 3vw, 2.5rem) 5rem;
    background: var(--color-ink);
    color: var(--color-cream);
  }
  .lab__head h1 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .lab__head p {
    margin: 0.35rem 0 0;
    font-size: 0.875rem;
    color: var(--color-cream-dim);
  }
  .lab__head code {
    font-family: var(--font-mono);
  }
  .lab__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    align-items: center;
    margin: 1.5rem 0 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .lab__controls label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-cream-dim);
  }
  .lab__controls input[type='range'] {
    width: 12rem;
    accent-color: var(--color-ember);
  }
  .lab__controls select {
    background: var(--color-ink-panel);
    color: var(--color-cream);
    border: 1px solid var(--color-line);
    padding: 0.3rem 0.5rem;
    font: inherit;
  }
  .lab__controls output {
    color: var(--color-ember);
    min-width: 3.2em;
  }
  .lab__check {
    text-transform: none;
    letter-spacing: 0;
  }

  .lab__stage {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }
  .lab__stage figure {
    margin: 0;
    max-width: 100%;
  }
  .lab__stage figcaption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cream-dim);
    margin-bottom: 0.5rem;
  }
  .lab__stage canvas {
    display: block;
    max-width: 100%;
    height: auto;
    background: var(--color-figure);
    border: 1px solid var(--color-line);
  }

  /* --- phase 1, full viewport ------------------------------------------- */
  .field {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--color-ink);
  }
  .field[hidden] {
    display: none;
  }
  .field canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .field__hud {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    display: flex;
    gap: 1.25rem;
    align-items: center;
    padding: 0.7rem 1rem;
    background: color-mix(in srgb, var(--color-ink) 86%, transparent);
    border: 1px solid var(--color-line);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-cream-dim);
    white-space: nowrap;
  }
  .field__hud label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .field__hud input[type='range'] {
    width: 8rem;
    accent-color: var(--color-ember);
  }
  .field__hud output {
    color: var(--color-ember);
    min-width: 3.2em;
  }
  .field__hud button {
    font: inherit;
    text-transform: inherit;
    letter-spacing: inherit;
    color: var(--color-cream);
    background: var(--color-ink-panel);
    border: 1px solid var(--color-line);
    padding: 0.35rem 0.8rem;
    cursor: pointer;
  }
</style>

<script>
  import {
    SHAPES, selfCrossings, strand, ribbonOutline, clamp01, lerp, trefoilWithTails,
    BANDS, bandPoint,
  } from '../lib/knot';
  import type { Pt, ShapeName } from '../lib/knot';
  import {
    buildField, edgeY, rowSpans, frontAt, collapseX, collapseY,
    FIELD, FIELD_PALETTE, FIELD_GROUND,
  } from '../lib/ribbons';

  const $ = <T extends Element>(s: string) => document.querySelector(s) as T;
  const canvases = [...document.querySelectorAll<HTMLCanvasElement>('[data-canvas]')];
  const shapeSel = $<HTMLSelectElement>('[data-shape]');
  const kIn = $<HTMLInputElement>('[data-k]');
  const wIn = $<HTMLInputElement>('[data-w]');
  const dIn = $<HTMLInputElement>('[data-d]');
  const gapsIn = $<HTMLInputElement>('[data-gaps]');
  const marksIn = $<HTMLInputElement>('[data-marks]');
  const kOut = $<HTMLOutputElement>('[data-out="k"]');
  const wOut = $<HTMLOutputElement>('[data-out="w"]');
  const dOut = $<HTMLOutputElement>('[data-out="d"]');

  const modeSel = $<HTMLSelectElement>('[data-mode]');
  const bdSel = $<HTMLSelectElement>('[data-bd]');
  const tIn = $<HTMLInputElement>('[data-t]');
  const tOut = $<HTMLOutputElement>('[data-out="t"]');

  /**
   * Two grounds, because which one the intro should use is a brand decision,
   * not a technical one — and the occlusion gaps are punched in the BACKDROP
   * colour, so whether they still read on cream is the thing to look at.
   *
   * Note the ink ground matches the site as it currently ships, so an ink
   * overlay reveals nothing; a cream overlay would flash bright and then hand
   * off to a dark page. On a light site that inverts.
   */
  const GROUNDS = {
    ink: {
      bg: '#0d0c0a',
      resolve: '#cf5b30',
      palette: ['#cf5b30', '#efe9dd', '#8b7f72', '#cf5b30', '#a29b91', '#4c4640'],
    },
    cream: {
      bg: '#efe9dd',
      resolve: '#a04a2c',
      // No near-cream values: #c4bba7 all but vanished against the #efe9dd
      // ground. Every band has to read against its own backdrop.
      palette: ['#a04a2c', '#1f1f1d', '#8a8580', '#a04a2c', '#55504a', '#b5411f'],
    },
  } as const;

  const clampT = (t: number, a: number, b: number) => clamp01((t - a) / (b - a));
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

  const mixHex = (a: string, b: string, t: number) => {
    const h = (c: string) => [1, 3, 5].map((i) => parseInt(c.slice(i, i + 2), 16));
    const [r1, g1, b1] = h(a);
    const [r2, g2, b2] = h(b);
    const m = (x: number, y: number) => Math.round(x + (y - x) * t);
    return `rgb(${m(r1, r2)},${m(g1, g2)},${m(b1, b2)})`;
  };

  const SAMPLES = 300;

  function render(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const W = canvas.width;
    const H = canvas.height;
    // The trefoil is rebuilt live so the cut depth can be swept; the hand-authored
    // candidates ignore D.
    const ctrl =
      shapeSel.value === 'trefoil' ? trefoilWithTails(Number(dIn.value)) : SHAPES[shapeSel.value as ShapeName];
    const k = Number(kIn.value);
    const widthRatio = Number(wIn.value);

    // UNIFORM scale, fitted to the box. Scaling x and y independently squashes
    // the shape until its strands stop actually intersecting — the pretzel
    // reported 0 crossings under a non-uniform fit while looking superficially
    // similar. The topology is the whole point, so it must not depend on the
    // aspect of whatever box the knot is handed.
    const bounds = ctrl.reduce(
      (b, p) => [Math.min(b[0], p[0]), Math.max(b[1], p[0]), Math.min(b[2], p[1]), Math.max(b[3], p[1])],
      [Infinity, -Infinity, Infinity, -Infinity],
    );
    const spanX = bounds[1] - bounds[0];
    const spanY = Math.max(bounds[3] - bounds[2], 0.001);
    const pad = 1.18; // room for the ribbon's own width
    const scale = Math.min(W / (spanX * pad), H / (spanY * pad));
    const midX = (bounds[0] + bounds[1]) / 2;
    const midY = (bounds[2] + bounds[3]) / 2;
    const project = (p: Pt): Pt => [W / 2 + (p[0] - midX) * scale, H / 2 + (p[1] - midY) * scale];
    const halfW = scale * widthRatio;

    const G = GROUNDS[bdSel.value as keyof typeof GROUNDS];
    const GROUND = G.bg;

    const fillPoly = (poly: Pt[], fill: string) => {
      ctx.beginPath();
      poly.forEach((p, i) => (i ? ctx.lineTo(p[0], p[1]) : ctx.moveTo(p[0], p[1])));
      ctx.closePath();
      ctx.fillStyle = fill;
      ctx.fill();
    };

    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = GROUND;
    ctx.fillRect(0, 0, W, H);

    // --- phases 1-2: bands sweeping in and converging -----------------------
    if (modeSel.value === 'seq') {
      const t = Number(tIn.value);
      // The windows overlap deliberately: a band that finishes arriving before
      // it starts converging leaves a tidy staircase, which is the ugliest
      // frame of the whole sequence.
      const sweep = easeOut(clampT(t, 0, 0.34));
      const converge = easeInOut(clampT(t, 0.2, 0.62));
      const tie = easeInOut(clampT(t, 0.55, 1));
      const resolve = easeInOut(clampT(t, 0.34, 0.72));

      for (const band of BANDS) {
        const enter = clamp01((sweep - band.delay) / Math.max(0.001, 1 - band.delay));
        if (enter <= 0) continue;
        // Each band converges on its own clock, and its THICKNESS trails its
        // position — so bands stay full-height while they gather and only thin
        // down once they are nearly in place. Shrinking in lockstep is what
        // produced the row of tiles.
        const cv = clamp01((converge - band.cDelay * 0.45) / Math.max(0.001, 1 - band.cDelay * 0.45));
        const cvThick = clamp01((cv - 0.35) / 0.65);
        const n = 64;
        const line: Pt[] = [];
        const hw: number[] = [];
        for (let i = 0; i < n; i++) {
          const u = i / (n - 1);
          line.push(bandPoint(band, ctrl, u, enter, cv, tie, W, H, project));
          hw.push(lerp(band.thickness * H, halfW, cvThick));
        }
        fillPoly(ribbonOutline(line, hw), mixHex(G.palette[band.colour], G.resolve, resolve));
      }

      // Over/under only matters once it is one strand and actually knotted.
      if (converge > 0.985 && tie > 0.04 && gapsIn.checked) {
        const probe: Pt[] = [];
        for (let i = 0; i < 120; i++) probe.push(project(strand(ctrl, i / 119, tie)));
        for (const c of selfCrossings(probe)) {
          const half = 0.028;
          const n = 30;
          const win: Pt[] = [];
          const gap: number[] = [];
          const core: number[] = [];
          for (let i = 0; i < n; i++) {
            const u = clamp01(c.over - half + (2 * half * i) / (n - 1));
            win.push(project(strand(ctrl, u, tie)));
            const edge = Math.sin((i / (n - 1)) * Math.PI);
            gap.push(halfW + halfW * 0.55 * edge);
            core.push(halfW);
          }
          fillPoly(ribbonOutline(win, gap), GROUND);
          const seg = Math.min(BANDS.length - 1, Math.floor(c.over * BANDS.length));
          fillPoly(ribbonOutline(win, core), mixHex(G.palette[BANDS[seg].colour], G.resolve, resolve));
        }
      }
      return;
    }

    // Centre line, sampled once and reused for the ribbon and the crossings.
    const pts: Pt[] = [];
    for (let i = 0; i < SAMPLES; i++) pts.push(project(strand(ctrl, i / (SAMPLES - 1), k)));

    // The whole strand, in curve order.
    fillPoly(ribbonOutline(pts, pts.map(() => halfW)), G.resolve);

    // Over/under. For each crossing, redraw a short window around the LATER
    // parameter — the strand drawn second, therefore the one in front — as a
    // wider gap in the ground colour, then the strand colour back over it.
    // Without this the crossings merge and the knot reads as a flat squiggle.
    const crossings = selfCrossings(pts);
    if (gapsIn.checked) {
      for (const c of crossings) {
        const half = 0.028;
        const n = 30;
        const win: Pt[] = [];
        const gap: number[] = [];
        const core: number[] = [];
        for (let i = 0; i < n; i++) {
          const u = clamp01(c.over - half + (2 * half * i) / (n - 1));
          win.push(project(strand(ctrl, u, k)));
          // Taper the gap at both ends so it blends back into the strand
          // instead of leaving a notch.
          const edge = Math.sin((i / (n - 1)) * Math.PI);
          gap.push(halfW + halfW * 0.55 * edge);
          core.push(halfW);
        }
        fillPoly(ribbonOutline(win, gap), GROUND);
        fillPoly(ribbonOutline(win, core), G.resolve);
      }
    }

    if (marksIn.checked) {
      ctx.fillStyle = '#5ad1a0';
      for (const c of crossings) {
        ctx.beginPath();
        ctx.arc(c.at[0], c.at[1], 5, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.fillStyle = '#5ad1a0';
      ctx.font = '12px monospace';
      ctx.fillText(`${crossings.length} crossings`, 12, 20);
    }
  }

  function renderAll() {
    kOut.value = Number(kIn.value).toFixed(2);
    wOut.value = Number(wIn.value).toFixed(3);
    dOut.value = Number(dIn.value).toFixed(2);
    tOut.value = Number(tIn.value).toFixed(2);
    document.body.style.background = GROUNDS[bdSel.value as keyof typeof GROUNDS].bg;
    canvases.forEach(render);
  }

  [shapeSel, kIn, wIn, dIn, gapsIn, marksIn, modeSel, bdSel, tIn].forEach((el) =>
    el.addEventListener('input', renderAll),
  );

  /* ---------------------------------------------------------------------
   * Phase 1 — the ribbon field, full viewport.
   * ------------------------------------------------------------------- */
  const stage = $<HTMLElement>('[data-field-stage]');
  const fcv = $<HTMLCanvasElement>('[data-field-canvas]');
  const playBtn = $<HTMLButtonElement>('[data-field-play]');
  const exitBtn = $<HTMLButtonElement>('[data-field-exit]');
  const ftIn = $<HTMLInputElement>('[data-ft]');
  const ftOut = $<HTMLOutputElement>('[data-out="ft"]');
  const rowsIn = $<HTMLInputElement>('[data-rows]');
  const rowsOut = $<HTMLOutputElement>('[data-out="rows"]');
  const ampIn = $<HTMLInputElement>('[data-amp]');
  const ampOut = $<HTMLOutputElement>('[data-out="amp"]');

  /** Phase 1 runs for one second. Slower than anything that follows, on
   *  purpose: it is the only part the reader is meant to simply watch. */
  const FIELD_MS = 1000;
  /** Phase 2, the collapse. Fast — it is a transition, not a thing to look at,
   *  and at much over this it stops reading as being pulled in. */
  const COLLAPSE_MS = 400;
  const TOTAL_MS = FIELD_MS + COLLAPSE_MS;
  let field = buildField(Number(rowsIn.value));
  let fraf = 0;
  let fstart = -1;

  // Horizontal samples per boundary curve. 56 is past the point where more
  // stops being visible on a 1440 swell under one cycle wide.
  const FS = 56;

  /**
   * `ms` is absolute time through the whole sequence.
   *
   * The field's own clock keeps running past phase 1 and through the collapse —
   * the ribbons are still scrolling and the wave is still travelling while they
   * are being drawn in, which is what stops phase 2 reading as a still image
   * being transformed.
   */
  function drawField(ms: number) {
    const t = ms / FIELD_MS;
    // Linear: the acceleration lives in frontAt, per column, so every column
    // gets the same motion instead of the left half being crushed into the end.
    const p = clamp01((ms - FIELD_MS) / COLLAPSE_MS);
    const ctx = fcv.getContext('2d');
    if (!ctx) return;
    const W = stage.clientWidth;
    const H = stage.clientHeight;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    if (fcv.width !== Math.round(W * dpr) || fcv.height !== Math.round(H * dpr)) {
      fcv.width = Math.round(W * dpr);
      fcv.height = Math.round(H * dpr);
    }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    /* Ground the field in its own darkest ribbon colour, not the page's ink.
       Adjacent fills share exact edges, but canvas antialiases both sides and
       can leave a sub-pixel hairline of whatever is underneath; grounding in
       #0d0c0a made those hairlines the page showing through, which is the one
       thing this phase must never do. Against a ribbon colour the same hairline
       is invisible. Cheaper and more robust than tuning overlaps until the
       artefact happens to vanish — it was down to one pixel per frame, which is
       exactly the kind of number that comes back on a different DPR. */
    /* The ground has to retreat with the front, or phase 2 ends on a brown
       screen instead of an empty one. Filled in columns whose alpha tracks
       `frontAt` exactly, rather than as one rect clipped at the front: a rect
       leaves a hard vertical edge sweeping across the screen, which was clearly
       visible mid-collapse and read as a wipe rather than as a collapse. */
    if (p <= 0) {
      ctx.fillStyle = FIELD_GROUND;
      ctx.fillRect(0, 0, W, H);
    } else {
      const cols = 72;
      ctx.fillStyle = FIELD_GROUND;
      for (let s = 0; s < cols; s++) {
        const a = 1 - frontAt((s + 0.5) / cols, p);
        if (a <= 0.002) continue;
        ctx.globalAlpha = a;
        ctx.fillRect((s * W) / cols, 0, W / cols + 1, H);
      }
      ctx.globalAlpha = 1;
    }

    const amp = Number(ampIn.value);
    // Every boundary sampled ONCE, then shared by the row above and the row
    // below it. This is what makes the coverage exact rather than lucky.
    const curves: number[][] = [];
    for (let i = 0; i < field.edges.length; i++) {
      const row: number[] = [];
      for (let s = 0; s < FS; s++) row.push(edgeY(field, i, s / (FS - 1), t, amp) * H);
      curves.push(row);
    }

    const yAt = (i: number, u: number) => {
      const f = clamp01(u) * (FS - 1);
      const a = Math.floor(f);
      const b = Math.min(FS - 1, a + 1);
      return lerp(curves[i][a], curves[i][b], f - a);
    };

    const rowCount = field.rows.length;
    const [lineTop, lineBottom] = collapseY(H);

    for (let i = 0; i < rowCount; i++) {
      /* The joint leans by a fraction of THIS row's thickness, so thick and
         thin rows are cut at the same angle rather than the same distance. */
      const skew = ((field.edges[i + 1] - field.edges[i]) * H * FIELD.SKEW) / W;

      /**
       * One vertex, from field position to collapsed position.
       *
       * `uRef` is the TOP edge's column for both edges of a quad, so the two
       * sides of a segment are drawn into the same place and the segment stays
       * coherent as it goes. Using each vertex's own column would shear the
       * quad apart on the way in — and it also means the skew collapses with
       * everything else, which is why the finished line has square joints
       * rather than the leaning ones phase 1 uses.
       */
      const warp = (u: number, uRef: number, y: number, top: boolean): [number, number] => {
        if (p <= 0) return [u * W, y];
        const c = frontAt(clamp01(uRef), p);
        if (c <= 0) return [u * W, y];
        const tx = collapseX(i, rowCount, uRef, W);
        const ty = top ? lineTop : lineBottom;
        return [lerp(u * W, tx, c), lerp(y, ty, c)];
      };

      for (const span of rowSpans(field, i, t)) {
        const x0 = span.x0;
        const x1 = span.x1;
        if (x1 < -0.3 || x0 > 1.35) continue;
        /* Overlap each span by half a pixel along the joint and half a pixel at
           the bottom. Adjacent fills share an exact edge, but canvas antialiases
           both sides of it and leaves a hairline of whatever is underneath —
           which here would be the ground, i.e. the one thing this phase must
           never show. Overlapping costs nothing and removes the seam. */
        const bleed = 1.5 / W;
        /* More samples once the collapse is on: u^6 compresses most of a row
           into the left sliver of its slot, so a coarse polygon there turns a
           curve into a visible corner. */
        const n = Math.max(2, Math.ceil((x1 - x0) * (p > 0 ? 64 : 26)));
        ctx.beginPath();
        // Top edge, left to right.
        for (let s = 0; s <= n; s++) {
          const u = x0 + ((x1 - x0 + bleed) * s) / n;
          const [px, py] = warp(u, u, yAt(i, u), true);
          s ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
        }
        // Bottom edge, right to left, shifted back by the skew — so the cut at
        // each end is a slanted line and the next segment's slant matches it.
        for (let s = n; s >= 0; s--) {
          const uRef = x0 + ((x1 - x0 + bleed) * s) / n;
          const u = uRef - skew;
          const [px, py] = warp(u, uRef, yAt(i + 1, u) + 0.5, false);
          ctx.lineTo(px, py);
        }
        ctx.closePath();
        ctx.fillStyle = FIELD_PALETTE[span.c];
        ctx.fill();
      }
    }
  }

  function fieldFrame(now: number) {
    if (fstart < 0) fstart = now;
    // Loop with a beat on the finished line, so it can be judged before the
    // sequence restarts.
    const ms = (now - fstart) % (TOTAL_MS + 700);
    const shown = Math.min(ms, TOTAL_MS);
    ftIn.value = String(shown);
    ftOut.value = `${Math.round(shown)}ms`;
    drawField(shown);
    fraf = requestAnimationFrame(fieldFrame);
  }

  const stopField = () => {
    cancelAnimationFrame(fraf);
    fraf = 0;
    fstart = -1;
    playBtn.textContent = 'play';
  };

  playBtn.addEventListener('click', () => {
    if (fraf) return stopField();
    playBtn.textContent = 'pause';
    fraf = requestAnimationFrame(fieldFrame);
  });
  ftIn.addEventListener('input', () => {
    stopField();
    ftOut.value = `${Math.round(Number(ftIn.value))}ms`;
    drawField(Number(ftIn.value));
  });
  rowsIn.addEventListener('input', () => {
    rowsOut.value = rowsIn.value;
    field = buildField(Number(rowsIn.value));
    drawField(Number(ftIn.value));
  });
  ampIn.addEventListener('input', () => {
    ampOut.value = Number(ampIn.value).toFixed(3);
    drawField(Number(ftIn.value));
  });
  exitBtn.addEventListener('click', () => {
    stopField();
    stage.hidden = true;
    modeSel.value = 'knot';
    renderAll();
  });
  addEventListener('resize', () => drawField(Number(ftIn.value)), { passive: true });

  modeSel.addEventListener('change', () => {
    const on = modeSel.value === 'field';
    stage.hidden = !on;
    if (on) {
      drawField(Number(ftIn.value));
      if (!fraf) playBtn.click();
    } else {
      stopField();
    }
  });

  // Lets a screenshot script hold an exact state instead of racing the UI.
  document.addEventListener('lab:field', (e) => {
    const d = (e as CustomEvent).detail ?? {};
    stage.hidden = false;
    stopField();
    if (d.rows !== undefined) {
      rowsIn.value = String(d.rows);
      field = buildField(Number(d.rows));
    }
    if (d.amp !== undefined) ampIn.value = String(d.amp);
    if (d.t !== undefined) ftIn.value = String(d.t);
    drawField(Number(ftIn.value));
  });

  document.addEventListener('lab:set', (e) => {
    const d = (e as CustomEvent).detail ?? {};
    if (d.shape) shapeSel.value = d.shape;
    if (d.k !== undefined) kIn.value = String(d.k);
    if (d.w !== undefined) wIn.value = String(d.w);
    if (d.d !== undefined) dIn.value = String(d.d);
    if (d.mode) modeSel.value = d.mode;
    if (d.bd) bdSel.value = d.bd;
    if (d.t !== undefined) tIn.value = String(d.t);
    if (d.gaps !== undefined) gapsIn.checked = !!d.gaps;
    if (d.marks !== undefined) marksIn.checked = !!d.marks;
    renderAll();
  });

  renderAll();
</script>
