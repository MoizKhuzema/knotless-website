---
/**
 * /about — "Two careers. One conclusion."
 *
 * Same editorial register as the homepage and /what-we-do: eyebrow + typewriter
 * H1, an accent-rule heading block, founder blocks (name + title from site.ts),
 * a titled "How we deliver" block, and the reversed-Ink final CTA. Copy lives in
 * src/data/about.ts; founder names/titles in src/config/site.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButton from '../components/CtaButton.astro';
import { SITE } from '../config/site';
import { ABOUT_INTRO, ABOUT_FOUNDERS, ABOUT_FINAL_CTA } from '../data/about';
---

<BaseLayout title="About us" description={ABOUT_INTRO.metaDescription}>
  <!-- Section 1 — page intro (same register as the other hero pages) -->
  <section class="pt-20 sm:pt-28">
    <p class="text-label uppercase tracking-tagline text-ink">{ABOUT_INTRO.eyebrow}</p>
    <h1 class="mt-5 text-[2.4rem] font-semibold leading-[1.02] tracking-[-0.035em] text-ink min-[420px]:text-[2.9rem] sm:text-[3.75rem] md:text-[4.25rem] lg:text-[5.75rem] xl:text-[6.75rem]">
      Two careers.<br /><span class="one-emph">One</span> <span class="emph-type" data-word="conclusion."
        ><span class="sr-only">conclusion.</span><span class="ew" aria-hidden="true"
          ><span class="ew-sizer">conclusion.</span><span class="ew-live"><span class="ew-typed">conclusion.</span><span class="ew-caret"></span></span></span
        ></span
      ></span>
    </h1>

    <!-- Convergence diagram: two careers (click to expand) meet in one
         conclusion. Mobile = a single vertical spine (career, career, then the
         conclusion node). Desktop = two career nodes side by side, a pair of
         lines converging to a centred node, then the conclusion below. -->
    <div data-reveal class="mt-12 sm:mt-16">
      <!-- The two career nodes -->
      <div class="relative grid gap-8 sm:grid-cols-2 sm:gap-x-16">
        <!-- mobile spine connecting the two career nodes -->
        <span
          class="absolute left-[1.25rem] top-12 h-[calc(100%-3rem)] w-px bg-warm-grey sm:hidden"
          aria-hidden="true"></span>
        {
          ABOUT_INTRO.careers.map((c) => (
            <details class="career group relative">
              <summary class="flex cursor-pointer list-none items-center gap-4">
                <span class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-warm-grey bg-cream text-label font-semibold uppercase tracking-label text-ink">
                  {c.name.charAt(0)}
                </span>
                <span class="min-w-0">
                  <span class="block text-lg font-semibold tracking-tight text-ink sm:text-xl">
                    {c.name}
                  </span>
                  <span class="block text-base text-warm-grey">{c.teaser}</span>
                </span>
                <span
                  class="career-chev ml-auto shrink-0 text-warm-grey transition-transform duration-300 group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-prose pl-14 text-base text-ink sm:pl-0">{c.experience}</p>
            </details>
          ))
        }
      </div>

      <!-- Converging connector → conclusion. The desktop lines live in an SVG
           that scales to the row width; non-scaling-stroke keeps them crisp. -->
      <div class="relative mt-2 sm:mt-0">
        <svg
          class="hidden h-12 w-full sm:block"
          viewBox="0 0 100 40"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <line x1="25" y1="0" x2="50" y2="38" stroke="var(--color-warm-grey)" vector-effect="non-scaling-stroke" />
          <line x1="75" y1="0" x2="50" y2="38" stroke="var(--color-warm-grey)" vector-effect="non-scaling-stroke" />
        </svg>
        <!-- mobile spine continues into the conclusion node -->
        <span
          class="absolute left-[1.25rem] top-0 h-8 w-px bg-warm-grey sm:hidden"
          aria-hidden="true"></span>
      </div>

      <!-- Conclusion node -->
      <div class="relative mt-8 flex items-start gap-4 sm:mt-2 sm:justify-center sm:text-center">
        <span
          class="relative z-10 mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-terracotta sm:hidden"
          aria-hidden="true"></span>
        <div class="max-w-text">
          <p class="text-label uppercase tracking-tagline text-terracotta">{ABOUT_INTRO.conclusion.label}</p>
          <p class="mt-3 text-base text-ink sm:text-lg">
            <strong class="font-semibold text-ink">{ABOUT_INTRO.conclusion.lead}</strong
            >{ABOUT_INTRO.conclusion.body}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2 — who you'll work with -->
  <section class="pt-section-lg">
    <div data-reveal class="max-w-text">
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {ABOUT_FOUNDERS.heading}
      </h2>
    </div>

    <!-- One combined founder portrait beside both founders' details. Mobile =
         portrait on top, the two bios stacked below. Desktop = portrait left
         (~2fr), details right (~3fr). The portrait is a placeholder box for the
         photo — drop an <img class="h-full w-full object-cover"> inside it. -->
    <div class="mt-12 grid gap-10 sm:mt-16 sm:grid-cols-[2fr_3fr] sm:gap-12 lg:gap-16">
      <div data-reveal class="flex aspect-[4/5] items-center justify-center overflow-hidden rounded-sm border border-warm-grey">
        <span class="label text-warm-grey">Portrait</span>
      </div>

      <div class="space-y-10">
        {
          SITE.founders.map((founder, i) => (
            <div data-reveal>
              <h3 class="text-lg font-semibold tracking-tight text-ink sm:text-xl">{founder.name}</h3>
              <p class="label mt-2 text-ink">{founder.title}</p>
              <p class="mt-4 max-w-prose text-base text-ink">{ABOUT_FOUNDERS.bios[i]}</p>
            </div>
          ))
        }
      </div>
    </div>

    <p data-reveal class="mt-10 text-base text-ink">{ABOUT_FOUNDERS.teamLine}</p>

    <!-- How we deliver: a titled block (same content-block header as the rest). -->
    <div data-reveal class="mt-16 max-w-text">
      <p class="text-base font-semibold text-ink">{ABOUT_FOUNDERS.deliverHeading}</p>
      <div class="mt-3 space-y-4">
        {ABOUT_FOUNDERS.deliverBody.map((para) => <p class="text-base text-ink">{para}</p>)}
      </div>
    </div>
  </section>

  <!-- Section 3 — final CTA (reversed Ink panel) -->
  <section class="pt-section-lg">
    <div data-reveal class="on-ink flex flex-col items-center rounded-sm px-6 py-20 text-center">
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight sm:text-3xl">{ABOUT_FINAL_CTA.heading}</h2>
      <div class="mt-9">
        <CtaButton href={ABOUT_FINAL_CTA.cta.href} variant="inverse">
          {ABOUT_FINAL_CTA.cta.label}
        </CtaButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Career disclosures: hide the native marker; the "+" rotates to "×" on open. */
  .career > summary {
    list-style: none;
  }
  .career > summary::-webkit-details-marker {
    display: none;
  }
  .career-chev {
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 300;
  }

  /* Terracotta strike under "One" — the single accent in the heading. Draws in
     on load; shown resolved under reduced motion. */
  .one-emph {
    position: relative;
    white-space: nowrap;
  }
  .one-emph::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.08em;
    background-color: var(--color-terracotta);
    transform: scaleX(0);
    transform-origin: left;
    animation: one-strike 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;
  }
  @keyframes one-strike {
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .one-emph::after {
      transform: scaleX(1);
      animation: none;
    }
  }
</style>
