---
/**
 * /about — "Two careers. One conclusion."
 *
 * Built entirely from the site's editorial system, left-aligned throughout:
 * eyebrow + typewriter H1 hero (matching the homepage / what-we-do), then
 * accent-rule + h2 sections. The two careers are 12-column bordered rows with
 * terracotta markers (the homepage stages pattern); the conclusion is its own
 * standfirst beat; the founders sit under a full-width combined-portrait band.
 * Copy lives in src/data/about.ts; founder names/titles in src/config/site.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButton from '../components/CtaButton.astro';
import { SITE } from '../config/site';
import { ABOUT_INTRO, ABOUT_FOUNDERS, ABOUT_FINAL_CTA } from '../data/about';
import { graph, webPage, founderPersons } from '../lib/schema';

const origin = Astro.site!.origin;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

// A Person node per founder (from SITE.founders), plus this WebPage.
const schema = graph([
  webPage(origin, {
    url: pageUrl,
    name: 'About Us',
    description: ABOUT_INTRO.metaDescription,
  }),
  ...founderPersons(origin),
]);
---

<BaseLayout title="About Us" description={ABOUT_INTRO.metaDescription} schema={schema}>
  <!-- Section 1 — hero (same register as the homepage / what-we-do heroes).
       On mobile it fills the first screen (content centred) so the next section
       sits below the fold and reveals on scroll; top-aligned from sm up. -->
  <section class="hero-screen sm:pt-28">
    <p class="text-label uppercase tracking-tagline text-ink">{ABOUT_INTRO.eyebrow}</p>
    <h1 class="mt-5 text-[2.4rem] font-semibold leading-[1.02] tracking-[-0.035em] text-ink min-[420px]:text-[2.9rem] sm:text-[3.75rem] md:text-[4.25rem] lg:text-[5.75rem] xl:text-[6.75rem]">
      Two careers.<br /><span class="one-emph">One</span> <span class="emph-type" data-word="conclusion."
        ><span class="sr-only">conclusion.</span><span class="ew" aria-hidden="true"
          ><span class="ew-sizer">conclusion.</span><span class="ew-live"><span class="ew-typed">conclusion.</span><span class="ew-caret"></span></span></span
        ></span
      ></span>
    </h1>

    <p class="mt-8 max-w-text text-base text-ink sm:text-lg">
      {ABOUT_INTRO.lead.pre}<strong class="font-semibold text-ink">{ABOUT_INTRO.lead.strong}</strong
      >{ABOUT_INTRO.lead.post}
    </p>

    <div class="mt-8">
      <CtaButton href={ABOUT_INTRO.cta.href}>{ABOUT_INTRO.cta.label}</CtaButton>
    </div>
  </section>

  <!-- Section 2 — where this comes from: the two careers as bordered rows -->
  <section class="pt-section-lg">
    <div data-reveal>
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {ABOUT_INTRO.careersHeading}
      </h2>
    </div>

    <!-- Each career: a terracotta marker + name + teaser in the left column, the
         full experience in the right column (stacked on mobile). The homepage
         stages pattern, so it reads as native and stays left-aligned. -->
    <div class="mt-10 border-t border-warm-grey sm:mt-14">
      {
        ABOUT_INTRO.careers.map((c) => (
          <article
            data-reveal
            class="border-b border-warm-grey py-6 sm:grid sm:grid-cols-12 sm:items-baseline sm:gap-8 sm:py-7"
          >
            <div class="sm:col-span-4">
              <h3 class="flex items-center gap-3 text-lg font-semibold tracking-tight text-ink">
                <span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-terracotta" />
                {c.name}
              </h3>
              <p class="label mt-2 pl-5 text-warm-grey">{c.teaser}</p>
            </div>
            <p class="mt-3 max-w-prose text-ink sm:col-span-8 sm:mt-0">{c.experience}</p>
          </article>
        ))
      }
    </div>

    <!-- One conclusion: the payoff, closing the same section the careers open. -->
    <div data-reveal class="mt-12 max-w-text sm:mt-14">
      <p class="label text-warm-grey">{ABOUT_INTRO.conclusionHeading}</p>
      <p class="mt-4 text-base text-ink sm:text-lg">
        <strong class="font-semibold text-ink">{ABOUT_INTRO.conclusion.lead}</strong
        >{ABOUT_INTRO.conclusion.body}
      </p>
    </div>
  </section>

  <!-- Section 3 — the names on the door -->
  <section class="pt-section-lg">
    <div data-reveal class="max-w-text">
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {ABOUT_FOUNDERS.heading}
      </h2>
    </div>

    <!-- Combined founder portrait band hidden for now (no photo yet). To bring
         it back, un-comment the block below and drop an
         <img class="h-full w-full object-cover"> inside it.
    <div
      data-reveal
      class="relative mt-10 flex aspect-[4/3] items-end overflow-hidden rounded-sm border border-warm-grey sm:mt-14 sm:aspect-[16/9]"
    >
      <span class="label m-5 text-warm-grey">Insiya &amp; Huzefa</span>
    </div>
    -->

    <!-- Founder details: two left-aligned columns, name + title + bio. -->
    <div class="mt-12 grid gap-10 sm:mt-14 sm:grid-cols-2 sm:gap-12">
      {
        SITE.founders.map((founder, i) => (
          <div data-reveal>
            <h3 class="text-lg font-semibold tracking-tight text-ink sm:text-xl">{founder.name}</h3>
            <p class="label mt-2 text-ink">{founder.title}</p>
            <p class="mt-4 max-w-prose text-base text-ink">{ABOUT_FOUNDERS.bios[i]}</p>
          </div>
        ))
      }
    </div>

    <p data-reveal class="label mt-8 text-warm-grey">{ABOUT_FOUNDERS.location}</p>

    <!-- How we deliver: a titled block (same content-block header as the rest). -->
    <div data-reveal class="mt-12 max-w-text sm:mt-16">
      <p class="text-base font-semibold text-ink">{ABOUT_FOUNDERS.deliverHeading}</p>
      <div class="mt-3 space-y-4">
        {ABOUT_FOUNDERS.deliverBody.map((para) => <p class="text-base text-ink">{para}</p>)}
      </div>
    </div>
  </section>

  <!-- Section 5 — final CTA (reversed Ink panel; the page's one dark moment) -->
  <section class="pt-section-lg">
    <div data-reveal class="on-ink flex flex-col items-center rounded-sm px-6 py-20 text-center">
      <span class="accent-rule"></span>
      <h2 class="mt-6 text-2xl font-semibold tracking-tight sm:text-3xl">{ABOUT_FINAL_CTA.heading}</h2>
      <div class="mt-9">
        <CtaButton href={ABOUT_FINAL_CTA.cta.href} variant="inverse">
          {ABOUT_FINAL_CTA.cta.label}
        </CtaButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Terracotta strike under "One" — the single accent in the heading. Draws in
     on load; shown resolved under reduced motion. */
  .one-emph {
    position: relative;
    white-space: nowrap;
  }
  .one-emph::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.08em;
    background-color: var(--color-terracotta);
    transform: scaleX(0);
    transform-origin: left;
    animation: one-strike 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;
  }
  @keyframes one-strike {
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .one-emph::after {
      transform: scaleX(1);
      animation: none;
    }
  }
</style>
