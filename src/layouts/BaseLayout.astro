---
/**
 * The base layout every page should use.
 *
 * Responsibilities:
 *  - shared <head>: title, description, canonical, favicons, social/OG tags
 *  - font preload (Inter) to avoid layout shift
 *  - the shared Nav and Footer (both read from src/config/site.ts)
 *  - the Cream page shell with a consistent editorial max-width
 *
 * Usage from a page:
 *
 *   ---
 *   import BaseLayout from '../layouts/BaseLayout.astro';
 *   ---
 *   <BaseLayout title="About" description="Who we are">
 *     <h1>About us</h1>
 *   </BaseLayout>
 */
import { SITE } from '../config/site';
import { href } from '../lib/href';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
// Imported through Vite so the URL is hashed and base-aware (works under the
// GitHub Pages sub-path). Used for both the @font-face and the preload below.
import interFont from '../assets/fonts/inter-variable.woff2';

interface Props {
  /** Page <title>. The legal entity name is appended automatically. */
  title: string;
  /** Meta description for SEO / link previews. */
  description?: string;
  /** Hide the shared Nav/Footer chrome (e.g. for the styleguide). */
  bare?: boolean;
}

const { title, description = '', bare = false } = Astro.props;
const fullTitle = `${title} | ${SITE.legalEntityName}`;

// Absolute URLs for canonical + OG. Astro.url.pathname already includes the
// base; og path is base-prefixed via href() before being made absolute.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href('/og-default.png'), Astro.site);

// @font-face injected here (not in CSS) so the font URL carries the base.
const fontFace = `@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url('${interFont}') format('woff2-variations');}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Inter @font-face (base-aware URL) + preload so it's ready before paint. -->
    <style set:html={fontFace}></style>
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />

    <!-- Favicons (generated from the mark on a Cream square). -->
    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={href('/favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={href('/apple-touch-icon.png')} />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        // pt-24 clears the fixed Nav (logo h-14 + py-5 ≈ 96px) so content isn't
        // hidden under it. The hero adds its own top breathing room below that.
        <div class="mx-auto flex min-h-screen max-w-page flex-col px-gutter pt-24">
          <Nav />
          <!-- Sections own their vertical rhythm; no padding here so the hero
               can fill the first viewport. -->
          <main class="flex-1">
            <slot />
          </main>
          <Footer />
        </div>
      )
    }

    <script is:inline>
      // Scroll-reveal: reveal [data-reveal] elements as they enter the viewport.
      // Respects reduced motion and degrades gracefully without IO support.
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>

    <script is:inline>
      // Typewriter for <EmphType> words (.emph-type): type the word in, draw the
      // terracotta strike, blink the caret twice, then remove it. Kept here (not
      // in the component) so the inline script never sits in the word's text
      // flow. Reduced motion / no-JS: the word + strike are shown statically.
      (() => {
        const emphs = document.querySelectorAll('.emph-type');
        if (!emphs.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        emphs.forEach((emph) => {
          const word = emph.getAttribute('data-word') || '';
          const typed = emph.querySelector('.ew-typed');
          const caret = emph.querySelector('.ew-caret');
          if (!typed || !caret || !word) return;

          // Arm immediately so the word doesn't flash before it types.
          typed.textContent = '';
          emph.classList.add('is-typing');
          caret.classList.add('is-on');

          const start = () => {
            let i = 0;
            const tick = () => {
              i += 1;
              typed.textContent = word.slice(0, i);
              if (i < word.length) {
                setTimeout(tick, 78);
              } else {
                emph.classList.remove('is-typing'); // strike draws (CSS transition)
                setTimeout(() => {
                  caret.classList.add('is-blink'); // blink twice
                  caret.addEventListener(
                    'animationend',
                    () => caret.classList.remove('is-on', 'is-blink'),
                    { once: true },
                  );
                }, 600);
              }
            };
            setTimeout(tick, 320); // brief beat before typing
          };

          if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
          else start();
        });
      })();
    </script>
  </body>
</html>
