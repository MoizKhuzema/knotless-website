---
/**
 * The base layout every page uses.
 *
 * Owns: the shared <head>, the self-hosted faces, the nav and footer chrome,
 * the scroll-progress thread, and the one IntersectionObserver that drives
 * every [data-reveal] block on the site.
 */
import { SITE } from '../config/site';
import { href } from '../lib/href';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
// Imported through Vite so the URLs are hashed and base-aware (needed for the
// GitHub Pages sub-path deploy).
import interFont from '../assets/fonts/inter-variable.woff2';
import monoFont from '../assets/fonts/mono-variable.woff2';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  schema?: unknown;
  bare?: boolean;
  /**
   * Let the page manage its own horizontal container and top spacing. The
   * homepage does, because its hero is full-bleed; every other page wants the
   * shell and clearance under the fixed nav.
   */
  bleed?: boolean;
  /**
   * Start with the nav's two flanks — its call to action and its wordmark —
   * hidden, and bring them in together once the page's own hero action scrolls
   * under the bar. The page must mark that element `data-nav-sentinel`.
   */
  navReveal?: boolean;
  /**
   * Emit <meta name="robots" content="noindex, nofollow">. For dev harnesses
   * like /lab/ — sitemap and robots.txt exclusion only discourage crawling,
   * whereas this is what actually keeps the page out of an index if the URL is
   * ever discovered or linked from outside.
   */
  noindex?: boolean;
}

const {
  title,
  description = '',
  ogType = 'website',
  schema,
  bare = false,
  bleed = false,
  navReveal = false,
  noindex = false,
} = Astro.props;

/**
 * GROUND. 'light' puts the site on the brand cream with ink type; 'dark' keeps
 * the near-black. One constant, because every colour downstream is a token —
 * see the [data-theme='light'] block in global.css.
 */
const THEME: 'light' | 'dark' = 'dark';

/** Browser chrome colour per ground. A lookup rather than a ternary: TypeScript
 *  narrows a const to its literal, so `THEME === 'light'` reads as an impossible
 *  comparison the moment THEME is 'dark'. This also keeps the pairing explicit. */
const THEME_COLOR = { light: '#efe9dd', dark: '#0d0c0a' } as const;

const fullTitle = `${title} - Knotless`;
const ogImageAlt = `${SITE.legalEntityName} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href('/og-default.png'), Astro.site);

// @font-face here, not in CSS, so the URLs carry Astro's `base`.
const fontFace = [
  `@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url('${interFont}') format('woff2-variations');}`,
  `@font-face{font-family:'JetBrains Mono Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url('${monoFont}') format('woff2-variations');}`,
].join('');
---

<!doctype html>
<html lang="en-AU" data-theme={THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={THEME_COLOR[THEME]} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <style set:html={fontFace}></style>
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={href('/favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={href('/apple-touch-icon.png')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.legalEntityName} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a href="#main" class="skip">
            Skip to content
          </a>

          {/* The ground lights where the reader's attention is. Sits at the
              grid's layer, so it illuminates the surface and passes BEHIND the
              content rather than washing over the type. */}
          <div class="glow" aria-hidden="true"><span></span></div>

          {/* Scroll progress, drawn as a thread down the left edge of the
              viewport — the hero's bundle, resolved into a single line. */}
          <div class="progress" aria-hidden="true">
            <span></span>
          </div>

          <Nav navReveal={navReveal} />
          <main id="main" tabindex="-1" class={bleed ? undefined : 'main--contained'}>
            {bleed ? <slot /> : <div class="shell"><slot /></div>}
          </main>
          <Footer />
        </>
      )
    }

    <script is:inline>
      /* Cursor illumination.
       *
       * Moved with transform ONLY — a radial gradient repositioned by its
       * background-position repaints a viewport-sized layer every frame, where
       * a translated element is composited. Coalesced into one rAF so a mouse
       * reporting at 1000Hz still costs one move per frame.
       *
       * Fine pointers only, and never under reduced motion: a light that
       * chases the cursor is motion, and there is nothing to follow on a
       * touchscreen. */
      (() => {
        const glow = document.querySelector('.glow');
        if (!glow) return;
        const dot = glow.firstElementChild;
        if (!dot) return;
        if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        /* The light does not follow the pointer, it CHASES it — closing a
         * fraction of the remaining gap each frame. Snapping to the cursor is
         * what makes a glow read as a CSS property being assigned; trailing a
         * little is what makes it read as a thing with mass.
         *
         * EASE is per 60Hz frame, corrected by dt so the same glide plays on a
         * 120Hz panel. Without that correction a ProMotion Mac runs it at
         * double speed and loses the trail entirely — which is most of this
         * audience.
         *
         * The loop PARKS when the light arrives. A rAF that never stops costs a
         * wake-up every frame for a still pointer, all day, on battery. */
        const EASE = 0.12;
        /* How far the ground moves for every pixel the light does. The number
           is small on purpose: at 1440 it is 18px of travel against a 160px
           grid, about a tenth of a cell. Any more and the surface stops
           reading as a surface and starts reading as a thing being dragged. */
        const GRID_GAIN = 0.025;
        /* How far from a panel's edge the light still reaches it. Roughly the
           glow's own radius, so a panel lights when the pool touches it. */
        const CATCH = 240;

        const root = document.documentElement;
        const catchers = [...document.querySelectorAll('[data-catch]')];

        let tx = 0, ty = 0;      // where the pointer is
        let px = 0, py = 0;      // where the light is
        let running = false, seeded = false, lit = false, last = 0;

        const place = () => {
          dot.style.transform = `translate3d(${px}px, ${py}px, 0)`;
          if (!seeded) return;

          /* The ground, trailing at a fraction of the light's travel. */
          root.style.setProperty('--gx', ((px - innerWidth / 2) * GRID_GAIN).toFixed(2) + 'px');
          root.style.setProperty('--gy', ((py - innerHeight / 2) * GRID_GAIN).toFixed(2) + 'px');

          /* Rects are read fresh every frame, not cached. Caching them and
             invalidating on scroll and resize looked obviously cheaper and was
             wrong: the reveal observer TRANSLATES these cards as they come into
             view, so a rect captured on the scroll that triggered the reveal is
             already stale by the time the card lands. Measured symptom —
             --cnear stuck at 0 with the pointer sitting on the card.
             There are two of these on the homepage and nine on /what-we-do/;
             one layout read per frame per card, only while the pointer is
             moving, is not worth a class of bug. */
          for (const el of catchers) {
            const r = el.getBoundingClientRect();
            /* Distance from the pointer to the RECTANGLE, not to its centre —
               zero anywhere inside it. A centre distance would light a wide
               card only when the pointer reached the middle of it. */
            const dx = Math.max(r.left - px, 0, px - r.right);
            const dy = Math.max(r.top - py, 0, py - r.bottom);
            const near = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) / CATCH);
            el.style.setProperty('--cnear', near.toFixed(3));
            el.style.setProperty('--cx', (px - r.left).toFixed(1) + 'px');
            el.style.setProperty('--cy', (py - r.top).toFixed(1) + 'px');
          }
        };

        /* Scrolling moves every panel under a stationary pointer, so one frame
           has to run even though nothing was moved by hand. It parks again
           immediately after. */
        const kick = () => {
          if (seeded && !running) { running = true; last = 0; requestAnimationFrame(frame); }
        };

        const frame = (now) => {
          const dt = last ? Math.min(now - last, 64) : 16.67;
          last = now;
          const k = 1 - Math.pow(1 - EASE, dt / 16.67);
          px += (tx - px) * k;
          py += (ty - py) * k;
          place();
          /* Half a pixel, not a tenth. An exponential approach never actually
             arrives, so the threshold decides how long the tail runs: 0.1px
             took 68 frames to clear a 600px jump, the last twenty of them
             moving the light by less than a pixel in total. It snaps to the
             exact target on park, so the only thing those frames bought was
             battery. */
          if (Math.abs(tx - px) < 0.5 && Math.abs(ty - py) < 0.5) {
            px = tx; py = ty; place();
            running = false; last = 0;
            return;
          }
          requestAnimationFrame(frame);
        };

        addEventListener('pointermove', (e) => {
          tx = e.clientX; ty = e.clientY;
          if (!seeded) {
            /* The first sample snaps. Easing in from the 0,0 origin would swipe
               the light diagonally across the whole page the moment the pointer
               arrives, which is the opposite of subtle. Same on re-entry after
               the pointer has left: the light appears where the cursor is and
               fades up, rather than sliding in from wherever it was abandoned. */
            seeded = true; px = tx; py = ty; place();
          }
          if (!lit) {
            lit = true;
            glow.setAttribute('data-lit', '');
            /* Separate attribute on the root, because [data-catch] elements are
               anywhere in the page and cannot key off the glow's own state. */
            root.setAttribute('data-pointer-lit', '');
          }
          if (!running) { running = true; last = 0; requestAnimationFrame(frame); }
        }, { passive: true });

        /* Capture on document, not scroll on window: the vignette cards live in
           a horizontally scrolling track, and scroll does not bubble out of it.
           Capture sees every scrolling element on the page. */
        document.addEventListener('scroll', kick, { passive: true, capture: true });
        addEventListener('resize', kick, { passive: true });

        const leave = () => {
          lit = false; seeded = false;
          glow.removeAttribute('data-lit');
          root.removeAttribute('data-pointer-lit');
        };
        addEventListener('pointerleave', leave);
        // A pointer that leaves through the document edge does not always fire
        // pointerleave on window; the document one does.
        document.addEventListener('mouseleave', leave);
      })();
    </script>

    <script is:inline>
      // Reveal. One observer for the whole page; each block staggers its own
      // children via --i. Reduced motion or no IO: everything shown up front.
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        if (
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window)
        ) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>

    <script is:inline>
      // Typewriter words (.emph-type) on /about, /what-we-do and /contact: type
      // the word in, then blink the caret twice and drop it. Lives here, not in
      // the component, so the script never sits inside the word's text flow.
      // Reduced motion / no JS: the word is simply shown, already typed.
      (() => {
        const emphs = document.querySelectorAll('.emph-type');
        if (!emphs.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        emphs.forEach((emph) => {
          const word = emph.getAttribute('data-word') || '';
          const typed = emph.querySelector('.ew-typed');
          const caret = emph.querySelector('.ew-caret');
          if (!typed || !caret || !word) return;
          typed.textContent = '';
          caret.classList.add('is-on');
          const start = () => {
            let i = 0;
            const tick = () => {
              i += 1;
              typed.textContent = word.slice(0, i);
              if (i < word.length) return setTimeout(tick, 74);
              setTimeout(() => {
                caret.classList.add('is-blink');
                caret.addEventListener(
                  'animationend',
                  () => caret.classList.remove('is-on', 'is-blink'),
                  { once: true },
                );
              }, 420);
            };
            setTimeout(tick, 300);
          };
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
          else start();
        });
      })();
    </script>

    <script is:inline>
      // Scroll progress thread.
      (() => {
        const bar = document.querySelector('.progress span');
        if (!bar) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        let queued = false;
        const update = () => {
          queued = false;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.transform = `scaleY(${max > 0 ? window.scrollY / max : 0})`;
        };
        addEventListener(
          'scroll',
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(update);
          },
          { passive: true },
        );
        update();
      })();
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 1.5rem;
        top: 1.5rem;
        z-index: 90;
        /* A FILL carrying text, so it takes the brand terracotta rather than
           the lifted ember — same rule as the button. Cream on ember is
           3.35:1 and fails AA; cream on terracotta is 4.95:1. */
        background-color: var(--color-terracotta);
        color: var(--color-on-accent);
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0 1.25rem;
        border-radius: 999px;
        font-size: var(--text-meta);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: var(--tracking-meta);
        text-decoration: none;
      }

      /* Clears the 5rem fixed bar for pages that don't open with a hero. */
      .main--contained {
        padding-top: 9rem;
      }
      @media (max-width: 639px) {
        .main--contained {
          padding-top: 7rem;
        }
      }

      /* z-index 0 puts it on the grid's layer: above the page's own
         background, below `main`/`nav`/`footer`, which are z-index 1. So it
         lights the surface and never lifts the type sitting on it. */
      .glow {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
        contain: strict;
      }
      .glow span {
        position: absolute;
        top: 0;
        left: 0;
        width: 34rem;
        height: 34rem;
        margin: -17rem 0 0 -17rem;
        border-radius: 50%;
        /* A falloff, not a disc.
         *
         * Two evenly spaced stops describe a linear ramp, and nothing in the
         * world falls off linearly — it reads as a flat plate with a soft edge.
         * These five stops trace 1/(1+(r/0.25)^2), the inverse-square curve
         * light actually follows: most of the intensity spent inside the first
         * fifth of the radius, then a long thin tail.
         *
         * Peak and radius are back at the values this started from, 0.1 and
         * 34rem, so the curve is the only thing kept from the falloff pass.
         * Integrated against the two-stop ramp at the same size: mean alpha
         * 0.77x and total emitted 0.77x — dimmer everywhere, because an
         * inverse-square tail is thinner than a linear one.
         *
         * The core is a delta of 19 in 8 bits, the number originally flagged as
         * what a dim display swallows. It survives now for a reason that did
         * not hold then: the light MOVES. Motion is detected far below the
         * contrast threshold of a static patch, and the grid behind it is twice
         * the contrast it was. Do not read this value as safe on its own.
         *
         * The radius grows 34rem -> 46rem because the tail needs somewhere to
         * go; at the old size the curve was still at 0.018 when it hit the
         * edge, which is exactly the rim the stops exist to avoid.
         *
         * One hue throughout. A second colour in the halo is the obvious way to
         * make it read cooler at the edges, and it is also a sixth colour —
         * DESIGN.md 11.1. The falloff does that work instead: thin ember over
         * ink desaturates toward the ground on its own. */
        background: radial-gradient(
          circle closest-side,
          rgba(207, 91, 48, 0.1) 0%,
          rgba(207, 91, 48, 0.061) 20%,
          rgba(207, 91, 48, 0.028) 40%,
          rgba(207, 91, 48, 0.015) 60%,
          rgba(207, 91, 48, 0.006) 80%,
          transparent 100%
        );
        opacity: 0;
        transition: opacity 420ms var(--ease-out);
        will-change: transform;
      }
      .glow[data-lit] span {
        opacity: 1;
      }
      @media (prefers-reduced-motion: reduce) {
        .glow {
          display: none;
        }
      }

      .progress {
        position: fixed;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        z-index: 65;
        pointer-events: none;
        background-color: var(--color-line);
      }
      .progress span {
        display: block;
        height: 100%;
        background: linear-gradient(to bottom, var(--color-ember), var(--color-progress-end));
        transform: scaleY(0);
        transform-origin: top;
      }
      @media (prefers-reduced-motion: reduce) {
        .progress {
          display: none;
        }
      }
      @media (max-width: 639px) {
        .progress {
          width: 1px;
        }
      }
    </style>
  </body>
</html>
