---
/**
 * The base layout every page uses.
 *
 * Owns: the shared <head>, the self-hosted faces, the nav and footer chrome,
 * and the one IntersectionObserver that drives every [data-reveal] block on
 * the site.
 */
import { SITE } from '../config/site';
import { href } from '../lib/href';
import BookingBadge from '../components/BookingBadge.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
// Imported through Vite so the URLs are hashed and base-aware (needed for the
// GitHub Pages sub-path deploy).
import plexSans from '../assets/fonts/plex-sans-variable.woff2';
import plexSerif from '../assets/fonts/plex-serif-600.woff2';
import plexMono400 from '../assets/fonts/plex-mono-400.woff2';
import plexMono500 from '../assets/fonts/plex-mono-500.woff2';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  schema?: unknown;
  bare?: boolean;
  /**
   * Let the page manage its own horizontal container and top spacing. The
   * homepage does, because its hero is full-bleed; every other page wants the
   * shell and clearance under the fixed nav.
   */
  bleed?: boolean;
  /**
   * Emit <meta name="robots" content="noindex, nofollow">. For any page that
   * should not be indexed: sitemap and robots.txt exclusion only discourage
   * crawling, whereas this is what actually keeps a page out of an index if
   * the URL is ever discovered or linked from outside. Nothing sets it today.
   */
  noindex?: boolean;
}

const {
  title,
  description = '',
  ogType = 'website',
  schema,
  bare = false,
  bleed = false,
  noindex = false,
} = Astro.props;

/**
 * GROUND. 'light' puts the site on the brand cream with ink type; 'dark' keeps
 * the near-black. One constant, because every colour downstream is a token —
 * see the [data-theme='light'] block in global.css.
 */
const THEME: 'light' | 'dark' = 'dark';

/** Browser chrome colour per ground. A lookup rather than a ternary: TypeScript
 *  narrows a const to its literal, so `THEME === 'light'` reads as an impossible
 *  comparison the moment THEME is 'dark'. This also keeps the pairing explicit. */
const THEME_COLOR = { light: '#efe9dd', dark: '#13100b' } as const;

const fullTitle = `${title} - Knotless`;
const ogImageAlt = `${SITE.legalEntityName} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href('/og-default.png'), Astro.site);

// @font-face here, not in CSS, so the URLs carry Astro's `base`.
// Sans is variable (wght 100-700, measured from the binary - there is no 800).
// Serif and Mono ship static: Fontsource has no variable build of either, and
// this site needs exactly one serif weight and two mono weights, so a variable
// file would be paying for axes nothing uses.
const fontFace = [
  `@font-face{font-family:'Plex Sans';font-style:normal;font-display:swap;font-weight:100 700;src:url('${plexSans}') format('woff2-variations');}`,
  `@font-face{font-family:'Plex Serif';font-style:normal;font-display:swap;font-weight:600;src:url('${plexSerif}') format('woff2');}`,
  `@font-face{font-family:'Plex Mono';font-style:normal;font-display:swap;font-weight:400;src:url('${plexMono400}') format('woff2');}`,
  `@font-face{font-family:'Plex Mono';font-style:normal;font-display:swap;font-weight:500;src:url('${plexMono500}') format('woff2');}`,
].join('');
---

<!doctype html>
<html lang="en-AU" data-theme={THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={THEME_COLOR[THEME]} />

    {/* THE FIRST PAINT, and the reason this is inline and this early.
     *
     * Every stylesheet on this page is an external <link> further down the
     * head. Until one of them arrives and applies, the browser paints its own
     * default canvas — which is WHITE. On a site whose ground is near-black
     * that is a full-screen white flash on every load and every reload, and
     * nothing in global.css can prevent it, because global.css is the thing
     * being waited for.
     *
     * color-scheme is what actually fixes it: it tells the browser what kind
     * of page this is BEFORE author CSS exists, so the initial canvas, the
     * scrollbars and any form controls all come up dark instead of light. The
     * background-color beside it makes that canvas the page's real ink rather
     * than the browser's generic dark, so there is no second, subtler flash
     * when the stylesheet lands and corrects the shade.
     *
     * is:inline keeps Astro from hoisting this into the bundle it is meant to
     * pre-empt. Both values are derived from the same THEME constant as the
     * theme-color meta above, so a theme switch cannot leave them disagreeing. */}
    <style
      is:inline
      set:html={`:root{color-scheme:${THEME};background-color:${THEME_COLOR[THEME]}}`}
    />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <style set:html={fontFace}></style>
    {/* Sans and Serif only. Both are above the fold - the hero headline is
        Serif and everything around it is Sans. Mono is small labels and the
        arithmetic further down, so it swaps rather than blocking. */}
    <link rel="preload" href={plexSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSerif} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={href('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={href('/favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={href('/apple-touch-icon.png')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.legalEntityName} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}

    <script is:inline>
      /* The viewport width WITHOUT the scrollbar, for the layout grid.
       *
       * CSS cannot express this. 100vw includes the scrollbar, so on a classic-
       * scrollbar platform the grid would be computed from a width ~7px wider
       * than the column it is drawn from, and every card edge would sit half
       * that off its line. Container query units would give the right number
       * but container-type on <body> makes it the containing block for fixed
       * descendants, which breaks the nav and the cursor glow.
       *
       * In the head, before first paint, so there is no frame at the wrong
       * offset. The CSS fallback of 100vw covers a no-JS reader — off by the
       * scrollbar on some platforms, which is the pre-existing behaviour, not a
       * regression. */
      (() => {
        const r = document.documentElement;
        const set = () => r.style.setProperty('--vw', r.clientWidth + 'px');
        set();
        addEventListener('resize', set, { passive: true });
      })();
    </script>
  <script is:inline>
    /* Hold the hero copy in the dark until the torch intro decides whether to
       run, so the words never flash up before the light does. The timeout is a
       safety net in case the stage script never runs. */
    (function () {
      var d = document.documentElement;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || location.hash) return;
      d.classList.add('intro-pending');
      setTimeout(function () { d.classList.remove('intro-pending'); }, 2500);
    })();
  </script>
  </head>
  <body>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a href="#main" class="skip">
            Skip to content
          </a>

          <main id="main" tabindex="-1" class={bleed ? undefined : 'main--contained'}>
            {/* A bleed page lays out its own hero and puts the masthead inside
                it. A contained one has no hero to hang it on, so main carries
                it — otherwise removing the fixed bar would leave those pages
                with no mark at the top of them at all. */}
            {bleed ? <slot /> : (<><Masthead /><div class="shell"><slot /></div></>)}
          </main>
          <BookingBadge />
          <Footer />
        </>
      )
    }

    {/* The cursor illumination script lived here: a rAF that tracked the
        pointer, moved a radial pool with it, drifted the grid for parallax and
        fed the proximity "catch" light on rules and card edges. The pool and
        the parallax were switched off behind flags a while back, the catch
        system has been removed, and the grid it drifted no longer exists — so
        the loop was running every frame to drive nothing. */}

    <script is:inline>
      // Reveal. One observer for the whole page; each block staggers its own
      // children via --i. Reduced motion or no IO: everything shown up front.
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        if (
          window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
          !('IntersectionObserver' in window)
        ) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>

    <script is:inline>
      // Typewriter words (.emph-type) on /about, /what-we-do and /contact: type
      // the word in, then blink the caret twice and drop it. Lives here, not in
      // the component, so the script never sits inside the word's text flow.
      // Reduced motion / no JS: the word is simply shown, already typed.
      (() => {
        const emphs = document.querySelectorAll('.emph-type');
        if (!emphs.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        emphs.forEach((emph) => {
          const word = emph.getAttribute('data-word') || '';
          const typed = emph.querySelector('.ew-typed');
          const caret = emph.querySelector('.ew-caret');
          if (!typed || !caret || !word) return;
          typed.textContent = '';
          caret.classList.add('is-on');
          const start = () => {
            let i = 0;
            const tick = () => {
              i += 1;
              typed.textContent = word.slice(0, i);
              if (i < word.length) return setTimeout(tick, 74);
              setTimeout(() => {
                caret.classList.add('is-blink');
                caret.addEventListener(
                  'animationend',
                  () => caret.classList.remove('is-on', 'is-blink'),
                  { once: true },
                );
              }, 420);
            };
            setTimeout(tick, 300);
          };
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
          else start();
        });
      })();
    </script>


    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 1.5rem;
        top: 1.5rem;
        z-index: 90;
        /* A FILL carrying text, so it takes the brand terracotta rather than
           the lifted ember — same rule as the button. Cream on ember is
           3.35:1 and fails AA; cream on terracotta is 4.95:1. */
        background-color: var(--color-terracotta);
        color: var(--color-on-accent);
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        padding: 0 1.25rem;
        border-radius: 999px;
        font-size: var(--text-meta);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: var(--tracking-meta);
        text-decoration: none;
      }

      /* Stated as "the masthead, plus this much air", the same way the
         homepage hero states it — rather than a round number with no declared
         relationship to the thing it is clearing.

         position:relative because this element is now the masthead's
         containing block: on a page with no hero, main is what the mark hangs
         off. */
      .main--contained {
        position: relative;
        padding-top: var(--main-clear);
      }

    </style>
  </body>
</html>
