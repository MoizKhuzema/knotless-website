---
/**
 * The knot — the site's signature visual, and the brand's own name in motion.
 *
 * A ribbon ties itself into a knot and then pulls open into a single straight
 * line. That line is the terracotta strike through the `o` of the wordmark, so
 * the animation ends by becoming the mark it came from. "Knotless."
 * "AI Untangled." The picture and the proposition are the same thing.
 *
 * SEQUENCE (about 3.6s, once, on load)
 *   0.00-0.85  six colour bands sweep in, stacked across the frame
 *   0.70-1.55  each band slides into place as one segment of a single ribbon
 *   1.45-2.45  the ribbon ties itself into the knot
 *   2.40-2.90  the segment colours resolve to one — ember
 *   2.85-3.60  the knot cinches, then pulls open into a straight line
 *
 * HOW IT IS DRAWN
 * Canvas, not SVG: the shape is a ribbon with real width and per-segment
 * colour, which a stroked path cannot do. Each frame samples the curve, takes
 * the tangent at every sample, offsets along the normal, and fills the quads
 * between consecutive samples. Colour is per-quad, so the "many colours become
 * one" beat is a colour lerp rather than a second system.
 *
 * Crossings read as over/under because the ribbon is drawn in curve order —
 * whatever comes later in the strand paints over what came before, which is
 * what a real knot does — reinforced by a background-coloured gap redrawn
 * around each crossing on the strand that should pass in front.
 *
 * COST: the loop runs only while the animation is playing AND the frame is on
 * screen. It stops for good at the end and leaves the final frame painted, so
 * the hero costs nothing for the rest of the visit. Reduced motion paints the
 * resting line once and never starts a loop.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`knot ${className}`} data-knot aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .knot {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .knot canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  type Pt = [number, number];

  /* ---------------------------------------------------------------------
   * The knot, as control points in a normalised space: x and y both run
   * -1..1, y positive downward to match the canvas.
   *
   * It traces an overhand knot: in from the left, up and over into the first
   * loop, back down across its own incoming strand, round into the second
   * loop, and out to the right. Two crossings, which is the least that still
   * reads as tied rather than merely curly.
   * ------------------------------------------------------------------- */
  const KNOT: Pt[] = [
    [-1.3, 0.0],
    [-0.86, 0.0],
    [-0.52, 0.03],
    [-0.24, -0.28],
    [-0.02, -0.62],
    [0.3, -0.62],
    [0.48, -0.3],
    [0.3, 0.02],
    [-0.02, 0.18],
    [-0.32, 0.34],
    [-0.48, 0.62],
    [-0.16, 0.74],
    [0.2, 0.58],
    [0.38, 0.22],
    [0.6, 0.04],
    [1.3, 0.0],
  ];

  /* Segment colours, read off the page so the ribbon is never a second
   * palette. Filled at runtime from the live custom properties. */
  const SEGMENTS = 6;

  const clamp01 = (n: number) => (n < 0 ? 0 : n > 1 ? 1 : n);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  /** Maps global time onto a phase's own 0..1, eased. */
  const phase = (t: number, a: number, b: number) => clamp01((t - a) / (b - a));
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

  /** Catmull-Rom through the control points — one smooth strand, no corners. */
  function onCurve(ctrl: Pt[], u: number): Pt {
    const n = ctrl.length - 1;
    const f = clamp01(u) * n;
    const i = Math.min(Math.floor(f), n - 1);
    const t = f - i;
    const p0 = ctrl[Math.max(0, i - 1)];
    const p1 = ctrl[i];
    const p2 = ctrl[i + 1];
    const p3 = ctrl[Math.min(n, i + 2)];
    const t2 = t * t;
    const t3 = t2 * t;
    const at = (a: number, b: number, c: number, d: number) =>
      0.5 * (2 * b + (-a + c) * t + (2 * a - 5 * b + 4 * c - d) * t2 + (-a + 3 * b - 3 * c + d) * t3);
    return [at(p0[0], p1[0], p2[0], p3[0]), at(p0[1], p1[1], p2[1], p3[1])];
  }

  /**
   * The strand at knottedness k. k=1 is the full knot; k=0 is a straight line.
   * Every point slides toward the position it would hold on a straight strand
   * of the same length, so the untie IS the knot being pulled open rather than
   * a crossfade between two pictures.
   */
  function strand(u: number, k: number): Pt {
    const [kx, ky] = onCurve(KNOT, u);
    return [lerp(lerp(-1.25, 1.25, u), kx, k), lerp(0, ky, k)];
  }

  /**
   * Where the strand passes over itself, found rather than assumed.
   *
   * The first version hardcoded two guessed parameters, which put the gaps on
   * straight stretches where they did nothing — so the knot read as a flat
   * squiggle. Walking the polyline for genuine self-intersections costs a few
   * thousand cheap tests a frame and is always right, including while the knot
   * unties and the crossings move and then vanish.
   *
   * The later parameter of each pair is the strand drawn second, which is the
   * one in front — so that is the one whose gap gets redrawn.
   */
  function selfCrossings(pts: Pt[]): number[] {
    const out: number[] = [];
    const n = pts.length;
    for (let i = 0; i < n - 1; i++) {
      // Skip immediate neighbours: they share a point and always "intersect".
      for (let j = i + 3; j < n - 1; j++) {
        const [x1, y1] = pts[i];
        const [x2, y2] = pts[i + 1];
        const [x3, y3] = pts[j];
        const [x4, y4] = pts[j + 1];
        const d = (x2 - x1) * (y4 - y3) - (y2 - y1) * (x4 - x3);
        if (Math.abs(d) < 1e-9) continue;
        const t = ((x3 - x1) * (y4 - y3) - (y3 - y1) * (x4 - x3)) / d;
        const u = ((x3 - x1) * (y2 - y1) - (y3 - y1) * (x2 - x1)) / d;
        if (t < 0 || t > 1 || u < 0 || u > 1) continue;
        out.push((j + u) / (n - 1));
      }
    }
    return out;
  }

  function hexToRgb(hex: string): [number, number, number] {
    const h = hex.trim().replace('#', '');
    const s = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
    return [parseInt(s.slice(0, 2), 16), parseInt(s.slice(2, 4), 16), parseInt(s.slice(4, 6), 16)];
  }
  const mixRgb = (a: number[], b: number[], t: number) =>
    `rgb(${Math.round(lerp(a[0], b[0], t))},${Math.round(lerp(a[1], b[1], t))},${Math.round(lerp(a[2], b[2], t))})`;

  function init(host: HTMLElement) {
    const canvas = host.querySelector('canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    const css = getComputedStyle(document.documentElement);
    const read = (name: string, fallback: string) =>
      hexToRgb(css.getPropertyValue(name).trim() || fallback);

    const EMBER = read('--color-ember', '#cf5b30');
    const GROUND = css.getPropertyValue('--color-figure').trim() || '#0a0907';
    // The ribbon's own palette, taken from the page: ember, cream, and the two
    // wire greys. Nothing here is a colour the site does not already use.
    const PALETTE = [
      read('--color-ember', '#cf5b30'),
      read('--color-cream', '#efe9dd'),
      read('--color-wire-lit', '#8b7f72'),
      read('--color-ember', '#cf5b30'),
      read('--color-cream-dim', '#a29b91'),
      read('--color-wire', '#4c4640'),
    ];

    let W = 0;
    let H = 0;
    const resize = () => {
      const r = host.getBoundingClientRect();
      // Cap the device ratio: a retina hero is a lot of pixels for a 4s effect.
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = r.width;
      H = r.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    /**
     * Normalised space -> canvas. x and y scale independently, because the
     * frame is a wide 1200x620 and a single uniform scale left the resting
     * line as a short dash floating in a large empty box. The ribbon's own
     * width is taken from the vertical scale only, so the strand stays an even
     * thickness whichever way it happens to be running.
     */
    const scaleX = () => W / 2.75;
    const scaleY = () => Math.min(W / 2.75, H / 1.95);
    const project = (p: Pt): Pt => [W / 2 + p[0] * scaleX(), H / 2 + p[1] * scaleY()];

    const SAMPLES = 260;

    /** One ribbon segment as a filled quad strip, plus optional gap colour. */
    function band(pts: Pt[], halfW: number[], fill: string | null) {
      if (pts.length < 2) return;
      ctx!.beginPath();
      const norm: Pt[] = pts.map((p, i) => {
        const a = pts[Math.max(0, i - 1)];
        const b = pts[Math.min(pts.length - 1, i + 1)];
        const dx = b[0] - a[0];
        const dy = b[1] - a[1];
        const len = Math.hypot(dx, dy) || 1;
        return [-dy / len, dx / len];
      });
      for (let i = 0; i < pts.length; i++) {
        const x = pts[i][0] + norm[i][0] * halfW[i];
        const y = pts[i][1] + norm[i][1] * halfW[i];
        i === 0 ? ctx!.moveTo(x, y) : ctx!.lineTo(x, y);
      }
      for (let i = pts.length - 1; i >= 0; i--) {
        ctx!.lineTo(pts[i][0] - norm[i][0] * halfW[i], pts[i][1] - norm[i][1] * halfW[i]);
      }
      ctx!.closePath();
      if (fill) {
        ctx!.fillStyle = fill;
        ctx!.fill();
      }
    }

    function draw(time: number) {
      // --- phase clocks ------------------------------------------------
      const sweep = easeOut(phase(time, 0, 0.85));
      const converge = easeInOut(phase(time, 0.7, 1.55));
      const tie = easeInOut(phase(time, 1.45, 2.45));
      const resolve = easeInOut(phase(time, 2.4, 2.9));
      const untieRaw = phase(time, 2.85, 3.6);
      // Cinch before it opens: the knot tightens, then lets go.
      const cinch = Math.sin(clamp01(untieRaw / 0.28) * Math.PI) * 0.1;
      const untie = easeInOut(untieRaw);
      const k = clamp01(tie * (1 - untie) + cinch * (1 - untie));

      ctx!.clearRect(0, 0, W, H);

      const ribbonHalf = scaleY() * 0.085;
      const bandHalf = (H / SEGMENTS / 2) * 0.86;

      for (let s = 0; s < SEGMENTS; s++) {
        // Arc of the finished ribbon this band becomes.
        // Overlap each band a hair into its neighbour: two quad strips that
        // merely touch leave a one-pixel seam of background between them.
        const bleed = 0.004;
        const u0 = Math.max(0, s / SEGMENTS - bleed);
        const u1 = Math.min(1, (s + 1) / SEGMENTS + bleed);
        // Where it starts: a full-width bar, stacked down the frame.
        const bandY = (H / SEGMENTS) * (s + 0.5);
        // Staggered entry, left to right.
        const enter = clamp01((sweep - s * 0.06) / 0.72);
        if (enter <= 0) continue;

        const n = Math.max(2, Math.round((SAMPLES / SEGMENTS) * 1.6));
        const pts: Pt[] = [];
        const halfW: number[] = [];
        for (let i = 0; i < n; i++) {
          const local = i / (n - 1);
          const target = project(strand(lerp(u0, u1, local), k));
          const startX = lerp(-W * 0.15, W * 1.15, local) - (1 - enter) * W * 1.25;
          pts.push([lerp(startX, target[0], converge), lerp(bandY, target[1], converge)]);
          halfW.push(lerp(bandHalf, ribbonHalf, converge));
        }

        const colour = mixRgb(PALETTE[s % PALETTE.length], EMBER, resolve);
        band(pts, halfW, colour);
      }

      // --- over/under -------------------------------------------------
      // Redraw a short window of the strand at each crossing: the background
      // first, which punches the gap that makes the strand in front read as in
      // front, then the strand colour back over it.
      if (k > 0.04 && converge > 0.98) {
        // Coarse polyline of the whole strand, purely to locate crossings.
        const probe: Pt[] = [];
        for (let i = 0; i < 90; i++) probe.push(project(strand(i / 89, k)));
        for (const c of selfCrossings(probe)) {
          const half = 0.03;
          const n = 26;
          const pts: Pt[] = [];
          const hw: number[] = [];
          const hwGap: number[] = [];
          for (let i = 0; i < n; i++) {
            const u = clamp01(c - half + (2 * half * i) / (n - 1));
            pts.push(project(strand(u, k)));
            // Taper the gap at both ends so it blends into the strand.
            const edge = Math.sin((i / (n - 1)) * Math.PI);
            hw.push(ribbonHalf);
            hwGap.push(ribbonHalf + ribbonHalf * 0.5 * edge * Math.min(1, k * 3));
          }
          band(pts, hwGap, GROUND);
          const seg = Math.min(SEGMENTS - 1, Math.floor(c * SEGMENTS));
          band(pts, hw, mixRgb(PALETTE[seg % PALETTE.length], EMBER, resolve));
        }
      }
    }

    /** The state it rests in: the strike from the wordmark. */
    function drawResting() {
      ctx!.clearRect(0, 0, W, H);
      const half = scaleY() * 0.085;
      const n = 40;
      const pts: Pt[] = [];
      const hw: number[] = [];
      for (let i = 0; i < n; i++) {
        pts.push(project(strand(i / (n - 1), 0)));
        hw.push(half);
      }
      band(pts, hw, `rgb(${EMBER[0]},${EMBER[1]},${EMBER[2]})`);
    }

    const DURATION = 3.6;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    resize();
    if (reduce.matches) {
      drawResting();
      window.addEventListener('resize', () => {
        resize();
        drawResting();
      }, { passive: true });
      return;
    }

    let started = 0;
    let raf = 0;
    let done = false;
    let visible = false;

    const tick = (now: number) => {
      if (!started) started = now;
      const t = (now - started) / 1000;
      if (t >= DURATION) {
        drawResting();
        done = true;
        raf = 0;
        return;
      }
      draw(t);
      raf = requestAnimationFrame(tick);
    };

    const start = () => {
      if (done || raf || !visible) return;
      raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    // Only run while the frame is actually on screen, and never again after it
    // has finished.
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        visible ? start() : stop();
      },
      { threshold: 0 },
    ).observe(host);

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    // Seek hook, for visual verification: lets a test paint one exact moment
    // of the sequence instead of trying to catch it mid-flight. Costs nothing
    // in production — nothing dispatches this event.
    host.addEventListener('knot:seek', (e) => {
      stop();
      done = true;
      const t = (e as CustomEvent).detail as number;
      t >= DURATION ? drawResting() : draw(t);
    });

    window.addEventListener(
      'resize',
      () => {
        resize();
        if (done) drawResting();
      },
      { passive: true },
    );
  }

  document.querySelectorAll<HTMLElement>('[data-knot]').forEach(init);
</script>
