---
/**
 * Site navigation.
 *
 * Brand: the wordmark_secondary lockup (wordmark only) — the "original" variant
 * for the light Cream background, height-driven so width stays above the 100px
 * wordmark-only minimum, never recoloured or stretched.
 *
 * Per the content brief: five items. The first three are in-page anchors to the
 * homepage's Assessment stages; the last two are real pages. Links are all-caps
 * metadata (.label). No nav button — the single primary action is the hero CTA.
 */
import { SITE } from '../config/site';
import { href } from '../lib/href';
import wordmark from '../assets/logo/wordmark_secondary/Wordmark_Secondary.svg';

const NAV_LINKS = [
  { label: 'Exploring AI', href: '/#exploring-ai' },
  { label: 'Committing to AI', href: '/#committing-ai' },
  { label: 'Already Running AI', href: '/#already-running-ai' },
  { label: 'What We Do', href: '/what-we-do' },
  { label: 'About', href: '/about' },
];

const here = Astro.url.pathname;
// Only the two real pages get an active state; anchors don't.
const isActive = (href: string) =>
  href.startsWith('/') && !href.includes('#') && here.startsWith(href);
---

<nav class="flex flex-wrap items-center gap-x-8 gap-y-4 py-6">
  <a href={href('/')} aria-label={`${SITE.legalEntityName} — home`} class="shrink-0">
    <!-- height drives size; width auto preserves the locked aspect ratio -->
    <img src={wordmark.src} alt={SITE.legalEntityName} height="44" class="h-11 w-auto" />
  </a>

  <ul class="ml-auto flex flex-wrap items-center gap-x-7 gap-y-2">
    {
      NAV_LINKS.map((link) => (
        <li>
          <a
            href={href(link.href)}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'label text-ink no-underline underline-offset-4 hover:underline',
              isActive(link.href) ? 'underline' : '',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
