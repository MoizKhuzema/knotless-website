---
/**
 * Site navigation bar.
 *
 * The brand label comes from the central config so it stays in sync with the
 * legal entity name. The link list lives here because it's structural to the
 * nav rather than a "site-wide value" — edit NAV_LINKS below to change it.
 */
import { SITE } from '../config/site';
import CtaButton from './CtaButton.astro';

const NAV_LINKS = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Privacy', href: '/privacy' },
];

// Highlight the current page. Astro gives us the request pathname at build time.
const here = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? here === '/' : here.startsWith(href);
---

<nav class="flex items-center gap-6 border-b border-line py-4">
  <a href="/" class="text-lg font-bold text-ink no-underline">{SITE.legalEntityName}</a>

  <ul class="ml-auto flex list-none gap-5 p-0">
    {
      NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'no-underline hover:text-ink',
              isActive(link.href) ? 'text-ink' : 'text-ink-muted',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <CtaButton href="/contact">Contact</CtaButton>
</nav>
