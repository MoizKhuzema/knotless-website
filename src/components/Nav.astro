---
/**
 * Site navigation.
 *
 * Fixed, transparent over the hero, then a blurred ink bar once the page
 * moves — so the hero reads full-bleed and the nav still stays legible over
 * content later. Fixed rather than sticky: sticky ghosted page content over
 * the bar on iOS Safari.
 *
 * Layout is three tracks: the wordmark on the left, the links centred, the
 * call to action on the right. The centre track is centred against the VIEWPORT,
 * not against whatever the two sides happen to weigh — 1fr/auto/1fr, so the
 * links stay put when the flanks appear.
 *
 * Reveal (opt-in via `navReveal`): pages whose hero carries its own wordmark
 * and its own call to action start with BOTH flanks hidden and bring them in
 * together once the hero's button scrolls under the bar. Until then the hero
 * holds the brand and the action, and the bar holds only navigation. Off by
 * default — every other page shows the full bar immediately.
 */
import { SITE } from '../config/site';
import { href } from '../lib/href';
import BrandMark from './BrandMark.astro';
import CtaButton from './CtaButton.astro';
import { HERO } from '../data/homepage';

const NAV_LINKS = [
  { label: 'About us', href: '/about' },
  { label: 'What we do', href: '/what-we-do' },
  { label: 'Contact us', href: '/contact' },
];

interface Props {
  /** See the note above. Requires a [data-nav-sentinel] in the page. */
  navReveal?: boolean;
}
const { navReveal = false } = Astro.props;

const here = Astro.url.pathname;
const isActive = (path: string) => here.startsWith(href(path));
---

<nav class="nav" data-nav-reveal={navReveal ? '' : undefined}>
  <div class="shell nav__bar">
    <!-- LEFT: the mark. Hidden until the hero's button has gone past. -->
    <div class="nav__flank nav__flank--start">
      <a href={href('/')} aria-label={`${SITE.legalEntityName} — home`} class="nav__brand">
        <BrandMark alt={SITE.legalEntityName} />
      </a>
    </div>

    <!-- CENTRE: navigation, and nothing else. -->
    <ul class="nav__links">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={href(link.href)}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={['nav__link', isActive(link.href) && 'is-active']}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- RIGHT: the action, plus the menu toggle below md. -->
    <div class="nav__flank nav__flank--end">
      <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
      <button
        type="button"
        class="nav__toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="nav-menu" class="nav__menu" hidden>
    <div class="shell">
      <ul>
        {
          NAV_LINKS.map((link, i) => (
            <li style={`--i: ${i}`}>
              <a href={href(link.href)} class="nav__menu-link display">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      {/* The bar has no room for the button at phone width, so the action
          lives here instead of being dropped. */}
      <div class="nav__menu-cta" style={`--i: ${NAV_LINKS.length}`}>
        <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 70;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      backdrop-filter var(--dur-fast) var(--ease-out);
    border-bottom: 1px solid transparent;
  }
  .nav[data-stuck] {
    background-color: var(--color-nav-bg);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--color-line);
  }

  /* 1fr / auto / 1fr centres the links against the VIEWPORT rather than against
     the remaining space, so they do not shift when the flanks appear. */
  .nav__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: 5rem;
  }

  .nav__flank {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }
  .nav__flank--start {
    justify-content: flex-start;
  }
  .nav__flank--end {
    justify-content: flex-end;
  }

  /* The bar's button is the compact end of the scale — the hero and the close
     carry the full-size one. */
  .nav__flank--end :global(.btn) {
    min-height: 2.5rem;
    padding-inline: 1.15rem;
  }
  /* Below md the bar has no room for the button, but the toggle shares this
     flank — so hide the BUTTON, not the flank around it. The action moves into
     the drawer. */
  @media (max-width: 47.99rem) {
    .nav__flank--end :global(.btn) {
      display: none;
    }
  }

  .nav__brand {
    display: flex;
    align-items: center;
    flex: none;
  }
  .nav__brand :global(.brand__img) {
    height: 1.05rem;
    width: auto;
  }

  /* The handoff. The hero carries the full lockup; this is the wordmark alone,
     and only one of them is ever on screen.
     
     Hidden state is CSS keyed on the server-rendered attribute, so it is right
     at first paint. Inside no-preference only, so under reduced motion the
     wordmark is simply always visible. visibility (not display) keeps the box,
     so the bar never changes height, and takes the link out of the tab order
     while it is invisible.

     The small downward offset is what sells it: the mark rises into the bar as
     the hero lockup leaves upward, so the two read as one handoff rather than
     two unrelated fades. Entry is faster than exit — arriving should feel
     decisive, leaving should feel like it is getting out of the way. */
  @media (prefers-reduced-motion: no-preference) {
    .nav[data-nav-reveal] .nav__brand,
    .nav[data-nav-reveal] .nav__flank--end :global(.btn) {
      visibility: hidden;
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 240ms var(--ease-out),
        transform 240ms var(--ease-out),
        visibility 0s linear 240ms;
    }
    .nav[data-nav-reveal][data-nav-shown] .nav__brand,
    .nav[data-nav-reveal][data-nav-shown] .nav__flank--end :global(.btn) {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 200ms var(--ease-out),
        transform 320ms var(--ease-out),
        visibility 0s;
    }
    /* The button trails the mark by a beat, so the bar fills as one gesture
       sweeping left to right rather than as a simultaneous pop. The mark is on
       the left now, so it leads. */
    .nav[data-nav-reveal][data-nav-shown] .nav__flank--end :global(.btn) {
      transition-delay: 70ms;
    }
  }

  .nav__links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2.25rem;
  }
  @media (min-width: 48rem) {
    .nav__links {
      display: flex;
      align-items: center;
    }
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-cream-dim);
    text-decoration: none;
    font-size: var(--text-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.6rem;
    height: 1px;
    background-color: var(--color-ember);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav__link:hover,
  .nav__link:focus-visible,
  .nav__link.is-active {
    color: var(--color-cream);
  }
  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  /* --- mobile toggle + full-screen menu -------------------------------- */

  .nav__toggle {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-content: center;
    gap: 6px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }
  @media (min-width: 48rem) {
    .nav__toggle {
      display: none;
    }
  }
  .nav__toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--color-cream);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav__toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .nav__menu {
    position: fixed;
    inset: 5rem 0 0 0;
    background-color: var(--color-ink);
    border-top: 1px solid var(--color-line);
  }
  .nav__menu[hidden] {
    display: none;
  }
  .nav__menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .nav__menu > .shell {
    padding-block: 3rem;
  }
  .nav__menu-cta {
    margin-top: 2.5rem;
  }
  .nav__menu-link {
    display: block;
    padding: 0.4rem 0;
    font-size: clamp(2.25rem, 11vw, 3.5rem);
    color: var(--color-cream);
    text-decoration: none;
  }
  .nav__menu-link:hover {
    color: var(--color-ember);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav__menu:not([hidden]) li,
    .nav__menu:not([hidden]) .nav__menu-cta {
      animation: menu-in var(--dur-mid) var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 70ms);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>

<script>
  (() => {
    const nav = document.querySelector<HTMLElement>('.nav');
    if (!nav) return;

    /* --- stuck state ------------------------------------------------- */
    const sentinelTop = () => window.scrollY > 24;
    const sync = () => nav.toggleAttribute('data-stuck', sentinelTop());
    sync();
    window.addEventListener('scroll', sync, { passive: true });

    /* --- mobile menu -------------------------------------------------- */
    const btn = nav.querySelector<HTMLButtonElement>('.nav__toggle');
    const menu = nav.querySelector<HTMLElement>('#nav-menu');
    if (btn && menu) {
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.hidden = !open;
        document.documentElement.style.overflow = open ? 'hidden' : '';
      };
      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
      menu.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false);
      });
    }

    /* --- flank reveal --------------------------------------------------
     * The hidden state is CSS keyed on the server-rendered attribute, so it
     * is correct at first paint. The sentinel lives in the hero, which the
     * parser reaches after this nav, so the observer is wired on DOM ready.
     * Reduced motion: the CSS never hides them, so there is nothing to do. */
    if (!nav.hasAttribute('data-nav-reveal')) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const init = () => {
      const mark = document.querySelector('[data-nav-sentinel]');
      if (!mark || !('IntersectionObserver' in window)) {
        nav.setAttribute('data-nav-shown', ''); // fail visible
        return;
      }
      /* Trigger point is the whole trick.
       *
       * rootMargin pushes the root's top edge DOWN to y = M, and the sentinel
       * stops intersecting when its bottom crosses above M. So M is literally
       * the handoff line:
       *
       *   M = navH        the sentinel's bottom meets the bar's bottom — exact
       *   M > navH        fires while the sentinel is still showing BELOW the bar
       *   M < navH        fires after it is hidden, leaving a gap with neither
       *
       * The sentinel is the hero's OWN call to action, so the bar's button
       * appears exactly as the hero's leaves. Two of the same button on one
       * screen is the thing to avoid, and the wordmark rides the same trigger
       * so the bar fills in one movement.
       *
       * Measured live rather than cached: the bar's height moves with rem and
       * the viewport, and a stale value puts the handoff in the wrong place. */
      let io: IntersectionObserver | undefined;
      const arm = () => {
        if (io) io.disconnect();
        io = new IntersectionObserver(
          ([entry]) => {
            /* Two ways to not intersect: scrolled past (above the root) or not
             * yet reached (below it, e.g. a restored scroll position). Only the
             * first should fill the bar.
             *
             * Compare the sentinel's BOTTOM against the root's top edge, not
             * its top against 0. The callback only runs at the moment
             * intersection changes, and at that moment a short sentinel's top
             * is still POSITIVE — its bottom crossed the line, its top has not.
             * Testing `top < 0` therefore reads false at the only moment the
             * observer speaks, and since nothing intersects afterwards, no
             * further callback ever arrives to correct it.
             *
             * The previous sentinel was the 148px lockup, whose top was already
             * well past 0 when its bottom crossed, so the wrong test happened
             * to agree. A 48px button does not give it that cover. */
            const rootTop = entry.rootBounds?.top ?? 0;
            const past = !entry.isIntersecting && entry.boundingClientRect.bottom <= rootTop;
            nav.toggleAttribute('data-nav-shown', past);
          },
          {
            rootMargin: `-${nav.offsetHeight}px 0px 0px 0px`,
            threshold: 0,
          },
        );
        io.observe(mark);
      };
      arm();

      // Re-arm on resize (debounced): the bar's height and the hero's layout
      // both change with the viewport, so the trigger has to be recomputed.
      let t: ReturnType<typeof setTimeout>;
      window.addEventListener(
        'resize',
        () => {
          clearTimeout(t);
          t = setTimeout(arm, 150);
        },
        { passive: true },
      );
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
