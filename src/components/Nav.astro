---
/**
 * Site navigation.
 *
 * Fixed, transparent over the hero, then a blurred ink bar once the page
 * moves — so the hero reads full-bleed and the nav still stays legible over
 * content later. Fixed rather than sticky: sticky ghosted page content over
 * the bar on iOS Safari.
 *
 * The bar is the wordmark and the routes, and nothing else — on the phone
 * drawer too. It carried the call to action in both; it no longer does, so
 * navigation asks for nothing anywhere and the page's own buttons are the only
 * place the action is offered.
 *
 * The mark and the links size to their content and the capsule is shrink-to-
 * fit, so it is only ever as wide as what is in it — the mark collapses its
 * track rather than merely fading, and the capsule opens around it.
 *
 * It also senses what is behind it. The bar is glass over whatever the page
 * puts under it, and the closing panel is a cream slab — so the palette is
 * chosen from the measured luminance of the ground, not from the theme.
 *
 * Reveal (opt-in via `navReveal`): pages whose hero carries its own wordmark
 * start with the mark hidden and bring it in once the hero's own lockup
 * scrolls under the bar. Off by default — every other page shows it at once.
 */
import { SITE } from '../config/site';
import { href } from '../lib/href';
import BrandMark from './BrandMark.astro';

const NAV_LINKS = [
  { label: 'About us', href: '/about' },
  { label: 'What we do', href: '/what-we-do' },
  { label: 'Contact us', href: '/contact' },
];

interface Props {
  /** See the note above. Requires a [data-nav-sentinel] in the page. */
  navReveal?: boolean;
}
const { navReveal = false } = Astro.props;

const here = Astro.url.pathname;
const isActive = (path: string) => here.startsWith(href(path));
---

<nav class="nav" data-nav-reveal={navReveal ? '' : undefined}>
  <div class="shell nav__bar">
    <!-- LEFT: the mark. Hidden until the hero's button has gone past. -->
    <div class="nav__flank nav__flank--start">
      <a href={href('/')} aria-label={`${SITE.legalEntityName} — home`} class="nav__brand">
        <BrandMark alt={SITE.legalEntityName} />
      </a>
    </div>

    <!-- CENTRE: navigation, and nothing else. -->
    <ul class="nav__links">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={href(link.href)}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={['nav__link', isActive(link.href) && 'is-active']}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- RIGHT: the menu toggle, below md only. The bar used to carry the call
         to action here too; it does not any more, so above md this flank is
         empty and the capsule closes to the mark and the links. -->
    <div class="nav__flank nav__flank--end">
      <button
        type="button"
        class="nav__toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="nav-menu" class="nav__menu" hidden>
    <div class="shell">
      <ul>
        {
          NAV_LINKS.map((link, i) => (
            <li style={`--i: ${i}`}>
              <a href={href(link.href)} class="nav__menu-link display">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<style>
  /* The bar no longer spans the viewport: it is a floating capsule the width
     of the content, so it begins and ends where the mark and the action do.
     The <nav> is now just the positioner and takes no pointer events, or the
     transparent margin either side of the capsule would swallow clicks meant
     for the page. */
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 70;
    /* --nav-inset-top / --nav-inset-x / --nav-h are declared on :root in
       global.css, because the hero has to clear this bar and a second copy of
       those numbers would drift. The side inset in particular cannot come from
       .shell: the shell is width:100% with a max-width, so it only pulls away
       from the edges past 80rem, and below that the capsule ran edge to edge. */
    padding-top: var(--nav-inset-top);
    padding-inline: var(--nav-inset-x);
    pointer-events: none;
  }

  /* The glass itself. Blur and saturation do the work; the fill stays near
     transparent, because glass that is mostly opaque is a panel with a blur
     behind it. The edge is a hairline of light and the inset top line is the
     specular catch along the upper curve. */
  .nav__bar {
    pointer-events: auto;
    display: grid;
    /* Was 1fr auto 1fr across the full shell, which centred the links against
       the viewport but left the capsule the same width whether the flanks were
       there or not — three links floating in 1,280px of glass at the top of the
       homepage. The tracks size to their content now and the capsule is
       shrink-to-fit, so it is only ever as wide as what is in it.

       The cost, stated plainly: the capsule no longer lines up with the page's
       content column, and the links are centred in the capsule rather than in
       the viewport. A capsule that hugs its contents cannot also hold a fixed
       grid position — those are the same measurement. */
    grid-template-columns: auto auto auto;
    width: fit-content;
    max-width: min(var(--container-page), 100%);
    margin-inline: auto;
    align-items: center;
    /* No column gap: a gap survives its track collapsing to zero and would
       leave dead glass either side of the links. The spacing rides on the
       collapsing content instead. */
    gap: 0;
    height: var(--nav-h);
    border-radius: 999px;
    background-color: var(--color-glass);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    border: 1px solid var(--color-glass-edge);
    box-shadow:
      var(--nav-shadow),
      inset 0 1px 0 var(--color-glass-spec);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  /* Scrolled: the glass thickens rather than switching on. It is always a
     surface — a capsule that is invisible at the top of the page and appears
     on scroll reads as two different objects. */
  /* --- ground sensing --------------------------------------------------
   * The capsule is transparent, so it takes its legibility from whatever is
   * behind it — and the closing panel is a cream slab the bar floats straight
   * over. Cream links on cream is not a subtle failure.
   *
   * data-ground is written by the script from the ACTUAL pixels behind the bar,
   * so this is stated as two complete palettes rather than as a "flip": under
   * the light theme the page is cream and the closing panel is ink, and the
   * same sensor has to solve that case in the other direction.
   *
   * These are nav-local names on purpose. Redefining --color-cream to a dark
   * value would be a lie that leaks to every child. */
  .nav__bar {
    --nav-fg: var(--color-cream);
    --nav-fg-dim: var(--color-cream-dim);
    --nav-shadow: 0 10px 34px rgba(0, 0, 0, 0.34);
    --nav-shadow-stuck: 0 14px 44px rgba(0, 0, 0, 0.44);
  }
  .nav[data-ground='light'] .nav__bar {
    --nav-fg: #16150f;
    /* Not the light theme's --color-cream-dim (#6b645a). The ground here is the
       glass composited over the cream panel, #dfdacf, and #6b645a measures
       4.19:1 against it — under AA. This is 6.72:1. */
    --nav-fg-dim: #4b463c;
    --color-glass: rgba(31, 31, 29, 0.05);
    --color-glass-lift: rgba(31, 31, 29, 0.075);
    --color-glass-edge: rgba(31, 31, 29, 0.14);
    --color-glass-spec: rgba(255, 255, 255, 0.5);
    /* A drop shadow tuned for a dark ground is a bruise on a cream one. Same
       geometry, a third of the weight. */
    --nav-shadow: 0 10px 30px rgba(22, 21, 15, 0.13);
    --nav-shadow-stuck: 0 14px 38px rgba(22, 21, 15, 0.17);
  }
  .nav[data-ground='dark'] .nav__bar {
    /* The shipped values of --color-cream / --color-cream-dim, literal rather
       than referenced: the sensor writes data-ground on every page, so this
       block always wins, and a value that drifted from the token here would
       silently restyle every link on the site. */
    --nav-fg: #efe9dd;
    --nav-fg-dim: #a29b91;
    --color-glass: rgba(239, 233, 221, 0.055);
    --color-glass-lift: rgba(239, 233, 221, 0.085);
    --color-glass-edge: rgba(239, 233, 221, 0.12);
    --color-glass-spec: rgba(255, 255, 255, 0.14);
    --nav-shadow: 0 10px 34px rgba(0, 0, 0, 0.34);
    --nav-shadow-stuck: 0 14px 44px rgba(0, 0, 0, 0.44);
  }

  .nav[data-stuck] .nav__bar {
    background-color: var(--color-glass-lift);
    box-shadow:
      var(--nav-shadow-stuck),
      inset 0 1px 0 var(--color-glass-spec);
  }

  /* On the phone the capsule holds the toggle and, once it has arrived, the
     mark. Shrink-to-fit and centred, that left the only control on the screen
     floating in the middle of it; anchored right it sits where a thumb reaches
     and where a menu button belongs, and the capsule still opens leftwards as
     the mark comes in. */
  @media (max-width: 47.99rem) {
    .nav__bar {
      margin-inline: auto 0;
    }
  }

  .nav__flank {
    display: flex;
    align-items: center;
    /* Spacing is carried by the collapsing children, as above — a flex gap here
       would double it and survive the collapse. */
    gap: 0;
    min-width: 0;
  }
  .nav__flank--start {
    justify-content: flex-start;
  }
  .nav__flank--end {
    justify-content: flex-end;
  }

  /* The collapsing tracks.
   *
   * A single-column grid animated 1fr -> 0fr, with the child clipped. This is
   * the only way to transition to an element's OWN width: max-width needs a
   * number, and any number large enough to clear the content makes the easing
   * finish early and the motion read as a snap. The capsule is shrink-to-fit,
   * so its width follows these tracks frame by frame and needs no transition of
   * its own — width itself is not interpolable between fit-content states.
   *
   * Spacing is the track's own padding rather than a margin on the child, and
   * it animates to zero alongside the column. A margin would have been simpler
   * but it survives the collapse: measured, it left 28px of dead glass at each
   * end of a capsule that was supposed to be closed.
   *
   * Clipping is `clip` with a margin, not `hidden`, so the 2px focus ring at
   * 3px offset still escapes. `hidden` would have swallowed it. */
  .nav__flank--start {
    display: grid;
    grid-template-columns: 1fr;
    min-width: 0;
    /* The mark is set apart from the routes, not evenly spaced with them: 56px
       here against the 36px between the links themselves. They are two
       different things — an identity and a route list — and at 28px the mark
       sat CLOSER to "About us" than the links sat to each other, which read it
       as the first item in the menu. */
    padding-right: 3.5rem;
  }
  .nav__flank--start > * {
    min-width: 0;
    overflow: clip;
    overflow-clip-margin: 6px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav__flank--start {
      transition:
        grid-template-columns 320ms var(--ease-out),
        padding 320ms var(--ease-out);
    }
  }
  .nav[data-nav-reveal]:not([data-nav-shown]) .nav__flank--start {
    grid-template-columns: 0fr;
    padding-right: 0;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    flex: none;
  }
  .nav__brand :global(.brand__img) {
    height: 1.05rem;
    width: auto;
  }

  /* The handoff. The hero carries the full lockup; this is the wordmark alone,
     and only one of them is ever on screen.
     
     Hidden state is CSS keyed on the server-rendered attribute, so it is right
     at first paint. Inside no-preference only, so under reduced motion the
     wordmark is simply always visible. visibility (not display) keeps the box,
     so the bar never changes height, and takes the link out of the tab order
     while it is invisible.

     The small downward offset is what sells it: the mark rises into the bar as
     the hero lockup leaves upward, so the two read as one handoff rather than
     two unrelated fades. Entry is faster than exit — arriving should feel
     decisive, leaving should feel like it is getting out of the way. */
  @media (prefers-reduced-motion: no-preference) {
    .nav[data-nav-reveal] .nav__brand {
      visibility: hidden;
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 240ms var(--ease-out),
        transform 240ms var(--ease-out),
        visibility 0s linear 240ms;
    }
    .nav[data-nav-reveal][data-nav-shown] .nav__brand {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity 200ms var(--ease-out),
        transform 320ms var(--ease-out),
        visibility 0s;
    }
  }

  .nav__links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2.25rem;
  }
  @media (min-width: 48rem) {
    .nav__links {
      display: flex;
      align-items: center;
    }
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--nav-fg-dim);
    text-decoration: none;
    /* Sentence case. The navigation was 11px uppercase at 0.16em tracking —
       the primary way through the site, set like a machine readout. It is the
       single biggest contributor to the technical feel (12 of the 27 instances)
       and the one place where legibility and warmth point the same way:
       navigation is meant to be READ, not decoded. */
    font-size: 0.9375rem; /* 15px — was 13, too quiet for the primary route */
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.6rem;
    height: 1px;
    background-color: var(--color-ember);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav__link:hover,
  .nav__link:focus-visible,
  .nav__link.is-active {
    color: var(--nav-fg);
  }
  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  /* --- mobile toggle + full-screen menu -------------------------------- */

  .nav__toggle {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-content: center;
    gap: 6px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }
  @media (min-width: 48rem) {
    .nav__toggle {
      display: none;
    }
  }
  .nav__toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background-color: var(--nav-fg);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav__toggle[aria-expanded='true'] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* The drawer no longer covers the page, so the page shows through beside and
     below it — which put the page's own "Book a free fit call" thirty pixels
     under the drawer's. The scrim puts the page behind glass instead of
     competing with it, and gives the tap-outside-to-close target that the
     full-bleed drawer used to get for free. */
  .nav:has(#nav-menu:not([hidden]))::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: auto;
    background-color: color-mix(in srgb, var(--color-ink) 72%, transparent);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  /* The drawer hangs off the capsule rather than filling the screen under it.
     A full-bleed panel butted against a floating capsule reads as the capsule
     having failed to detach; a second rounded sheet reads as the same object
     opening.

     pointer-events is not decoration here: .nav is a pointer-events:none
     positioner now, so without this the drawer's links take no clicks. */
  .nav__menu {
    position: fixed;
    top: calc(var(--nav-inset-top) + var(--nav-h) + 0.5rem);
    left: var(--nav-inset-x);
    right: var(--nav-inset-x);
    max-height: calc(100dvh - var(--nav-inset-top) - var(--nav-h) - 1.5rem);
    overflow-y: auto;
    pointer-events: auto;
    border-radius: var(--radius-lg);
    /* Not the glass fill. The drawer carries body copy over whatever is
       scrolled behind it, so it stays mostly ink and lets the blur supply the
       glass rather than the transparency. */
    background-color: color-mix(in srgb, var(--color-ink) 88%, transparent);
    backdrop-filter: blur(22px) saturate(180%);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    border: 1px solid var(--color-glass-edge);
    box-shadow:
      0 18px 50px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 var(--color-glass-spec);
  }
  .nav__menu[hidden] {
    display: none;
  }
  .nav__menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .nav__menu > .shell {
    padding-block: 2rem;
  }
  .nav__menu-link {
    display: block;
    padding: 0.4rem 0;
    /* Was clamp(2.25rem, 11vw, 3.5rem) — 43px at 390, set for a drawer that
       filled the screen. It is a compact sheet now, and three routes do not
       need to be the largest type on the phone. */
    font-size: clamp(1.75rem, 7vw, 2.25rem);
    color: var(--color-cream);
    text-decoration: none;
  }
  .nav__menu-link:hover {
    color: var(--color-ember);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nav__menu:not([hidden]) li {
      animation: menu-in var(--dur-mid) var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 70ms);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>

<script>
  (() => {
    const nav = document.querySelector<HTMLElement>('.nav');
    if (!nav) return;

    /* --- stuck state ------------------------------------------------- */
    const sentinelTop = () => window.scrollY > 24;

    /* --- ground sensing -----------------------------------------------
     * What colour is the thing behind the capsule, right now.
     *
     * Sensed from the live pixels rather than from sections marked up as light
     * or dark. Marking would have been less code, but it is a list that has to
     * be kept in step with the CSS by hand, and a section whose background is
     * themed — the closing panel is cream in the dark theme and ink in the
     * light one — would need its marking to change with the theme too. Reading
     * the computed background asks the question the eye actually asks.
     *
     * elementsFromPoint skips pointer-events:none elements for free, which is
     * exactly right here: the cursor glow is a decorative wash over everything
     * and must not be sensed. .nav's own subtree is filtered explicitly,
     * because .nav__bar does take pointer events.
     *
     * The escape hatch is data-ground on any element the computed background
     * cannot describe — an image, a canvas, a gradient. Nothing needs it yet. */
    const bar = nav.querySelector<HTMLElement>('.nav__bar');

    const channel = (c: number) => {
      const s = c / 255;
      return s <= 0.04045 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
    };
    /* WCAG relative luminance. #efe9dd is 0.818 and the ink ground is 0.004, so
       the midpoint is not a close call — 0.45 sits in empty space. */
    const isLight = (r: number, g: number, b: number) =>
      0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b) > 0.45;

    /** true = light, false = dark, null = nothing conclusive at this point. */
    const groundAt = (x: number, y: number): boolean | null => {
      for (const el of document.elementsFromPoint(x, y)) {
        if (nav.contains(el)) continue;
        const declared = (el as HTMLElement).closest<HTMLElement>('[data-ground]');
        if (declared && !nav.contains(declared)) return declared.dataset.ground === 'light';
        const p = getComputedStyle(el).backgroundColor.match(/[\d.]+/g);
        if (!p) continue;
        /* See-through: it is not the ground, it is something in front of it. */
        if (p.length > 3 && parseFloat(p[3]) < 0.9) continue;
        return isLight(+p[0], +p[1], +p[2]);
      }
      return null;
    };

    const senseGround = () => {
      if (!bar) return;
      const r = bar.getBoundingClientRect();
      if (!r.width) return;
      const y = Math.round(r.top + r.height / 2);
      /* Three points, not one. The capsule is narrower than the page now, and
         the closing panel is inset — so its edges can sit over the page ground
         while its middle is over cream. The capsule has one colour, so the
         majority decides it. */
      let seen = 0;
      let light = 0;
      for (const x of [r.left + 20, (r.left + r.right) / 2, r.right - 20]) {
        const g = groundAt(Math.round(x), y);
        if (g === null) continue;
        seen++;
        if (g) light++;
      }
      if (!seen) return;
      nav.dataset.ground = light * 2 > seen ? 'light' : 'dark';
    };

    let queued = false;
    const sync = () => {
      nav.toggleAttribute('data-stuck', sentinelTop());
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        senseGround();
      });
    };
    sync();
    senseGround();
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
    /* The capsule's own width animates, so its edges move over new ground
       without the page having scrolled. */
    bar?.addEventListener('transitionend', senseGround);

    /* --- mobile menu -------------------------------------------------- */
    const btn = nav.querySelector<HTMLButtonElement>('.nav__toggle');
    const menu = nav.querySelector<HTMLElement>('#nav-menu');
    if (btn && menu) {
      const setOpen = (open: boolean) => {
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.hidden = !open;
        document.documentElement.style.overflow = open ? 'hidden' : '';
      };
      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });
      menu.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setOpen(false);
      });
      /* The scrim is .nav's ::after, so its clicks land on .nav itself — the bar
         and the drawer are children and never report as the target. */
      nav.addEventListener('click', (e) => {
        if (e.target === nav) setOpen(false);
      });
    }

    /* --- the mark ------------------------------------------------------
     * The hidden state is CSS keyed on the server-rendered attribute, so it
     * is correct at first paint. The sentinel lives in the hero, which the
     * parser reaches after this nav, so the observer is wired on DOM ready.
     * Reduced motion: the CSS never hides them, so there is nothing to do. */
    if (!nav.hasAttribute('data-nav-reveal')) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const init = () => {
      const mark = document.querySelector('[data-nav-sentinel]');
      if (!mark || !('IntersectionObserver' in window)) {
        nav.setAttribute('data-nav-shown', ''); // fail visible
        return;
      }
      /* Trigger point is the whole trick.
       *
       * rootMargin pushes the root's top edge DOWN to y = M, and the sentinel
       * stops intersecting when its bottom crosses above M. So M is literally
       * the handoff line:
       *
       *   M = navH        the sentinel's bottom meets the bar's bottom — exact
       *   M > navH        fires while the sentinel is still showing BELOW the bar
       *   M < navH        fires after it is hidden, leaving a gap with neither
       *
       * The sentinel is the hero's own call to action, which is where the
       * lockup stops being on screen too — so the mark appears as the hero
       * leaves. The bar's BUTTON no longer rides this trigger: it has its own
       * observer above, because "the hero has gone" and "no call to action is
       * on screen" stop being the same question the moment a page has a second
       * call to action at the bottom.
       *
       * Measured live rather than cached: the bar's height moves with rem and
       * the viewport, and a stale value puts the handoff in the wrong place. */
      let io: IntersectionObserver | undefined;
      const arm = () => {
        if (io) io.disconnect();
        io = new IntersectionObserver(
          ([entry]) => {
            /* Two ways to not intersect: scrolled past (above the root) or not
             * yet reached (below it, e.g. a restored scroll position). Only the
             * first should fill the bar.
             *
             * Compare the sentinel's BOTTOM against the root's top edge, not
             * its top against 0. The callback only runs at the moment
             * intersection changes, and at that moment a short sentinel's top
             * is still POSITIVE — its bottom crossed the line, its top has not.
             * Testing `top < 0` therefore reads false at the only moment the
             * observer speaks, and since nothing intersects afterwards, no
             * further callback ever arrives to correct it.
             *
             * The previous sentinel was the 148px lockup, whose top was already
             * well past 0 when its bottom crossed, so the wrong test happened
             * to agree. A 48px button does not give it that cover. */
            const rootTop = entry.rootBounds?.top ?? 0;
            const past = !entry.isIntersecting && entry.boundingClientRect.bottom <= rootTop;
            nav.toggleAttribute('data-nav-shown', past);
          },
          {
            rootMargin: `-${nav.offsetHeight}px 0px 0px 0px`,
            threshold: 0,
          },
        );
        io.observe(mark);
      };
      arm();

      // Re-arm on resize (debounced): the bar's height and the hero's layout
      // both change with the viewport, so the trigger has to be recomputed.
      let t: ReturnType<typeof setTimeout>;
      window.addEventListener(
        'resize',
        () => {
          clearTimeout(t);
          t = setTimeout(arm, 150);
        },
        { passive: true },
      );
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
