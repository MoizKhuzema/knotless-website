---
/**
 * Site navigation bar.
 *
 * The brand label comes from the central config so it stays in sync with the
 * legal entity name. The link list lives here because it's structural to the
 * nav rather than a "site-wide value" — edit NAV_LINKS below to change it.
 */
import { SITE } from '../config/site';
import CtaButton from './CtaButton.astro';

const NAV_LINKS = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Privacy', href: '/privacy' },
];

// Highlight the current page. Astro gives us the request pathname at build time.
const here = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? here === '/' : here.startsWith(href);
---

<nav class="nav">
  <a class="brand" href="/">{SITE.legalEntityName}</a>

  <ul class="links">
    {
      NAV_LINKS.map((link) => (
        <li>
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <CtaButton href="/contact">Contact</CtaButton>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .links {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    /* push the CTA to the far right */
    margin-left: auto;
  }

  .links a {
    text-decoration: none;
    color: var(--color-text-muted);
  }

  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--color-text);
  }
</style>
