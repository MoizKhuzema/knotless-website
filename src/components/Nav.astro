---
/**
 * Site navigation — sticky, with a hairline separating it from the page.
 *
 * Brand: the wordmark_secondary "original" lockup for the light Cream
 * background — height-driven so it's never recoloured or stretched.
 *
 * Three equal-weight text links. No button here: the page's own CTAs carry the
 * primary action, so the nav stays quiet and symmetric.
 */
import { SITE } from '../config/site';
import { href } from '../lib/href';
import wordmark from '../assets/logo/wordmark_secondary/Wordmark_Secondary.svg';

const NAV_LINKS = [
  { label: 'About us', href: '/about' },
  { label: 'What we do', href: '/what-we-do' },
  { label: 'Contact us', href: '/contact' },
];

const here = Astro.url.pathname;
const isActive = (path: string) => here.startsWith(href(path));
---

<nav
  class="sticky top-0 z-50 flex flex-wrap items-center gap-x-8 gap-y-4 border-b border-warm-grey bg-cream py-5"
>
  <a href={href('/')} aria-label={`${SITE.legalEntityName} — home`} class="shrink-0">
    <!-- height drives size; width auto preserves the locked aspect ratio -->
    <img src={wordmark.src} alt={SITE.legalEntityName} height="56" class="h-14 w-auto" />
  </a>

  <ul class="ml-auto flex flex-wrap items-center gap-x-8 gap-y-2">
    {
      NAV_LINKS.map((link) => (
        <li>
          <a
            href={href(link.href)}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'label text-ink no-underline underline-offset-4 hover:underline',
              isActive(link.href) ? 'underline' : '',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
