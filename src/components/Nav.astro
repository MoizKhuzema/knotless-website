---
/**
 * Site navigation.
 *
 * Brand: the wordmark_secondary lockup (wordmark only, strike retained). This
 * is the "original" variant for light/Cream backgrounds. It's rendered at a
 * height that keeps its width above the 100px wordmark-only minimum, and never
 * recoloured or stretched (height set, width auto).
 *
 * Links are all-caps metadata (.label). One primary action (Contact).
 */
import { SITE } from '../config/site';
import CtaButton from './CtaButton.astro';
import wordmark from '../assets/logo/wordmark_secondary/Wordmark_Secondary.svg';

const NAV_LINKS = [
  { label: 'About', href: '/about' },
  { label: 'Approach', href: '/approach' },
  { label: 'Insights', href: '/insights' },
];

const here = Astro.url.pathname;
const isActive = (href: string) => here.startsWith(href);
---

<nav class="flex items-center gap-8 py-6">
  <a href="/" aria-label={`${SITE.legalEntityName} — home`} class="shrink-0">
    <!-- height drives size; width auto preserves the locked aspect ratio -->
    <img src={wordmark.src} alt={SITE.legalEntityName} height="44" class="h-11 w-auto" />
  </a>

  <ul class="ml-auto flex items-center gap-8">
    {
      NAV_LINKS.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'label no-underline transition-colors hover:text-ink',
              isActive(link.href) ? 'text-ink' : 'text-warm-grey',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <CtaButton href="/contact">Contact</CtaButton>
</nav>
