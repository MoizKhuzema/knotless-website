---
/**
 * Footer.
 *
 * Closes the page with the mark set large — the bundle finally at rest — over
 * the contact block and legal row. All values come from src/config/site.ts.
 */
import { SITE } from '../config/site';
import { href } from '../lib/href';
import BrandMark from './BrandMark.astro';

const LINKS = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Contact', href: '/contact' },
];
const dial = (phone: string) => phone.replace(/\s+/g, '');
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell">
    <span class="rule-thread" data-catch="line" aria-hidden="true"></span>

    <div class="foot__grid">
      <div class="foot__brand">
        <BrandMark alt={SITE.legalEntityName} />
        <p class="foot__tag meta">{SITE.tagline}</p>
      </div>

      <div class="foot__contact">
        <p class="meta foot__label">Get in touch</p>
        <a class="foot__mail" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        {
          SITE.supportPhone && (
            <p class="foot__people">
              <span>Support</span>
              <a href={`tel:${dial(SITE.supportPhone)}`}>{SITE.supportPhone}</a>
            </p>
          )
        }
      </div>

      <div class="foot__meta">
        <p class="meta foot__label">Elsewhere</p>
        <ul class="foot__links">
          {
            LINKS.map((l) => (
              <li>
                <a href={href(l.href)}>{l.label}</a>
              </li>
            ))
          }
          {/* Until the company page exists this points at the homepage rather
              than at a guessed LinkedIn URL. It is NOT wired to
              SITE.companyLinkedinUrl: that value also feeds schema.org sameAs,
              where an unverified profile would be a false claim about identity
              rather than just a dead link. */}
          <li>
            <a
              href={SITE.companyLinkedinUrl || href('/')}
              {...(SITE.companyLinkedinUrl
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <p class="foot__legal">© {year} {SITE.legalEntityName} · ABN {SITE.abn}</p>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--spacing-section-lg);
    padding-bottom: 3rem;
  }

  .foot__grid {
    display: grid;
    gap: 3rem;
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  /* Snapped from the first breakpoint that has columns at all, not just the
     widest. 1.4fr/1fr/1fr with a 4rem gap left every column start at an
     arbitrary offset — measured 31px off the nearest line at 768. */
  @media (min-width: 48rem) {
    .foot__grid {
      grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
      gap: 0;
    }
    /* 3 / 4 / 2 of nine. The contact column takes the widest share because it
       carries the address, which sets the minimum this layout has to clear. */
    .foot__brand {
      grid-column: 1 / span 3;
      padding-right: 1.5rem;
    }
    .foot__contact {
      grid-column: 4 / span 4;
      padding-right: 1.5rem;
    }
    .foot__meta {
      grid-column: 8 / span 2;
    }
  }
  /* Fifteen columns above 64rem, so the shares change: 6 / 5 / 4. The gutter
     is padding INSIDE the first two columns rather than a grid gap, because a
     gap would push every following column off the lines again. */
  @media (min-width: 64rem) {
    .foot__brand {
      grid-column: 1 / span 6;
      padding-right: var(--grid-cell);
    }
    .foot__contact {
      grid-column: 7 / span 5;
      padding-right: var(--grid-cell);
    }
    .foot__meta {
      grid-column: 12 / span 4;
    }
  }

  .foot__brand :global(.brand__img) {
    height: clamp(1.5rem, 2.4vw, 2.1rem);
    width: auto;
  }
  .foot__tag {
    margin: 1.25rem 0 0;
    color: var(--color-ember);
  }

  .foot__label {
    margin: 0 0 1.25rem;
    color: var(--color-cream-dim);
  }

  .foot__mail {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    /* Was --text-lead, 26px at 1440 — the largest thing in the footer after
       the wordmark, and larger than any body text on the page. The address is
       the footer's most useful line, not its loudest; 21px is the ladder's
       next rung and still reads first. */
    font-size: var(--text-lg);
    color: var(--color-cream);
    text-decoration: none;
    letter-spacing: var(--tracking-tight);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 2px;
    transition: border-color var(--dur-fast) var(--ease-out);
    /* No word-break. It was splitting the address mid-domain —
       "hello@knotless.com.a / u" — whenever the column was narrower than the
       line. An fr track's automatic minimum is its min-content, so with the
       break removed the column simply widens to hold the address instead. */
    white-space: nowrap;
  }
  .foot__mail:hover {
    border-bottom-color: var(--color-ember);
  }

  /* One support line, not a row per founder. Two personal mobiles in the
     footer put the founders' direct numbers on every page of the site; the
     founder cards already carry them where they mean something. */
  .foot__people {
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    font-size: var(--text-sm);
  }
  .foot__people span {
    color: var(--color-cream-dim);
  }
  .foot__people a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-cream);
    text-decoration: none;
  }
  .foot__people a:hover {
    color: var(--color-ember);
  }

  .foot__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .foot__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-cream-dim);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot__links a:hover {
    color: var(--color-ember);
  }

  /* Sentence case, in the sans. It carried .meta, so the copyright and the ABN
     were set in MONOSPACED UPPERCASE with 0.16em tracking — a line that exists
     to be read once, set in the hardest possible way to read it. Nothing about
     "© 2026 Knotless AI Pty Ltd · ABN 74 …" is data that wants tabular figures
     or a label that wants caps. */
  .foot__legal {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-cream-dim);
    opacity: 0.8;
  }
</style>
