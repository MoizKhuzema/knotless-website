---
/**
 * Site footer.
 *
 * Pulls legal entity, ABN, address, and contact emails straight from the
 * central config so they only ever live in one place.
 */
import { SITE } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-12 grid gap-4 border-t border-line py-8 text-sm text-ink-muted">
  <div>
    <p class="font-semibold text-ink">{SITE.legalEntityName}</p>
    <p class="my-0.5">ABN {SITE.abn}</p>
    <p class="my-0.5">{SITE.registeredAddress}</p>
  </div>

  <div>
    <p class="my-0.5">
      General: <a class="text-ink-muted hover:text-ink" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
    </p>
    <p class="my-0.5">
      Privacy: <a class="text-ink-muted hover:text-ink" href={`mailto:${SITE.privacyEmail}`}>{SITE.privacyEmail}</a>
    </p>
  </div>

  <p class="mt-2">© {year} {SITE.legalEntityName}. All rights reserved.</p>
</footer>
