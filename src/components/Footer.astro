---
/**
 * Site footer.
 *
 * Kept on Cream (the default) — a dark footer would be a deliberate emphasis
 * choice, not the baseline. Uses the wordmark_secondary "original" lockup.
 * All legal/contact values come from src/config/site.ts.
 *
 * Layout per the content brief:
 *   - top row: wordmark (left) · LinkedIn (right)
 *   - legal block · link row · copyright
 */
import { SITE } from '../config/site';
import { href } from '../lib/href';
import wordmark from '../assets/logo/wordmark_secondary/Wordmark_Secondary.svg';

// Used only by the (currently hidden) copyright line — restore alongside it.
// const year = new Date().getFullYear();

const LINKS = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="mt-section-lg border-t border-warm-grey py-12 text-sm text-ink">
  <!-- Top row -->
  <div class="flex items-center justify-between gap-6">
    <!-- Negative margin cancels the wordmark's baked-in left clear space so the
         glyph aligns with the legal text below. -->
    <img src={wordmark.src} alt={SITE.legalEntityName} width="381" height="165" class="-ml-[1.4rem] h-16 w-auto sm:h-[4.5rem]" />
    <a
      href={SITE.companyLinkedinUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Knotless AI on LinkedIn"
      class="-m-2 inline-flex p-2 text-ink transition-colors hover:text-terracotta"
    >
      <!-- monoline LinkedIn icon, inherits currentColor (Ink/Warm grey only) -->
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <line x1="7" y1="10" x2="7" y2="17" />
        <circle cx="7" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
        <path d="M11 17v-4a2.5 2.5 0 0 1 5 0v4" />
        <line x1="11" y1="10" x2="11" y2="17" />
      </svg>
    </a>
  </div>

  <!-- Contact block: email + each founder's direct number (from site.ts). -->
  <div class="mt-10 not-italic">
    {/* Legal identity hidden for now — un-comment to restore entity name, ABN and address:
    <p class="text-ink">
      <span class="font-medium">{SITE.legalEntityName}</span>
      <span aria-hidden="true"> · </span>ABN {SITE.abn}
    </p>
    <p class="mt-1">{SITE.registeredAddress}</p>
    */}
    <p>
      <a class="hover:text-ink" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
    </p>
    <div class="mt-3 flex flex-col gap-y-1 sm:flex-row sm:gap-x-8">
      {
        SITE.founders.map((f) => (
          <p>
            <span class="text-warm-grey">{f.name}</span>{' '}
            <a class="hover:text-ink" href={`tel:${f.phone.replace(/\s+/g, '')}`}>{f.phone}</a>
          </p>
        ))
      }
    </div>
  </div>

  <!-- Link row -->
  <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
    {
      LINKS.map((l) => (
        <li>
          <a
            class="label -my-3.5 inline-block py-3.5 text-ink no-underline underline-offset-4 hover:underline"
            href={href(l.href)}
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>

  {/* Copyright line hidden for now — un-comment to restore:
  <p class="mt-8 label">© {year} {SITE.legalEntityName}. All rights reserved.</p>
  */}
</footer>
