---
/**
 * Site footer.
 *
 * Kept on Cream (the default) — a dark footer would be a deliberate emphasis
 * choice, not the baseline. Uses the wordmark_secondary "original" lockup for a
 * light background. All legal/contact values come from src/config/site.ts.
 */
import { SITE } from '../config/site';
import wordmark from '../assets/logo/wordmark_secondary/Wordmark_Secondary.svg';

const year = new Date().getFullYear();
---

<footer class="mt-section border-t border-warm-grey py-12 text-sm text-warm-grey">
  <img src={wordmark.src} alt={SITE.legalEntityName} height="40" class="h-10 w-auto" />

  <div class="mt-8 grid gap-8 sm:grid-cols-2">
    <div class="not-italic">
      <p class="font-medium text-ink">{SITE.legalEntityName}</p>
      <p class="mt-1">ABN {SITE.abn}</p>
      <p class="mt-1">{SITE.registeredAddress}</p>
    </div>

    <div class="sm:text-right">
      <p>
        <a class="hover:text-ink" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
      </p>
      <p class="mt-1">
        <a class="hover:text-ink" href={`mailto:${SITE.privacyEmail}`}>{SITE.privacyEmail}</a>
      </p>
    </div>
  </div>

  <p class="mt-8 label">© {year} {SITE.legalEntityName}</p>
</footer>
