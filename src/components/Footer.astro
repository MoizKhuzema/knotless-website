---
/**
 * Site footer.
 *
 * Kept on Cream (the default) — a dark footer would be a deliberate emphasis
 * choice, not the baseline. Uses the wordmark_secondary "original" lockup.
 * All legal/contact values come from src/config/site.ts.
 *
 * Layout per the content brief:
 *   - top row: wordmark (left) · LinkedIn (right)
 *   - legal block · link row · copyright
 */
import { SITE } from '../config/site';
import wordmark from '../assets/logo/wordmark_secondary/Wordmark_Secondary.svg';

const year = new Date().getFullYear();

const LINKS = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="mt-section-lg border-t border-warm-grey py-12 text-sm text-warm-grey">
  <!-- Top row -->
  <div class="flex items-center justify-between gap-6">
    <img src={wordmark.src} alt={SITE.legalEntityName} height="40" class="h-10 w-auto" />
    <a
      href={SITE.companyLinkedinUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Knotless AI on LinkedIn"
      class="text-warm-grey transition-colors hover:text-ink"
    >
      <!-- monoline LinkedIn icon, inherits currentColor (Ink/Warm grey only) -->
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <line x1="7" y1="10" x2="7" y2="17" />
        <circle cx="7" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
        <path d="M11 17v-4a2.5 2.5 0 0 1 5 0v4" />
        <line x1="11" y1="10" x2="11" y2="17" />
      </svg>
    </a>
  </div>

  <!-- Legal block -->
  <div class="mt-10 not-italic">
    <p class="text-ink">
      <span class="font-medium">{SITE.legalEntityName}</span>
      <span aria-hidden="true"> · </span>ABN {SITE.abn}
    </p>
    <p class="mt-1">{SITE.registeredAddress}</p>
    <p class="mt-1">
      <a class="hover:text-ink" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
    </p>
  </div>

  <!-- Link row -->
  <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
    {
      LINKS.map((l) => (
        <li>
          <a class="label text-warm-grey no-underline hover:text-ink" href={l.href}>
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>

  <p class="mt-8 label">© {year} {SITE.legalEntityName}. All rights reserved.</p>
</footer>
