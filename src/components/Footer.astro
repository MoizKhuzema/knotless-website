---
/**
 * Footer.
 *
 * Closes the page with the mark set large — the bundle finally at rest — over
 * the contact block and legal row. All values come from src/config/site.ts.
 */
import { SITE } from '../config/site';
import { href } from '../lib/href';
import BrandMark from './BrandMark.astro';

const LINKS = [
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Contact', href: '/contact' },
];
const dial = (phone: string) => phone.replace(/\s+/g, '');
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell">
    <hr class="rule" />

    <div class="foot__grid">
      <div class="foot__brand">
        <BrandMark alt={SITE.legalEntityName} />
        <p class="foot__tag meta">{SITE.tagline}</p>
      </div>

      <div class="foot__contact">
        <p class="meta foot__label">Get in touch</p>
        <a class="foot__mail" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
        <ul class="foot__people">
          {
            SITE.founders.map((f) => (
              <li>
                <span>{f.name}</span>
                <a href={`tel:${dial(f.phone)}`}>{f.phone}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="foot__meta">
        <p class="meta foot__label">Elsewhere</p>
        <ul class="foot__links">
          {
            LINKS.map((l) => (
              <li>
                <a href={href(l.href)}>{l.label}</a>
              </li>
            ))
          }
          {
            SITE.companyLinkedinUrl && (
              <li>
                <a href={SITE.companyLinkedinUrl} target="_blank" rel="noopener noreferrer">
                  LinkedIn
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <p class="foot__legal">© {year} {SITE.legalEntityName} · ABN {SITE.abn}</p>
  </div>
</footer>

<style>
  .foot {
    margin-top: var(--spacing-section-lg);
    padding-bottom: 3rem;
  }

  .foot__grid {
    display: grid;
    gap: 3rem;
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  @media (min-width: 48rem) {
    .foot__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 4rem;
    }
  }

  .foot__brand :global(.brand__img) {
    height: clamp(1.5rem, 2.4vw, 2.1rem);
    width: auto;
  }
  .foot__tag {
    margin: 1.25rem 0 0;
    color: var(--color-ember);
  }

  .foot__label {
    margin: 0 0 1.25rem;
    color: var(--color-cream-dim);
  }

  .foot__mail {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-lead);
    color: var(--color-cream);
    text-decoration: none;
    letter-spacing: var(--tracking-tight);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 2px;
    transition: border-color var(--dur-fast) var(--ease-out);
    word-break: break-word;
  }
  .foot__mail:hover {
    border-bottom-color: var(--color-ember);
  }

  .foot__people {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    font-size: var(--text-sm);
  }
  .foot__people li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
  }
  .foot__people span {
    color: var(--color-cream-dim);
  }
  .foot__people a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-cream);
    text-decoration: none;
  }
  .foot__people a:hover {
    color: var(--color-ember);
  }

  .foot__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .foot__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-cream-dim);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot__links a:hover {
    color: var(--color-ember);
  }

  /* Sentence case, in the sans. It carried .meta, so the copyright and the ABN
     were set in MONOSPACED UPPERCASE with 0.16em tracking — a line that exists
     to be read once, set in the hardest possible way to read it. Nothing about
     "© 2026 Knotless AI Pty Ltd · ABN 74 …" is data that wants tabular figures
     or a label that wants caps. */
  .foot__legal {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-cream-dim);
    opacity: 0.8;
  }
</style>
