---
/**
 * The thread field — the site's signature visual.
 *
 * A bundle of threads enters at the left in a tangle and leaves at the right
 * as parallel lines. That IS the proposition, drawn: "AI Untangled." It also
 * extends the logo, whose `o` is cut by a single terracotta strike.
 *
 * Built as one <svg> of generated paths rather than an image, so it is crisp
 * at any size, weighs nothing, recolours with the palette, and can breathe.
 *
 * Behaviour:
 *  - paths draw themselves in on load, left to right
 *  - a slow idle drift keeps the tangled end alive; the resolved end barely
 *    moves, because the whole point is that it has settled
 *  - the bundle leans toward the pointer, very slightly
 *  - the animation loop stops whenever the field is off-screen or the tab is
 *    hidden, so it costs nothing once scrolled past
 *  - prefers-reduced-motion: rendered once, resolved, and never animated
 */
interface Props {
  /** Number of threads. Fewer on small screens is handled at runtime. */
  count?: number;
  class?: string;
}
const { count = 18, class: className = '' } = Astro.props;
---

<div class={`thread-field ${className}`} data-thread-field data-count={count} aria-hidden="true">
  <svg preserveAspectRatio="none" viewBox="0 0 1200 600">
    <g class="thread-field__g"></g>
  </svg>
</div>

<style>
  .thread-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    /* Fades the bundle out at every edge so it reads as something passing
       through the frame rather than a graphic pinned inside it. */
    mask-image: radial-gradient(120% 100% at 68% 50%, #000 32%, transparent 82%);
    -webkit-mask-image: radial-gradient(120% 100% at 68% 50%, #000 32%, transparent 82%);
  }

  .thread-field svg {
    width: 100%;
    height: 100%;
    display: block;
    /* Leans toward the pointer. Set from JS, eased here. */
    transform: translate3d(var(--tx, 0px), var(--ty, 0px), 0);
    transition: transform 1.6s var(--ease-out);
  }

  .thread-field :global(path) {
    fill: none;
    stroke: var(--color-ember);
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  @media (prefers-reduced-motion: no-preference) {
    .thread-field :global(path) {
      stroke-dasharray: var(--len);
      stroke-dashoffset: var(--len);
      animation: thread-draw 2.4s var(--ease-out) forwards;
      animation-delay: calc(var(--i) * 55ms);
    }
  }

  @keyframes thread-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  type Field = {
    el: HTMLElement;
    g: SVGGElement;
    paths: SVGPathElement[];
    n: number;
    seeds: number[];
    visible: boolean;
    raf: number;
    tx: number;
    ty: number;
  };

  const W = 1200;
  const H = 600;
  const SEGMENTS = 9;

  /** Catmull-Rom through the points, emitted as cubic beziers: a single
   *  smooth thread instead of a polyline with visible corners. */
  function smooth(pts: [number, number][]): string {
    let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i - 1] ?? pts[i];
      const p1 = pts[i];
      const p2 = pts[i + 1];
      const p3 = pts[i + 2] ?? p2;
      const c1x = p1[0] + (p2[0] - p0[0]) / 6;
      const c1y = p1[1] + (p2[1] - p0[1]) / 6;
      const c2x = p2[0] - (p3[0] - p1[0]) / 6;
      const c2y = p2[1] - (p3[1] - p1[1]) / 6;
      d += `C${c1x.toFixed(1)},${c1y.toFixed(1)} ${c2x.toFixed(1)},${c2y.toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
    }
    return d;
  }

  /**
   * One thread. `p` runs 0 (left, tangled) to 1 (right, resolved).
   * `chaos` decays as a power curve, so disorder doesn't taper linearly — it
   * collapses, which is what resolution actually looks like.
   */
  function thread(i: number, n: number, t: number, seed: number): string {
    // Where this thread ends up in the resolved bundle.
    const band = H * 0.5 + (i - (n - 1) / 2) * (H * 0.032);
    const pts: [number, number][] = [];
    for (let s = 0; s <= SEGMENTS; s++) {
      const p = s / SEGMENTS;
      const chaos = Math.pow(1 - p, 2.4);
      const y =
        band +
        Math.sin(t * 0.00034 + seed * 5.1 + s * 0.85) * H * 0.3 * chaos +
        Math.sin(t * 0.00021 + seed * 2.3 + s * 1.9) * H * 0.19 * chaos +
        Math.sin(t * 0.00012 + seed * 8.7) * H * 0.02 * (1 - chaos);
      pts.push([-W * 0.08 + p * W * 1.16, y]);
    }
    return smooth(pts);
  }

  function build(f: Field, t: number) {
    f.g.innerHTML = '';
    f.paths = [];
    for (let i = 0; i < f.n; i++) {
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', thread(i, f.n, t, f.seeds[i]));
      // Threads at the edge of the bundle sit back; the core reads strongest.
      const edge = Math.abs(i - (f.n - 1) / 2) / ((f.n - 1) / 2);
      path.style.setProperty('opacity', String(0.5 - edge * 0.33));
      path.style.setProperty('stroke-width', String(1.25 - edge * 0.45));
      path.style.setProperty('--i', String(i));
      f.g.appendChild(path);
      f.paths.push(path);
    }
    // Length is needed for the draw-in; measured once, after insertion.
    for (const p of f.paths) {
      p.style.setProperty('--len', String(Math.ceil(p.getTotalLength())));
    }
  }

  function init(el: HTMLElement) {
    const g = el.querySelector('g') as SVGGElement | null;
    if (!g) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wanted = Number(el.dataset.count ?? 18);
    const n = window.innerWidth < 640 ? Math.round(wanted * 0.6) : wanted;

    const f: Field = {
      el,
      g,
      paths: [],
      n,
      // Fixed seeds, so the tangle is the same shape on every load — it is a
      // designed composition, not a different accident each time.
      seeds: Array.from({ length: n }, (_, i) => (i * 0.6180339887) % 1),
      visible: false,
      raf: 0,
      tx: 0,
      ty: 0,
    };

    build(f, 0);

    if (reduce.matches) return; // drawn once, resolved, never animated

    const loop = (t: number) => {
      for (let i = 0; i < f.paths.length; i++) {
        f.paths[i].setAttribute('d', thread(i, f.n, t, f.seeds[i]));
      }
      f.raf = requestAnimationFrame(loop);
    };

    const start = () => {
      if (!f.raf && f.visible && !document.hidden) f.raf = requestAnimationFrame(loop);
    };
    const stop = () => {
      if (f.raf) cancelAnimationFrame(f.raf);
      f.raf = 0;
    };

    // Only animate while on screen — this sits in the hero, so it is idle for
    // most of the page.
    new IntersectionObserver(
      ([e]) => {
        f.visible = e.isIntersecting;
        f.visible ? start() : stop();
      },
      { threshold: 0 },
    ).observe(el);

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    // Pointer lean. Coarse pointers get nothing — there is no cursor to follow.
    if (window.matchMedia('(pointer: fine)').matches) {
      window.addEventListener(
        'pointermove',
        (e) => {
          const svg = el.querySelector('svg') as SVGElement;
          const dx = (e.clientX / window.innerWidth - 0.5) * 2;
          const dy = (e.clientY / window.innerHeight - 0.5) * 2;
          svg.style.setProperty('--tx', `${(-dx * 18).toFixed(1)}px`);
          svg.style.setProperty('--ty', `${(-dy * 12).toFixed(1)}px`);
        },
        { passive: true },
      );
    }

    // Rebuild on a width class change so phones keep the lighter bundle.
    let lastNarrow = window.innerWidth < 640;
    window.addEventListener(
      'resize',
      () => {
        const narrow = window.innerWidth < 640;
        if (narrow === lastNarrow) return;
        lastNarrow = narrow;
        f.n = narrow ? Math.round(wanted * 0.6) : wanted;
        f.seeds = Array.from({ length: f.n }, (_, i) => (i * 0.6180339887) % 1);
        build(f, performance.now());
      },
      { passive: true },
    );
  }

  document.querySelectorAll<HTMLElement>('[data-thread-field]').forEach(init);
</script>
