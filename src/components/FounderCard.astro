---
/**
 * A single founder's card: photo, name, title, LinkedIn link.
 *
 * Takes one `founder` object — the same shape as the entries in
 * SITE.founders — so you can map over the config to render the whole team:
 *
 *   {SITE.founders.map((f) => <FounderCard founder={f} />)}
 */
import type { Founder } from '../config/site';

interface Props {
  founder: Founder;
}

const { founder } = Astro.props;
---

<article class="flex flex-col items-center gap-2 rounded-xl border border-line p-6 text-center">
  <img
    class="h-40 w-40 rounded-full bg-line object-cover"
    src={founder.photoPath}
    alt={`Photo of ${founder.name}`}
    width="160"
    height="160"
  />
  <h3 class="mt-2 mb-0 text-lg">{founder.name}</h3>
  <p class="m-0 text-ink-muted">{founder.title}</p>
  <a
    class="mt-1 font-semibold text-accent no-underline hover:underline"
    href={founder.linkedinUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    LinkedIn
  </a>
</article>
