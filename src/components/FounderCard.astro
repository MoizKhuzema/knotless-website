---
/**
 * A single founder's card: photo, name, title, LinkedIn link.
 *
 * Takes one `founder` object — the same shape as the entries in
 * SITE.founders — so you can map over the config to render the whole team:
 *
 *   {SITE.founders.map((f) => <FounderCard founder={f} />)}
 */
import type { Founder } from '../config/site';

interface Props {
  founder: Founder;
}

const { founder } = Astro.props;
---

<article class="card">
  <img class="photo" src={founder.photoPath} alt={`Photo of ${founder.name}`} width="160" height="160" />
  <h3 class="name">{founder.name}</h3>
  <p class="title">{founder.title}</p>
  <a class="linkedin" href={founder.linkedinUrl} target="_blank" rel="noopener noreferrer">
    LinkedIn
  </a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    background-color: var(--color-border);
  }

  .name {
    margin: 0.5rem 0 0;
    font-size: 1.15rem;
  }

  .title {
    margin: 0;
    color: var(--color-text-muted);
  }

  .linkedin {
    margin-top: 0.25rem;
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .linkedin:hover {
    text-decoration: underline;
  }
</style>
