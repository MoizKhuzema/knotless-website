---
/**
 * A founder's card — typographic, no photography.
 *
 * The brand uses no photos or illustration, and "any avatar → mark", so the
 * card leads with the mark (its Cream background blends into the Cream card)
 * and relies on type for hierarchy. `founder.photoPath` is intentionally
 * unused under the no-photography rule.
 *
 *   {SITE.founders.map((f) => <FounderCard founder={f} />)}
 */
import type { Founder } from '../config/site';
import mark from '../assets/logo/mark/Mark.svg';

interface Props {
  founder: Founder;
}

const { founder } = Astro.props;
---

<article class="border-t border-warm-grey pt-6">
  <img src={mark.src} alt="" aria-hidden="true" width="56" class="w-14" />
  <h3 class="mt-5 text-lg font-semibold tracking-tight text-ink">{founder.name}</h3>
  <p class="label mt-1 text-ink">{founder.title}</p>
  <a
    class="label mt-4 inline-block text-ink no-underline hover:text-terracotta"
    href={founder.linkedinUrl}
    target="_blank"
    rel="noopener noreferrer"
  >
    LinkedIn →
  </a>
</article>
