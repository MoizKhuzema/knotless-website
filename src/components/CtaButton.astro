---
/**
 * The primary call to action.
 *
 * A pill with the label doubled: the second copy sits below the first and
 * slides up on hover while the first slides out, so the button reads as a
 * mechanism rather than a rectangle that changes colour. The ember fill wipes
 * in from the left behind it, following the same left-to-right gesture as the
 * logo's strike and the hero's threads.
 *
 * Variants:
 *   primary  — ember fill on the dark page
 *   ghost    — hairline outline on dark
 *   inverse  — for the light close panel
 *
 * Minimum 48px tall in every variant. Under prefers-reduced-motion the label
 * swap and wipe are dropped and hover simply brightens.
 */
import { href as withBase } from '../lib/href';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'inverse';
}
const { href, variant = 'primary' } = Astro.props;
---

{/* Every call to action is a sentinel for the bar's own button: the bar hides
    its action whenever one of these is on screen, so the same action is never
    offered twice at once. Nav.astro filters out the two inside itself. */}
<a href={withBase(href)} class:list={['btn', `btn--${variant}`]} data-cta-sentinel>
  <span class="btn__label" aria-hidden="true">
    <span class="btn__a"><slot /></span>
    <span class="btn__b"><slot /></span>
  </span>
  <span class="sr-only"><slot /></span>
  <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2 8h11M9 4l4 4-4 4" />
  </svg>
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  /* The label track: two stacked copies, one visible at a time. */
  .btn__label {
    position: relative;
    display: block;
    overflow: hidden;
    height: 1.4em;
  }
  .btn__a,
  .btn__b {
    display: block;
    line-height: 1.4em;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn__b {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
  }
  .btn:hover .btn__a,
  .btn:focus-visible .btn__a {
    transform: translateY(-100%);
  }
  .btn:hover .btn__b,
  .btn:focus-visible .btn__b {
    transform: translateY(0);
  }

  .btn__arrow {
    width: 1rem;
    height: 1rem;
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn:hover .btn__arrow,
  .btn:focus-visible .btn__arrow {
    transform: translateX(3px);
  }

  /* --- primary: the brand terracotta, deepening on hover -------------- */
  .btn--primary {
    background-color: var(--color-terracotta);
    color: var(--color-on-accent);
  }
  /* Deepens rather than flashing pale. The wipe used to go to cream, which
     the comment above already called "deepening" — it was not. Deepening also
     raises the contrast on hover instead of lowering it, and keeps the button
     terracotta throughout rather than blinking to the page's text colour. */
  .btn--primary::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-terracotta-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn--primary:hover::before,
  .btn--primary:focus-visible::before {
    transform: scaleX(1);
  }

  /* --- ghost: hairline on dark ---------------------------------------- */
  .btn--ghost {
    border-color: var(--color-line);
    color: var(--color-cream);
  }
  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    border-color: var(--color-ember);
    color: var(--color-ember);
  }

  /* --- inverse: for the light close panel ----------------------------- */
  .btn--inverse {
    background-color: var(--color-invert-fg);
    color: var(--color-cream);
  }
  .btn--inverse::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-invert-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn--inverse:hover::before,
  .btn--inverse:focus-visible::before {
    transform: scaleX(1);
  }

  /* Reduced motion: no label swap, no wipe, no arrow nudge — hover still
     reads, via colour alone. */
  @media (prefers-reduced-motion: reduce) {
    .btn__a,
    .btn__b,
    .btn__arrow,
    .btn::before {
      transition: none !important;
    }
    .btn:hover .btn__a,
    .btn:focus-visible .btn__a {
      transform: none;
    }
    .btn:hover .btn__b,
    .btn:focus-visible .btn__b {
      transform: translateY(100%);
    }
    .btn--primary:hover,
    .btn--primary:focus-visible {
      background-color: var(--color-terracotta-deep);
      color: var(--color-on-accent);
    }
    .btn--inverse:hover,
    .btn--inverse:focus-visible {
      background-color: var(--color-invert-accent);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
