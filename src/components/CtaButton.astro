---
/**
 * The primary call-to-action button.
 *
 * Renders as a real <a> link (CTAs almost always navigate somewhere). Use it
 * anywhere you want the site's main action styling:
 *
 *   <CtaButton href="/contact">Get in touch</CtaButton>
 *   <CtaButton href="/signup" variant="secondary">Learn more</CtaButton>
 */
interface Props {
  /** Where the button links to. */
  href: string;
  /** Visual weight. "primary" is the bold default; "secondary" is outlined. */
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;

// Shared shape; the two variants only differ in colour.
const base =
  'inline-block rounded-lg border-2 px-6 py-3 font-semibold leading-none no-underline transition-colors';

const variants = {
  primary:
    'border-accent bg-accent text-accent-contrast hover:border-accent-hover hover:bg-accent-hover',
  secondary:
    'border-accent bg-transparent text-accent hover:bg-accent hover:text-accent-contrast',
} as const;
---

<a href={href} class:list={[base, variants[variant]]}>
  <slot />
</a>
