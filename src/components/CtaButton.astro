---
/**
 * The primary call-to-action.
 *
 * Renders as a real <a> link. Two variants, both within approved colour pairs:
 *   - primary:   solid Ink button, Cream label (Cream-on-Ink) — the one
 *                primary action per layout.
 *   - secondary: Ink outline on the Cream page (Ink-on-Cream) — quieter.
 *
 * Terracotta is deliberately NOT used as a button fill: it's reserved as a
 * single accent per composition (e.g. the accent rule), not a body/UI colour.
 *
 *   <CtaButton href="/contact">Speak with us</CtaButton>
 *   <CtaButton href="/about" variant="secondary">Read more</CtaButton>
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;

const base =
  'inline-block rounded-sm px-7 py-3 text-label font-medium uppercase tracking-label no-underline transition-colors';

const variants = {
  // hover inverts to Ink-on-Cream — an approved pair, no terracotta on a button
  primary: 'border border-ink bg-ink text-cream hover:bg-cream hover:text-ink',
  secondary: 'border border-ink text-ink hover:bg-ink hover:text-cream',
} as const;
---

<a href={href} class:list={[base, variants[variant]]}>
  <slot />
</a>
