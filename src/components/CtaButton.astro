---
/**
 * The primary call to action.
 *
 * A pill with the label doubled: the second copy sits below the first and
 * slides up on hover while the first slides out, so the button reads as a
 * mechanism rather than a rectangle that changes colour. The ember fill wipes
 * in from the left behind it, following the same left-to-right gesture as the
 * logo's strike and the hero's threads.
 *
 * Variants:
 *   primary  — ember fill on the dark page
 *   ghost    — hairline outline on dark
 *   inverse  — for the light close panel
 *
 * 48px tall in every variant, 44px on a phone — the tap-target floor, not a
 * compromise. Under prefers-reduced-motion the label swap and wipe are dropped
 * and hover simply brightens.
 */
import { href as withBase } from '../lib/href';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'inverse';
}
const { href, variant = 'primary' } = Astro.props;
---

{/* data-cta-sentinel is gone with the bar's own button. It existed so the bar
    could hide its action whenever one of these was on screen; the bar carries
    no action now, so nothing observed it. */}
<a href={withBase(href)} class:list={['btn', `btn--${variant}`]}>
  <span class="btn__label" aria-hidden="true">
    <span class="btn__a"><slot /></span>
    <span class="btn__b"><slot /></span>
  </span>
  <span class="sr-only"><slot /></span>
  <svg class="btn__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2 8h11M9 4l4 4-4 4" />
  </svg>
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-family: var(--font-sans);
    /* The caps stay — an action set in caps reads as a button — but at 12px
       rather than 11, and the tracking now comes from the calmed token. */
    font-size: var(--text-label);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  /* Tighter on the phone. 48px tall with 1.6rem of padding either side made a
     236px pill on a 375px screen — nearly two thirds of the width for twenty
     characters. 44px is the tap-target floor, not a compromise, and the
     narrower padding takes ~24px off the pill without touching the label. */
  @media (max-width: 639px) {
    .btn {
      min-height: 2.75rem;
      padding: 0 1.25rem;
    }
  }

  /* The label track: two stacked copies, one visible at a time. */
  .btn__label {
    position: relative;
    display: block;
    overflow: hidden;
    height: 1.4em;
  }
  .btn__a,
  .btn__b {
    display: block;
    line-height: 1.4em;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn__b {
    position: absolute;
    inset: 0;
    transform: translateY(100%);
  }
  .btn:hover .btn__a,
  .btn:focus-visible .btn__a {
    transform: translateY(-100%);
  }
  .btn:hover .btn__b,
  .btn:focus-visible .btn__b {
    transform: translateY(0);
  }

  .btn__arrow {
    width: 1rem;
    height: 1rem;
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn:hover .btn__arrow,
  .btn:focus-visible .btn__arrow {
    transform: translateX(3px);
  }

  /* --- primary: the brand terracotta, lit ----------------------------- */

  /* NEON, at the low end of the word.
   *
   * Three parts, and each is doing a different job. A single big coloured
   * shadow is what makes a button look like a 2010 glow filter; light on a
   * real object has a tight hot edge, a near bloom and a far haze, and it is
   * the ratio between them that reads as luminous rather than as blurred.
   *
   *   ring   a 1px ember rim, which is the FILAMENT — the edge of the thing
   *          that is emitting. Without it the fill just has a cloud around it.
   *   near   a tight bloom, offset down a little so the button still sits on
   *          the page rather than floating off it.
   *   far    a wide, weak haze that colours the ground the button stands on.
   *
   * Ember, not terracotta. The fill is #B0461F because a fill that size does
   * not need the lift; light spilling off it does — ember is the token for a
   * MARK on the ink ground, and a glow is a mark. Terracotta at this alpha
   * over near-black is mud.
   *
   * Kept deliberately weak at rest. The hover state is where it turns on, and
   * a button that is already at full glow has nowhere to go.
   *
   * PULLED IN, and the radius is doing more of that than the alpha. The far
   * haze was 34px and reached most of the way to the words above the button,
   * which is what made it read as an effect applied to the page rather than as
   * light coming off a small object. At 18px it stops inside the button's own
   * margin: the pill is lit, its immediate surround is warmed, and nothing
   * else on the page knows about it. Alphas come down about a third with it,
   * because a tighter glow at the old strength would have been brighter, not
   * quieter. */
  .btn--primary {
    background-color: var(--color-terracotta);
    color: var(--color-on-accent);
    border-color: rgba(207, 91, 48, 0.38);
    box-shadow:
      /* the lit top edge, inside the pill */
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 1px 8px -3px rgba(207, 91, 48, 0.32),
      0 0 18px -8px rgba(207, 91, 48, 0.24);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-mid) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  /* On hover the fill inverts to cream and the glow comes UP rather than off.
     A lit object whose surface turns white should throw more light, not less —
     dropping the glow on hover is the tell that it was a decoration on the
     colour rather than light coming from the object. */
  .btn--primary:hover,
  .btn--primary:focus-visible {
    border-color: rgba(224, 118, 77, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.24),
      0 1px 10px -3px rgba(207, 91, 48, 0.45),
      0 0 26px -8px rgba(207, 91, 48, 0.34);
  }
  /* The glow is light spilling onto a dark ground. On paper there is nothing
     for it to spill onto — a coloured haze on cream reads as a print
     misregistration — so it comes off and the rim carries the whole effect. */
  :global([data-theme='light']) .btn--primary {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 1px 2px rgba(31, 31, 29, 0.14);
  }
  :global([data-theme='light']) .btn--primary:hover,
  :global([data-theme='light']) .btn--primary:focus-visible {
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.3),
      0 2px 8px rgba(31, 31, 29, 0.2);
  }
  /* Inverts on hover: cream ground, near-black type, wiped in from the left in
     the same gesture as the logo's strike. The type colour rides the same
     duration as the wipe, so the label is dark by the time the fill reaches
     it. */
  .btn--primary::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-accent-hover-bg);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn--primary:hover::before,
  .btn--primary:focus-visible::before {
    transform: scaleX(1);
  }
  .btn--primary:hover,
  .btn--primary:focus-visible {
    color: var(--color-accent-hover-fg);
  }

  /* --- ghost: hairline on dark ---------------------------------------- */
  .btn--ghost {
    border-color: var(--color-line);
    color: var(--color-cream);
  }
  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    border-color: var(--color-ember);
    color: var(--color-accent-type);
  }

  /* --- inverse: for the light close panel ----------------------------- */
  .btn--inverse {
    background-color: var(--color-invert-fg);
    color: var(--color-cream);
  }
  .btn--inverse::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-invert-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn--inverse:hover::before,
  .btn--inverse:focus-visible::before {
    transform: scaleX(1);
  }

  /* Reduced motion: no label swap, no wipe, no arrow nudge — hover still
     reads, via colour alone. */
  @media (prefers-reduced-motion: reduce) {
    .btn__a,
    .btn__b,
    .btn__arrow,
    .btn::before {
      transition: none !important;
    }
    .btn:hover .btn__a,
    .btn:focus-visible .btn__a {
      transform: none;
    }
    .btn:hover .btn__b,
    .btn:focus-visible .btn__b {
      transform: translateY(100%);
    }
    /* The glow is a static property, not motion, so it stays — only its
       transition goes. */
    .btn--primary {
      transition: none;
    }
    .btn--primary:hover,
    .btn--primary:focus-visible {
      background-color: var(--color-accent-hover-bg);
      color: var(--color-accent-hover-fg);
    }
    .btn--inverse:hover,
    .btn--inverse:focus-visible {
      background-color: var(--color-invert-accent);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
