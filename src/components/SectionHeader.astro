---
/**
 * Standard section header: the terracotta tick paired inline with a small-caps
 * label, then the heading below. The label gives each section an identity and
 * makes the page read like an authored, indexed document. The tick draws in on
 * scroll-reveal (see global.css).
 */
interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;
---

<div>
  <div class="flex items-center gap-4">
    <span class="accent-rule"></span>
    <span class="label text-ink">{label}</span>
  </div>
  <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
    {title}
  </h2>
</div>
