---
/**
 * Hero.
 *
 * Full viewport, dark, with the thread field behind it. The headline is set
 * enormous in the display serif and broken across two lines so "Untangled"
 * lands alone — the word the whole business turns on gets the strike through
 * it, the same cut the logo makes through its `o`.
 *
 * The wordmark sits above as a masthead and doubles as the nav reveal's
 * sentinel, so the mark is never on screen twice at once.
 */
import { HERO } from '../../data/homepage';
import ThreadField from '../ThreadField.astro';
import CtaButton from '../CtaButton.astro';
import wordmark from '../../assets/logo/wordmark_secondary/Reverse_Wordmark_Secondary.svg';

// "AI Untangled." — the last word carries the strike.
const [first, ...rest] = HERO.headline.split(' ');
const last = rest.join(' ').replace(/\.$/, '');
---

<section class="hero" data-reveal>
  <ThreadField count={20} />

  <!-- Soft ember bloom behind the type: keeps the headline legible over the
       threads without putting a box around it. -->
  <div class="hero__bloom" aria-hidden="true"></div>

  <div class="shell hero__inner">
    <div class="hero__mark r" style="--i: 0">
      <img src={wordmark.src} alt="" aria-hidden="true" width="266" height="48" data-brand-sentinel />
    </div>

    <h1 class="hero__title display">
      <span class="r" style="--i: 1">{first}</span>
      <span class="r" style="--i: 2"><em class="strike">{last}</em>.</span>
    </h1>

    <p class="hero__lead lead r" style="--i: 3">{HERO.standfirst}</p>

    <div class="hero__cta r" style="--i: 4">
      <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
    </div>
  </div>

  <div class="hero__scroll meta r" style="--i: 5" aria-hidden="true">
    <span>Scroll</span>
    <span class="hero__scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: 9rem 6rem;
    isolation: isolate;
  }

  .hero__bloom {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(58% 50% at 28% 48%, rgba(13, 12, 10, 0.97) 34%, rgba(13, 12, 10, 0.55) 62%, transparent 84%),
      radial-gradient(40% 36% at 20% 36%, rgba(207, 91, 48, 0.11), transparent 72%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__mark {
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  .hero__mark img {
    display: block;
    height: clamp(1.5rem, 2.1vw, 2rem);
    width: auto;
  }

  .hero__title {
    font-size: var(--text-display);
    margin: 0;
    max-width: 18ch;
  }
  .hero__title span {
    display: block;
  }
  /* The serif italic is the strongest thing this face does — worth spending
     on the one word that matters. */
  .hero__title em {
    font-style: italic;
  }

  .hero__lead {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    max-width: 44ch;
    color: var(--color-cream-dim);
  }

  .hero__cta {
    margin-top: clamp(2.25rem, 3.5vw, 3rem);
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 2.25rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-cream-dim);
  }
  .hero__scroll-line {
    width: 1px;
    height: 3rem;
    background: linear-gradient(to bottom, var(--color-ember), transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll-line {
      animation: scroll-hint 2.6s var(--ease-out) infinite;
      transform-origin: top;
    }
  }
  @keyframes scroll-hint {
    0%,
    100% {
      transform: scaleY(0.4);
      opacity: 0.4;
    }
    45% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (max-width: 639px) {
    .hero {
      padding-block: 7rem 5rem;
    }
    .hero__scroll {
      display: none;
    }
    .hero__lead {
      max-width: none;
    }
  }
</style>
