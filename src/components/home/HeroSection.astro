---
/**
 * Hero — the flashlight.
 *
 * This is the FlashlightHero implementation, adapted onto the site's copy,
 * type and button rather than reimplemented. Three things make the effect what
 * it is, and all three come from that file:
 *
 *   THE BEAM is two conic gradients from a shared apex — a wide soft fan and a
 *   narrower brighter core inside it — clipped by a radial mask that gives the
 *   distance falloff. That construction is why it reads as a projected beam
 *   with edges rather than as a glow: a gaussian blob has no sides, and a
 *   torch is mostly sides.
 *
 *   THE DUST is 80 motes on a canvas in `screen` blend, drifting upward and
 *   drawn ONLY where they fall inside the cone, faded by both their angle off
 *   the axis and their distance from the lens. It is what makes the light look
 *   like it is travelling through air.
 *
 *   THE REVEAL is not a slide. The copy sits at 4% opacity under a 3px blur
 *   and resolves as the light reaches it, bottom line first, which is the
 *   direction light travels away from a torch held below.
 *
 * The cone is MEASURED, not styled: layout() reads the rendered line boxes of
 * everything marked [data-lit] and solves for the narrowest cone containing
 * them, then pushes the apex back behind the lens so the beam leaves it at the
 * lens's own width. The copy is inside the light by construction at any
 * viewport. See the note in layout() for the arithmetic.
 */
import { HERO } from '../../data/homepage';
import CtaButton from '../CtaButton.astro';
import Masthead from '../Masthead.astro';
---

<section class="hero" id="top" data-stage-a data-hero-gate>
  {/* The wordmark, top left. NOT carrying data-lit: the beam is fitted to the
      copy in the middle of the screen, and a mark up in the corner would force
      the cone open to reach it for no gain, since the torch is below the copy
      and the mark is above it. */}
  <Masthead />

  <div class="shell hero__grid">
    <div class="hero__col">
      {/* data-lit is what the beam is fitted to; TorchStage measures these and
          solves for the cone that contains them. data-box on the button,
          because a control is lit as a whole and not line by line. */}
      <h1 class="hero__h" data-lit>{HERO.headline}</h1>

      <p class="hero__lead lead" data-lit>{HERO.standfirst}</p>

      <div class="hero__cta">
        <div data-lit data-box>
          <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
        </div>
        <p class="hero__note" data-lit>{HERO.ctaNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding-block: var(--main-clear);
    /* Contains the dust canvas's screen blend, so it lightens the beam and the
       black ground and nothing outside this section. */
    isolation: isolate;
    overflow: hidden;

    /* Set by the script. --p is the switch-on curve; the rest is the measured
       cone. The defaults are what renders for the ~1 frame before layout()
       runs, and for anyone the script never reaches. */
    --p: 0;
    --half: 30deg;
    --ax: 50%;
    --ay: 100%;
    --reach: 600px;
    --hx: 50%;
    --hy: 42%;
    --lx: 50%;
    --ly: 90%;
  }


  /* Opaque black over the page's warm ink, handed back over the last eighth so
     the hero does not meet the section below it on a hard change of colour. */




  .hero__grid {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }


  .hero__h {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 1.3rem + 4.2vw, 5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    color: var(--color-cream);
    max-width: 14em;
    text-wrap: balance;
  }

  .hero__lead {
    margin: clamp(1.25rem, 2.2vw, 1.75rem) 0 0;
    max-width: 48ch;
    color: var(--color-cream);
    text-wrap: pretty;
  }

  .hero__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: clamp(2rem, 3vw, 2.75rem);
  }

  /* The brightest of the three, which looks backwards and is not: smallest
     type in the hero AND closest to the lens, so it sits in the most light. */
  .hero__note {
    margin: 0.9rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: #d6cfc4;
  }

  @media (max-width: 639px) {
    .hero__h,
    .hero__lead {
      max-width: none;
    }
    .hero__note {
      font-size: var(--text-md);
    }
  }


  /* No flicker, no drift, no dust, and the copy simply present. */
  @media (prefers-reduced-motion: reduce) {
    .rv {
      opacity: 1;
      filter: none;
      transition: none;
    }
  }
</style>
