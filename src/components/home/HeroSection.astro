---
/**
 * Hero.
 *
 * Two columns at desktop: the claim on the left, the product on the right.
 *
 * The workflow diagram sits in its own framed panel rather than washing across
 * the background. Behind the type it was wallpaper — handsome, and saying
 * nothing. Framed, bracketed and captioned like a figure in a report, it reads
 * as the thing being sold: a tangle of manual handoffs on one side, a running
 * pipeline on the other.
 *
 * The wordmark above doubles as the nav reveal's sentinel, so the mark is
 * never on screen twice at once.
 */
import { HERO } from '../../data/homepage';
import WorkflowField from '../WorkflowField.astro';
import CtaButton from '../CtaButton.astro';
import wordmark from '../../assets/logo/wordmark_secondary/Reverse_Wordmark_Secondary.svg';

// "AI Untangled." — the last word carries the rule.
const [first, ...rest] = HERO.headline.split(' ');
const last = rest.join(' ').replace(/\.$/, '');
---

<section class="hero" data-reveal>
  <div class="shell hero__grid">
    <div class="hero__col">
      <div class="hero__mark r" style="--i: 0">
        <img src={wordmark.src} alt="" aria-hidden="true" width="266" height="48" data-brand-sentinel />
      </div>

      <h1 class="hero__title display">
        <span class="r" style="--i: 1">{first}</span>
        <span class="r hero__line2" style="--i: 2"><span class="strike">{last}</span>.</span>
      </h1>

      <p class="hero__lead lead r" style="--i: 3">{HERO.standfirst}</p>

      <div class="hero__cta r" style="--i: 4">
        <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
      </div>
    </div>

    <!-- The figure. Captioned, because an unlabelled diagram is decoration. -->
    <figure class="hero__figure r" style="--i: 5">
      <div class="hero__frame bracket">
        <WorkflowField />
      </div>
      <figcaption class="hero__key meta">
        <span class="hero__key-item">
          <span class="hero__swatch hero__swatch--manual"></span>Manual process
        </span>
        <span class="hero__key-item">
          <span class="hero__swatch hero__swatch--auto"></span>Automated
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 92svh;
    padding-block: 8rem 4rem;
  }

  .hero__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
    width: 100%;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: 4rem;
    }
  }

  .hero__mark {
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .hero__mark img {
    display: block;
    height: clamp(1.4rem, 1.9vw, 1.8rem);
    width: auto;
  }

  .hero__title {
    font-size: var(--text-display);
    margin: 0;
  }
  .hero__title > span {
    display: block;
  }
  /* Keeps "Untangled." intact — the full stop belongs to the word, and at this
     size a wrapped period reads as a stray dot. */
  .hero__line2 {
    white-space: nowrap;
  }

  .hero__lead {
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
    max-width: 42ch;
    color: var(--color-cream-dim);
  }

  .hero__cta {
    margin-top: clamp(2rem, 3vw, 2.75rem);
  }

  /* --- The figure ------------------------------------------------------ */

  .hero__figure {
    margin: 0;
  }

  .hero__frame {
    position: relative;
    aspect-ratio: 1200 / 620;
    background-color: #0a0907;
    border: 1px solid var(--color-line);
    overflow: hidden;
  }

  .hero__key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    margin-top: 1rem;
    color: var(--color-cream-dim);
  }
  .hero__key-item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hero__swatch {
    width: 1.5rem;
    flex: none;
  }
  .hero__swatch--manual {
    height: 1px;
    background-color: var(--color-wire-lit);
  }
  .hero__swatch--auto {
    height: 2px;
    background-color: var(--color-ember);
  }

  @media (max-width: 639px) {
    .hero {
      padding-block: 6.5rem 4rem;
      min-height: 0;
    }
    .hero__lead {
      max-width: none;
    }
  }
</style>
