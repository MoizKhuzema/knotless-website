---
/**
 * Hero. One left-aligned column: the mark, the claim, the action.
 *
 * The knot used to sit in a bordered panel beside this column, which made it
 * read as an illustration NEXT TO the brand rather than as the brand. It is now
 * KnotIntro — a full-viewport overlay that ties itself, pulls straight, and
 * lands on the terracotta strike inside this lockup's `o`. So the figure is
 * gone and the column is on its own: the animation's destination is the hero
 * itself, and a box beside it would be competing with the place it lands.
 *
 * The call to action below is the nav reveal's sentinel: the bar's own button
 * and wordmark appear only once this one has scrolled past, so neither the
 * action nor the mark is ever on screen twice.
 */
import { HERO } from '../../data/homepage';
import CtaButton from '../CtaButton.astro';
// The PRIMARY lockup: wordmark with the tagline set beneath it. It carries
// "AI Untangled." itself, so the hero no longer sets that line as type — the
// brand says it once, in its own lettering.
//
// The _Flush variant sets the tagline flush left to the wordmark rather than
// centred under it, so the lockup shares the left edge every other element in
// this column is aligned to. BrandMark picks the ink or cream artwork to suit
// the ground.
import BrandMark from '../BrandMark.astro';
---

<section class="hero" data-reveal>
  <div class="shell hero__grid">
    <div class="hero__col">
      {/* The lockup IS the h1. An <img> inside the heading with real alt text
          is a proper h1 — the page keeps its heading and its accessible name
          without setting the tagline twice. */}
      <h1 class="hero__lockup r" style="--i: 0">
        <BrandMark variant="lockup" alt={`Knotless — ${HERO.headline}`} />
      </h1>

      <p class="hero__lead lead r" style="--i: 1">{HERO.standfirst}</p>

      {/* The nav's flanks key off THIS element: the bar's button appears as
          this one leaves, so the same action is never on screen twice. */}
      <div class="hero__cta r" style="--i: 2" data-nav-sentinel>
        <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 88svh;
    padding-block: 7rem 4rem;
  }

  .hero__grid {
    width: 100%;
  }

  /* The lockup carries the weight the headline used to. Sized off the column
     rather than a fixed height, so it scales with the layout; the 3.52:1 ratio
     of the asset does the rest. */
  .hero__lockup {
    margin: 0;
    max-width: min(100%, 34rem);
  }


  .hero__lead {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    max-width: 42ch;
    color: var(--color-cream-dim);
  }

  .hero__cta {
    margin-top: clamp(2rem, 3vw, 2.75rem);
  }

  @media (max-width: 639px) {
    .hero {
      padding-block: 6.5rem 4rem;
      min-height: 0;
    }
    .hero__lead {
      max-width: none;
    }
  }
</style>
