---
/**
 * Section 4 — final CTA.
 * A reversed Ink panel: the one deliberate dark moment on the page, used for
 * emphasis at the close. Terracotta accent rule on Ink is an approved pair;
 * the button uses the "inverse" variant for dark backgrounds.
 */
import { FINAL_CTA } from '../../data/homepage';
import CtaButton from '../CtaButton.astro';
import FitCallMeta from '../FitCallMeta.astro';
---

<section class="pt-section-lg">
  <div data-reveal class="on-ink flex flex-col items-center rounded-sm px-6 py-20 text-center">
    <span class="accent-rule"></span>
    <p class="label mt-6 text-cream">{FINAL_CTA.label}</p>
    <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{FINAL_CTA.heading}</h2>
    <p class="mt-4 max-w-prose text-lg text-cream">{FINAL_CTA.body}</p>
    <div class="mt-9">
      <CtaButton href={FINAL_CTA.cta.href} variant="inverse">{FINAL_CTA.cta.label}</CtaButton>
    </div>
    <div class="mt-6">
      <FitCallMeta onInk />
    </div>
  </div>
</section>
