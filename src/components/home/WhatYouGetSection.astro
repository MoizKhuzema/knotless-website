---
/**
 * Section 01 — What you get.
 *
 * TWO STAGES, NOT A PARAGRAPH AND A FOOTNOTE.
 *
 * The copy is one engagement in two parts: what the Assessment finds, then what
 * gets built if the case is there. It used to be set as continuous prose with
 * the first paragraph a size up and the second dimmed — which forced a
 * hierarchy the content does not have. Measured, the first ran 2.45 times the
 * visual mass of the second (468px against 191px at 1440), so the second read
 * as a footnote to the first rather than its equal.
 *
 * They are now two columns of identical width, size, weight and colour. Equal
 * value stops being something the type asserts and becomes something the
 * geometry proves — and it costs no words, which matters because the copy is
 * fixed.
 *
 * It also closes the hole the old layout left. A sticky heading rail beside one
 * column of prose meant roughly 710px of empty left column at 1440, which reads
 * as unfinished rather than spacious. Full-width heading over two equal columns
 * has no second column to leave empty.
 *
 * THE VERTICALS are an index, not a menu: a row per vertical, its members set
 * beside the name rather than beneath it, so the row spans its width and the
 * short one does not look like a mistake.
 */
import { WHAT_YOU_GET } from '../../data/homepage';
---

<section class="wyg" id="what-you-get">
  <div class="shell">
    <div class="wyg__head" data-reveal>
      <p class="index meta r" style="--i: 0"><span>01</span></p>
      <h2 class="h-section wyg__h r" style="--i: 1">{WHAT_YOU_GET.heading}</h2>
    </div>

    {/* Two stages, side by side and identical. The rule above each is the
        thread again: a hairline with its first stretch in ember. */}
    <div class="wyg__stages" data-reveal>
      {
        WHAT_YOU_GET.body.map((para, i) => (
          <div class="stage r" style={`--i: ${i}`}>
            <span class="stage__rule" aria-hidden="true" />
            <p class="stage__p">{para}</p>
          </div>
        ))
      }
    </div>

    <div class="wyg__verticals" data-reveal>
      <p class="wyg__vlead r" style="--i: 0">{WHAT_YOU_GET.verticalsLead}</p>

      <ul class="vlist">
        {
          WHAT_YOU_GET.verticals.map((v, i) => (
            <li class="vlist__row r" style={`--i: ${i + 1}`}>
              <span class="vlist__n meta meta--num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="vlist__name">{v.name}</h3>
              <p class="vlist__members">
                {v.members.map((m, j) => (
                  <>
                    {j > 0 && <span class="vlist__sep" aria-hidden="true" />}
                    <span>{m}</span>
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .wyg {
    padding-top: var(--spacing-section-lg);
  }

  .wyg__h {
    margin: 1.25rem 0 0;
  }

  /* --- The two stages ------------------------------------------------- */

  .wyg__stages {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(3rem, 5vw, 4.5rem);
  }
  @media (min-width: 48rem) {
    .wyg__stages {
      /* Equal fractions, not auto: the two paragraphs differ in length by 173
         characters, and anything that sizes to content would hand the longer one
         more width and undo the point. */
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  .stage__rule {
    display: block;
    height: 1px;
    background-color: var(--color-line);
    margin-bottom: 1.75rem;
    /* The first stretch in ember — the thread surfacing, the same device as the
       strike and the section index, rather than a new kind of ornament. */
    background-image: linear-gradient(to right, var(--color-ember) 0 2.5rem, transparent 2.5rem);
  }

  .stage__p {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--color-cream);
    /* Both stages are cream. The second was --color-body-2 and a size down,
       which is what made it read as an aside. */
  }

  /* --- Verticals ----------------------------------------------------- */

  .wyg__verticals {
    margin-top: clamp(4.5rem, 8vw, 7.5rem);
  }

  /* Was --text-meta at 11px: smaller than the member lists it introduces, and
     the smallest text in the section. It is the sentence that frames the whole
     block, so it is set at 13px, in cream, with the tracking that marks it as a
     label rather than prose. */
  /* A sentence, so the sans — it was in the mono, which set "We specialise in
     two verticals" as though it were a readout. Tracking comes from the token
     now rather than a local 0.14em. */
  .wyg__vlead {
    margin: 0 0 1.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-cream);
  }

  .vlist {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .vlist__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem 1.5rem;
    padding: clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid var(--color-line);
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  @media (min-width: 48rem) {
    .vlist__row {
      /* Name and members side by side. Beneath the name, the two-member row
         left a large word over a short line and a lot of air; beside it, both
         rows span the full width and the short one reads as brevity rather
         than as something missing. */
      /* Wide enough that "Professional services" holds one line at 34px. It
         wrapped to "Professional / services" at 15rem, which reads as a break
         nobody chose. */
      grid-template-columns: auto minmax(0, 22rem) minmax(0, 1fr);
      align-items: baseline;
      gap: 0 clamp(1.5rem, 3vw, 3rem);
    }
  }

  .vlist__n {
    color: var(--color-ember);
  }

  /* Was 52px against the h2's 60px — 0.87x, so the vertical names competed with
     the section heading instead of sitting under it. At this scale the section
     reads 60 / 34 / 21 / 13 and the order is unambiguous. */
  .vlist__name {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    margin: 0;
    color: var(--color-cream);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .vlist__members {
    grid-column: 2;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    font-size: var(--text-sm);
    color: var(--color-cream-dim);
  }
  @media (min-width: 48rem) {
    .vlist__members {
      grid-column: 3;
    }
  }

  /* A hairline between members instead of commas — quieter, and it echoes the
     rules running through the rest of the page. */
  .vlist__sep {
    width: 1.25rem;
    height: 1px;
    background-color: var(--color-line);
  }

  /* Hovering one row lights it and dims its neighbour. Pointer-fine only: on
     touch there is no hover, and a permanently dimmed row would look broken. */
  @media (hover: hover) and (pointer: fine) {
    .vlist:hover .vlist__row {
      opacity: 0.4;
    }
    .vlist:hover .vlist__row:hover {
      opacity: 1;
    }
    .vlist__row:hover .vlist__name {
      color: var(--color-ember);
    }
  }
</style>
