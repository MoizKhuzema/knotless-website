---
/**
 * Section 01 — What you get.
 *
 * TWO STAGES, NOT A PARAGRAPH AND A FOOTNOTE.
 *
 * The copy is one engagement in two parts: what the Assessment finds, then what
 * gets built if the case is there. It used to be set as continuous prose with
 * the first paragraph a size up and the second dimmed — which forced a
 * hierarchy the content does not have. Measured, the first ran 2.45 times the
 * visual mass of the second (468px against 191px at 1440), so the second read
 * as a footnote to the first rather than its equal.
 *
 * They are now two columns of identical width, size, weight and colour. Equal
 * value stops being something the type asserts and becomes something the
 * geometry proves — and it costs no words, which matters because the copy is
 * fixed.
 *
 * It also closes the hole the old layout left. A sticky heading rail beside one
 * column of prose meant roughly 710px of empty left column at 1440, which reads
 * as unfinished rather than spacious. Full-width heading over two equal columns
 * has no second column to leave empty.
 *
 * THE STAGES sit in glass now rather than under a hairline each.
 *
 * THE VERTICALS are an index, not a menu: a row per vertical, its members set
 * beside the name rather than beneath it, so the row spans its width and the
 * short one does not look like a mistake.
 */
import { WHAT_YOU_GET } from '../../data/homepage';
import ArrowLink from '../ArrowLink.astro';
---

<section class="wyg" id="what-you-get">
  <div class="shell">
    <div class="wyg__head" data-reveal>
      <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <h2 class="h-section wyg__h r" style="--i: 1">{WHAT_YOU_GET.heading}</h2>
    </div>

    {/* Two stages in glass, read as a SEQUENCE rather than a pair. The number
        said they were ordered; nothing showed it. An ordered list carries the
        order in the markup, and the connector in the gap carries it for the
        eye. */}
    <ol class="wyg__stages" data-reveal>
      {
        WHAT_YOU_GET.stages.map((stage, i) => (
          <li class="stage r" data-catch="ring" style={`--i: ${i}`}>
            {/* A real element, not a pseudo: the card's ::before is spoken for
                by nothing and its ::after by the catch ring, and the connector
                has to register as a catcher in its own right to know how close
                the cursor is to IT rather than to the card. */}
            {i > 0 && <span class="stage__link" data-catch="line" aria-hidden="true" />}
            <p class="stage__n meta meta--num">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="stage__h">{stage.title}</h3>
            <span class="stage__rule" data-catch="line" aria-hidden="true" />
            <ul class="stage__list">
              {stage.points.map((point) => (
                <li class="stage__item">
                  <span class="stage__dot" data-catch="dot" aria-hidden="true" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="wyg__verticals" data-reveal>
      <h3 class="wyg__vlead r" style="--i: 0">{WHAT_YOU_GET.verticalsLead}</h3>

      <ul class="vlist">
        {
          WHAT_YOU_GET.verticals.map((v, i) => (
            <li class="vlist__row r" style={`--i: ${i + 1}`}>
              <span class="vlist__rule" data-catch="line" aria-hidden="true" />
              <span class="vlist__n meta meta--num">{String(i + 1).padStart(2, '0')}</span>
              <h4 class="vlist__name">{v.name}</h4>
              <p class="vlist__members">
                {v.members.map((m, j) => (
                  /* The stop travels WITH the member before it, inside one
                     flex item, so a wrap can only ever fall between members.
                     Loose in the flex row it could start a line — measured at
                     960px, where it pushed "marketing" 34px right of the line
                     above it. */
                  <span class="vlist__m">
                    <span>{m}</span>
                    {j < v.members.length - 1 && (
                      <span class="vlist__stop" data-catch="dot" aria-hidden="true" />
                    )}
                  </span>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
      <span class="vlist__rule vlist__rule--end r" data-catch="line" aria-hidden="true" style={`--i: ${WHAT_YOU_GET.verticals.length + 1}`} />
    </div>

    {/* Out to the page that sets the same engagement out in full, spaced so
        the section ends on something rather than just stopping. */}
    <div class="wyg__more" data-reveal>
      <div class="r">
        <ArrowLink href={WHAT_YOU_GET.readMore.href}>{WHAT_YOU_GET.readMore.label}</ArrowLink>
      </div>
    </div>
  </div>
</section>

<style>
  .wyg {
    padding-top: var(--spacing-section-lg);
  }

  .wyg__h {
    margin: 1.25rem 0 0;
  }

  /* --- The two stages ------------------------------------------------- */

  .wyg__stages {
    /* One name for the gap, because the connector has to span exactly it. Two
       copies of this number would drift the first time either changed. */
    --stage-gap: clamp(2.5rem, 5vw, 4rem);
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--stage-gap);
    /* Was clamp(3rem, 5vw, 4.5rem) — 72px at 1440, which read as a break
       between two sections rather than a heading over its own content. */
    margin-top: clamp(1.75rem, 2.6vw, 2.5rem);
  }
  @media (min-width: 48rem) {
    .wyg__stages {
      /* Equal fractions, not auto. Sizing to content would hand the stage with
         the longer bullets more width, and these are two steps of one
         engagement, not a comparison. */
      /* Exactly one grid cell. With an odd column count, a one-cell gap
         leaves (n-1)/2 whole cells per card — which is what puts all four
         card edges on grid lines. See body::before in global.css. */
      --stage-gap: var(--grid-cell);
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Each stage is a pane of glass rather than a paragraph under a rule.
   *
   * The same material as the nav capsule, a weight lighter. That bar floats
   * over the page and has to hold its own edge against whatever scrolls
   * beneath it; these sit IN the page and only have to catch the light, so the
   * fill is a third of the nav's and the edge a little over half. Read against
   * the ink ground the fill composites to a delta of 5 in 8 bits — present,
   * not visible as a shape.
   *
   * No drop shadow, deliberately. A shadow is what makes the nav read as
   * floating, and two panes floating in the middle of a page would pull the
   * eye off the reading. The edge and the specular line do the whole job.
   *
   * The blur is what earns the word glass: the parallax grid and the cursor
   * light pass behind these and come through softened, so the pane reads as a
   * material with something behind it rather than as a tinted rectangle. */
  .stage {
    position: relative;
    /* Was clamp(1.5rem, 2.6vw, 2.25rem) — 36px at 1440, against a 16px type
       size. Tightened so the pane is a frame around the content rather than a
       margin with content in it. */
    padding: clamp(1.25rem, 2vw, 1.5rem);
    border-radius: var(--radius-lg);
    background-color: var(--color-glass-soft);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--color-glass-soft-edge);
    box-shadow: inset 0 1px 0 var(--color-glass-soft-spec);
  }

  /* The connector. What makes two boxes read as a sequence rather than a pair
   * is a line drawn between them, and it has to live in the GAP — a border on
   * either card would read as decoration on that card.
   *
   * It is drawn from the second stage backwards, not from the first forwards,
   * so a third stage would connect itself without touching anything else.
   *
   * Neutral, not ember. Orange is reserved for the ordinals and the call to
   * action; a connector is structure, and structure is a hairline.
   *
   * Stacked, it runs down from the card above, aligned to the left padding so
   * it lands under the ordinal. Side by side it runs across the gap at the
   * cards' shared middle — which only holds because they are equal-height grid
   * items. */
  /* The connector, terminated.
   *
   * As a bare 1px hairline it was indistinguishable from the background — the
   * gap is exactly one grid cell, so the thing crossing it looked like the
   * grid's own line crossing it. A node at each end is what says a human put
   * it there: it is the page's schematic vocabulary, it marks the two things
   * being joined, and the grid has nothing like it.
   *
   * Drawn entirely as backgrounds in currentColor, and the pattern, sizes and
   * positions are custom properties, so the catch glow can repaint the exact
   * same figure in ember. A solid fill for the glow would have lit a rectangle
   * where the mark is a line with two dots. Same device as .rule-thread. */
  .stage__link {
    --link-img:
      linear-gradient(currentColor 0 100%),
      radial-gradient(circle, currentColor 3px, transparent 3.25px),
      radial-gradient(circle, currentColor 3px, transparent 3.25px);
    /* Stacked: a vertical line with a node top and bottom. */
    --link-size: 2px 100%, 7px 7px, 7px 7px;
    --link-pos: 2.5px 0, center top, center bottom;
    position: absolute;
    left: calc(clamp(1.25rem, 2vw, 1.5rem) - 2.5px);
    top: calc(-1 * var(--stage-gap));
    width: 7px;
    height: var(--stage-gap);
    /* --color-wire, not --color-line. The hairline token is the faintest mark
       the system has — a delta of 25 in 8 bits against the ground — and at 1px
       it was disappearing. --color-wire is 63, and it is the token literally
       named for this: "inert diagram: the manual process". A connector between
       two stages of an engagement is a diagram wire. The line doubles to 2px
       and the nodes go 4px to 6px on top of that. */
    color: var(--color-wire);
    background-image: var(--link-img);
    background-size: var(--link-size);
    background-position: var(--link-pos);
    background-repeat: no-repeat;
  }
  @media (min-width: 48rem) {
    .stage__link {
      /* Side by side: the same figure turned through ninety degrees. */
      --link-size: 100% 2px, 7px 7px, 7px 7px;
      --link-pos: 0 2.5px, left center, right center;
      left: calc(-1 * var(--stage-gap) - 1px);
      top: calc(50% - 3.5px);
      width: var(--stage-gap);
      height: 7px;
    }
  }
  /* More specific than the generic line variant, which paints a solid fill. */
  .stage__link[data-catch]::after {
    color: var(--catch-lit);
    background-color: transparent;
    background-image: var(--link-img);
    background-size: var(--link-size);
    background-position: var(--link-pos);
    background-repeat: no-repeat;
  }

  /* Ember mono, the same numbering idiom as the verticals list below, so the
     page has one way of writing an ordinal rather than two. */
  .stage__n {
    margin: 0 0 1rem;
    color: var(--color-accent-type);
  }

  /* The stage's name. It sits under the ordinal and over the list, so it is
     the only thing in the pane that has to carry weight — but it is a third
     level heading inside a section, not a rival to the section's own. */
  .stage__h {
    margin: 0.35rem 0 1.1rem;
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    color: var(--color-cream);
  }

  /* Deliverables, so a list. As prose the reader had to extract the list
     themselves; this is the same content with the extraction already done.
     Hairline rules between items rather than bullet glyphs — the page already
     separates things with rules everywhere else, and a disc would be a new
     kind of mark for no gain. */
  .stage__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* 16px, not the page's 18px, and cream-dim rather than cream. A card is a
     denser context than running text: at body size and full strength the four
     points competed with the stage's own name, and the pane read as a wall.
     Cream-dim on the pane measures 6.94:1 — comfortably past AA, so the step
     down is hierarchy, not a concession. */
  /* The card's one rule, as an ELEMENT rather than the heading's border. A
     border cannot catch the light — the catch system paints into ::after, and
     the heading's belongs to the heading. As its own element it registers as a
     catcher and gets the line variant for free.

     It is still the only division in the card: name above, deliverables
     below. */
  .stage__rule {
    display: block;
    height: 1px;
    background-color: var(--color-line);
  }

  .stage__list {
    margin-top: 1.1rem;
  }
  .stage__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0 0.75rem;
    padding: 0.5rem 0;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-cream-dim);
    /* balance, not pretty. "in order", "shown" and "applicable law" were each
       wrapping alone onto a last line; pretty cleared that at 390, 768 and
       1024 but left two of them at 1440 and 1920, where it only rebalances the
       tail of a paragraph and these are two lines long. balance splits the
       lines evenly instead: measured, the worst last line goes from 14% of the
       full measure to 80%, and there are no widows at any width.

       The other lever — narrowing the card padding to widen the measure —
       was tried and rejected on evidence, not taste: swept from 2.25rem down
       to 1.25rem, a widow survived every value. These strings are longer than
       any measure the card can offer, so the fix has to be in how the lines
       are split, not how much room they get.

       Every item here is two or three lines, well inside the line count a
       balanced block is allowed. Engines without it fall back to normal
       wrapping, which is what shipped before. */
    text-wrap: balance;
  }

  /* The marker. Glass, like the pane it sits in, at the smallest weight the
     material has — a bead rather than a disc. It replaces a list-style glyph,
     so it carries no meaning a screen reader needs: the <ul> already says
     these are items. */
  .stage__dot {
    /* Optical centring on the first line rather than the box: half the line
       box, less half the dot, less a hair for the cap height. */
    margin-top: calc((1.55em - 0.5rem) / 2 - 0.04em);
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-glass-soft);
    border: 1px solid var(--color-glass-soft-edge);
    box-shadow: inset 0 1px 0 var(--color-glass-soft-spec);
    backdrop-filter: blur(6px) saturate(140%);
    -webkit-backdrop-filter: blur(6px) saturate(140%);
  }

  .wyg__more {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  /* --- Verticals ----------------------------------------------------- */

  .wyg__verticals {
    margin-top: clamp(4.5rem, 8vw, 7.5rem);
  }

  /* The subheading, at last. It introduces the block, so it was set as a 13px
     uppercase label — smaller than the two names under it and smaller than the
     member lists. The hierarchy ran backwards: two entries in a list were
     carrying more weight than the sentence that framed them.
     
     It takes the size the names had, 24 to 34px, and drops the uppercase and
     the label tracking with it — a heading is read, not scanned. The section
     now runs 60 / 34 / 21 / 13 from its heading down, in that order. */
  .wyg__vlead {
    margin: 0 0 2rem;
    font-size: clamp(1.5rem, 1rem + 1.4vw, 2.125rem);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    color: var(--color-cream);
  }

  .vlist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The three rules are ELEMENTS, not the list's and the rows' borders. A
     border cannot be lit — the catch system paints into ::after, and a row's
     ::after belongs to the row. As elements they register as catchers and take
     the line variant with nothing new. One at the top of each row, one closing
     the list. */
  .vlist__rule {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--color-line);
  }
  .vlist__rule--end {
    position: static;
    display: block;
  }

  .vlist__row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem 1.5rem;
    padding: clamp(1.75rem, 3vw, 2.5rem) 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  @media (min-width: 48rem) {
    .vlist__row {
      /* Name and members side by side. Beneath the name, the two-member row
         left a large word over a short line and a lot of air; beside it, both
         rows span the full width and the short one reads as brevity rather
         than as something missing. */
      /* Wide enough that "Professional services" holds one line at 34px. It
         wrapped to "Professional / services" at 15rem, which reads as a break
         nobody chose. */
      grid-template-columns: auto minmax(0, 22rem) minmax(0, 1fr);
      align-items: baseline;
      gap: 0 clamp(1.5rem, 3vw, 3rem);
    }
  }

  .vlist__n {
    color: var(--color-accent-type);
  }

  /* Was 52px against the h2's 60px — 0.87x, so the vertical names competed with
     the section heading instead of sitting under it. At this scale the section
     reads 60 / 34 / 21 / 13 and the order is unambiguous. */
  .vlist__name {
    font-family: var(--font-display, inherit);
    /* Two entries in a list, not a display line. They were at the subheading's
       size and the subheading was at a label's; this is the swap. */
    font-size: var(--text-lg);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    margin: 0;
    color: var(--color-cream);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .vlist__members {
    grid-column: 2;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* The column gap matches the gap inside .vlist__m, so the stop sits the
       same distance from the word before it as from the word after. */
    gap: 0.4rem 0.55rem;
    font-size: var(--text-sm);
    color: var(--color-cream-dim);
  }
  .vlist__m {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  @media (min-width: 48rem) {
    .vlist__members {
      grid-column: 3;
    }
  }

  /* A full stop between members, not a dash. The 1.25rem hairline read as a
     rule — the same mark the section uses for structure — doing punctuation's
     job, and at that length it separated the words more than it joined them.

     Glass, like the beads in the cards above, at 5px rather than 8: the same
     material, sized as punctuation rather than as a marker. */
  /* A stop that has landed at the end of a wrapped line is not between two
     things, so it is not punctuation — it is a dangling mark. Which item ends
     a line is a fact only the layout knows, and it changes with the width, so
     the script below measures it and marks the item.

     visibility, NOT display. Removing the box would give the line back ~14px,
     which can be enough for the next member to fit — and then the item is no
     longer at the end of a line, the mark comes back, the line overflows
     again, and it oscillates. Keeping the box means the measurement stays true
     after the mark is hidden. */
  .vlist__m[data-eol] .vlist__stop {
    visibility: hidden;
  }

  .vlist__stop {
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background-color: var(--color-glass-lift);
    border: 1px solid var(--color-glass-soft-edge);
    backdrop-filter: blur(4px) saturate(140%);
    -webkit-backdrop-filter: blur(4px) saturate(140%);
  }

  /* Hovering one row lights it and dims its neighbour. Pointer-fine only: on
     touch there is no hover, and a permanently dimmed row would look broken. */
  @media (hover: hover) and (pointer: fine) {
    .vlist:hover .vlist__row {
      opacity: 0.4;
    }
    .vlist:hover .vlist__row:hover {
      opacity: 1;
    }
    .vlist__row:hover .vlist__name {
      color: var(--color-accent-type);
    }
  }
</style>

<script>
  /* Hide the stop on any member that ends a wrapped line.
   *
   * The stop is bound to the member before it so that a wrap can never start a
   * line with a mark — but that puts one at the END of a line whenever the
   * break falls there, which is not between two things and so is not
   * punctuation.
   *
   * No CSS can express this: where a line breaks is known only after layout.
   * So it is measured — but on resize, not per frame, and the only thing
   * written is a visibility toggle, which cannot itself change the layout that
   * produced it.
   *
   * ResizeObserver rather than a window resize listener: it catches the list's
   * box changing for any reason, including a font swapping in and reflowing
   * the words, which a width listener would miss. */
  (() => {
    const lists = [...document.querySelectorAll('.vlist__members')];
    if (!lists.length) return;

    const sync = () => {
      for (const list of lists) {
        const items = [...list.children];
        /* Read every top first, then write. Interleaving them would make each
           write invalidate the next read. */
        const tops = items.map((el) => el.getBoundingClientRect().top);
        for (let i = 0; i < items.length; i++) {
          // Ends a line when there is a next member and it sits lower.
          const eol = i + 1 < items.length && tops[i + 1] - tops[i] > 1;
          if (items[i].hasAttribute('data-eol') !== eol) {
            items[i].toggleAttribute('data-eol', eol);
          }
        }
      }
    };

    sync();
    /* Metrics change when the real face replaces the fallback, and the wrap
       points move with them. */
    document.fonts?.ready.then(sync);

    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(sync);
      lists.forEach((l) => ro.observe(l));
    } else {
      addEventListener('resize', sync, { passive: true });
    }
  })();
</script>
