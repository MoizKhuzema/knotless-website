---
/**
 * Section 01 — What you get.
 *
 * TWO STAGES, NOT A PARAGRAPH AND A FOOTNOTE.
 *
 * The copy is one engagement in two parts: what the Assessment finds, then what
 * gets built if the case is there. It used to be set as continuous prose with
 * the first paragraph a size up and the second dimmed — which forced a
 * hierarchy the content does not have. Measured, the first ran 2.45 times the
 * visual mass of the second (468px against 191px at 1440), so the second read
 * as a footnote to the first rather than its equal.
 *
 * They are now two columns of identical width, size, weight and colour. Equal
 * value stops being something the type asserts and becomes something the
 * geometry proves — and it costs no words, which matters because the copy is
 * fixed.
 *
 * It also closes the hole the old layout left. A sticky heading rail beside one
 * column of prose meant roughly 710px of empty left column at 1440, which reads
 * as unfinished rather than spacious. Full-width heading over two equal columns
 * has no second column to leave empty.
 *
 * THE STAGES sit in glass now rather than under a hairline each.
 *
 * THE VERTICALS have left this file. They were never "what you get" — they are
 * who the work is for — and they now have their own section, which is also
 * where the argument for having only two of them lives.
 */
import { WHAT_YOU_GET } from '../../data/homepage';
---

<section class="wyg" id="what-you-get">
  <div class="shell">
    <div class="wyg__head" data-reveal>
      <h2 class="h-section wyg__h r" style="--i: 1">{WHAT_YOU_GET.heading}</h2>
    </div>

    {/* Two stages in glass, read as a SEQUENCE rather than a pair. The number
        said they were ordered; nothing showed it. An ordered list carries the
        order in the markup, and the connector in the gap carries it for the
        eye. */}
    <ol class="wyg__stages" data-reveal>
      {
        WHAT_YOU_GET.stages.map((stage, i) => (
          <li class="stage r" data-lamp-card style={`--i: ${i}`}>
            {/* A real element, not a pseudo: the card's ::before is spoken for
                by nothing and its ::after by the catch ring, and the connector
                has to register as a catcher in its own right to know how close
                the cursor is to IT rather than to the card. */}
            {/* Outside .pl-inner deliberately: the connector lives in the GAP
                between the cards, not on either of them, so it must not dim
                and brighten with the card's own light. */}
            {i > 0 && <span class="stage__link" aria-hidden="true" />}

            {/* The picture light. Ordered back to front: the wash it throws
                down the pane, the hot line where the pane's top edge catches
                it, then the fitting itself standing above the card. */}
            <div class="pl-wash" aria-hidden="true" />
            <div class="pl-edge" aria-hidden="true" />
            <div class="pl-lamp" aria-hidden="true">
              <div class="pl-spill" />
              <div class="pl-stem" />
              <div class="pl-plate" />
              <div class="pl-bar"><i class="pl-band" /></div>
            </div>

            <div class="pl-inner">
              <p class="stage__n meta meta--num">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="stage__h">{stage.title}</h3>
              <span class="stage__rule" aria-hidden="true" />
              <ul class="stage__list">
                {stage.points.map((point) => (
                  <li class="stage__item">
                    <span class="stage__dot" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

  </div>
</section>

<style>
  .wyg {
    /* Short of the section rhythm by the same 40px the stage list is long by,
       which is how the HEADING moves up without the cards moving at all: the
       section still starts where it always did, the heading sits 40px nearer
       its top, and the list gives the distance straight back. The lamps, and
       everything below them, stay exactly where they were. */
    padding-top: calc(var(--spacing-section-lg) - 40px);
    /* The black run-out to the next section. These two sections fill their
       screen almost to the edge — 89px of slack here against the hero's 214 —
       so without it the next heading arrives while the cards are still in the
       eye. Sized so the run matches the hero's. */
    padding-bottom: 14.5rem;
  }
  /* Shorter below the desktop layout. The run is sized against a desktop
     screen; on a phone the same distance is most of a viewport of nothing. */
  @media (max-width: 1099px) {
    .wyg {
      padding-bottom: 9rem;
    }
  }

  .wyg__h {
    margin: 1.25rem 0 0;
  }

  /* --- The two stages ------------------------------------------------- */

  .wyg__stages {
    /* One name for the gap, because the connector has to span exactly it. Two
       copies of this number would drift the first time either changed. */
    /* 4rem, not clamp(2.5rem, …): stacked, the gap is also the headroom the
       lower card's light fitting stands in, and that fitting is 30px tall. At
       the clamp's floor the lamp would have crossed into the card above it. */
    --stage-gap: 4rem;
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--stage-gap);
    /* This is the heading's clearance, and what it has to clear is the LAMP,
       not the card: the fitting stands 30px proud of the card's top edge, so
       48px of margin left only 19px of daylight under the heading — and the
       heading is serif, so its descenders spend some of that. Measured the
       same on every width, desktop included. With the 40px the section's own
       padding gives up above, 128px stacked and 120px side by side put ~90px
       of air under the type — about one cap height of the heading, which is
       what an opening line of this size wants under it. */
    margin-top: 8rem;
  }
  @media (min-width: 48rem) {
    .wyg__stages {
      /* Equal fractions, not auto. Sizing to content would hand the stage with
         the longer bullets more width, and these are two steps of one
         engagement, not a comparison. */
      /* Exactly one grid cell. With an odd column count, a one-cell gap
         leaves (n-1)/2 whole cells per card — which is what puts all four
         card edges on grid lines. See body::before in global.css. */
      --stage-gap: var(--grid-cell);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 7.5rem;
    }
  }

  /* Each stage is a pane of glass rather than a paragraph under a rule.
   *
   * The same material as the nav capsule, a weight lighter. That bar floats
   * over the page and has to hold its own edge against whatever scrolls
   * beneath it; these sit IN the page and only have to catch the light, so the
   * fill is a third of the nav's and the edge a little over half. Read against
   * the ink ground the fill composites to a delta of 5 in 8 bits — present,
   * not visible as a shape.
   *
   * No drop shadow, deliberately. A shadow is what makes the nav read as
   * floating, and two panes floating in the middle of a page would pull the
   * eye off the reading. The edge and the specular line do the whole job.
   *
   * The blur is what earns the word glass: the parallax grid and the cursor
   * light pass behind these and come through softened, so the pane reads as a
   * material with something behind it rather than as a tinted rectangle. */
  /* A flex column so the list below can take the slack.
   *
   * The two stages no longer hold the same number of deliverables — seven
   * against eight — and the cards are equal-height grid items, so the shorter
   * list left 112px of empty pane under it at 1440. That gap is not
   * breathing room, it reads as content that failed to load.
   *
   * Equal height is NOT the thing to give up to fix it: the connector between
   * the two cards is positioned at 50% and crosses the gutter horizontally,
   * which is only true while both cards are the same height. Letting them size
   * to content would put the line into the side of the taller card.
   *
   * So the height stays and the LIST absorbs the difference. */
  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    /* Was clamp(1.5rem, 2.6vw, 2.25rem) — 36px at 1440, against a 16px type
       size. Tightened so the pane is a frame around the content rather than a
       margin with content in it. */
    padding: clamp(1.25rem, 2vw, 1.5rem);
    border-radius: var(--radius-lg);
    background-color: var(--color-glass-soft);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--color-glass-soft-edge);
    box-shadow: inset 0 1px 0 var(--color-glass-soft-spec);
  }

  /* The connector. What makes two boxes read as a sequence rather than a pair
   * is a line drawn between them, and it has to live in the GAP — a border on
   * either card would read as decoration on that card.
   *
   * It is drawn from the second stage backwards, not from the first forwards,
   * so a third stage would connect itself without touching anything else.
   *
   * Neutral, not ember. Orange is reserved for the ordinals and the call to
   * action; a connector is structure, and structure is a hairline.
   *
   * Stacked, it runs down from the card above, aligned to the left padding so
   * it lands under the ordinal. Side by side it runs across the gap at the
   * cards' shared middle — which only holds because they are equal-height grid
   * items. */
  /* The connector, terminated.
   *
   * As a bare 1px hairline it was indistinguishable from the background — the
   * gap is exactly one grid cell, so the thing crossing it looked like the
   * grid's own line crossing it. A node at each end is what says a human put
   * it there: it is the page's schematic vocabulary, it marks the two things
   * being joined, and the grid has nothing like it.
   *
   * Drawn entirely as backgrounds in currentColor, and the pattern, sizes and
   * positions are custom properties, so the catch glow can repaint the exact
   * same figure in ember. A solid fill for the glow would have lit a rectangle
   * where the mark is a line with two dots. Same device as .rule-thread. */
  .stage__link {
    --link-img:
      linear-gradient(currentColor 0 100%),
      radial-gradient(circle, currentColor 3px, transparent 3.25px),
      radial-gradient(circle, currentColor 3px, transparent 3.25px);
    /* Stacked: a vertical line with a node top and bottom. */
    --link-size: 2px 100%, 7px 7px, 7px 7px;
    --link-pos: 2.5px 0, center top, center bottom;
    position: absolute;
    left: calc(clamp(1.25rem, 2vw, 1.5rem) - 2.5px);
    top: calc(-1 * var(--stage-gap));
    width: 7px;
    height: var(--stage-gap);
    /* --color-wire, not --color-line. The hairline token is the faintest mark
       the system has — a delta of 25 in 8 bits against the ground — and at 1px
       it was disappearing. --color-wire is 63, and it is the token literally
       named for this: "inert diagram: the manual process". A connector between
       two stages of an engagement is a diagram wire. The line doubles to 2px
       and the nodes go 4px to 6px on top of that. */
    color: var(--color-wire);
    background-image: var(--link-img);
    background-size: var(--link-size);
    background-position: var(--link-pos);
    background-repeat: no-repeat;
  }
  @media (min-width: 48rem) {
    .stage__link {
      /* Side by side: the same figure turned through ninety degrees. */
      --link-size: 100% 2px, 7px 7px, 7px 7px;
      --link-pos: 0 2.5px, left center, right center;
      left: calc(-1 * var(--stage-gap) - 1px);
      top: calc(50% - 3.5px);
      width: var(--stage-gap);
      height: 7px;
    }
  }
  /* More specific than the generic line variant, which paints a solid fill. */

  /* Ember mono, the same numbering idiom as the verticals list below, so the
     page has one way of writing an ordinal rather than two. */
  .stage__n {
    margin: 0 0 1rem;
    color: var(--color-accent-type);
  }

  /* The stage's name. It sits under the ordinal and over the list, so it is
     the only thing in the pane that has to carry weight — but it is a third
     level heading inside a section, not a rival to the section's own. */
  .stage__h {
    margin: 0.35rem 0 1.1rem;
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
    font-weight: 600;
    color: var(--color-cream);
  }

  /* Deliverables, so a list. As prose the reader had to extract the list
     themselves; this is the same content with the extraction already done.
     Hairline rules between items rather than bullet glyphs — the page already
     separates things with rules everywhere else, and a disc would be a new
     kind of mark for no gain. */
  .stage__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* 16px, not the page's 18px, and cream-dim rather than cream. A card is a
     denser context than running text: at body size and full strength the four
     points competed with the stage's own name, and the pane read as a wall.
     Cream-dim on the pane measures 6.94:1 — comfortably past AA, so the step
     down is hierarchy, not a concession. */
  /* The card's one rule, as an ELEMENT rather than the heading's border. A
     border cannot catch the light — the catch system paints into ::after, and
     the heading's belongs to the heading. As its own element it registers as a
     catcher and gets the line variant for free.

     It is still the only division in the card: name above, deliverables
     below. */
  .stage__rule {
    display: block;
    position: relative;
    height: 1px;
    background-color: var(--color-line);
  }
  /* The rule catches the lamp, like the pane's top edge does. It is the one
     drawn line inside the card, so leaving it at its unlit grey while warm
     light pours over everything around it made it read as a scratch on the
     glass rather than as part of the card. Gated on --pour as well as --v, so
     it comes up when the light actually reaches down to it rather than the
     instant the lamp catches. */
  .stage__rule::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: calc(var(--v) * var(--pour));
    background: linear-gradient(90deg, transparent, rgba(255, 226, 190, 0.85), transparent);
  }

  /* The slack, absorbed. The list takes the leftover height and spreads its
     items through it, so the shorter list sets slightly airier than the longer
     one instead of stopping early and leaving a hole.

     A difference in rhythm between two cards is far less visible than a hole
     in one of them: nobody compares the leading of two lists across a 40px
     gutter, and everybody sees 112px of empty pane. */
  .stage__list {
    margin-top: 1.1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .stage__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0 0.75rem;
    padding: 0.5rem 0;
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-cream-dim);
    /* balance, not pretty. "in order", "shown" and "applicable law" were each
       wrapping alone onto a last line; pretty cleared that at 390, 768 and
       1024 but left two of them at 1440 and 1920, where it only rebalances the
       tail of a paragraph and these are two lines long. balance splits the
       lines evenly instead: measured, the worst last line goes from 14% of the
       full measure to 80%, and there are no widows at any width.

       The other lever — narrowing the card padding to widen the measure —
       was tried and rejected on evidence, not taste: swept from 2.25rem down
       to 1.25rem, a widow survived every value. These strings are longer than
       any measure the card can offer, so the fix has to be in how the lines
       are split, not how much room they get.

       Every item here is two or three lines, well inside the line count a
       balanced block is allowed. Engines without it fall back to normal
       wrapping, which is what shipped before. */
    text-wrap: balance;
  }

  /* The marker. Glass, like the pane it sits in, at the smallest weight the
     material has — a bead rather than a disc. It replaces a list-style glyph,
     so it carries no meaning a screen reader needs: the <ul> already says
     these are items. */
  .stage__dot {
    /* Optical centring on the first line rather than the box: half the line
       box, less half the dot, less a hair for the cap height. */
    margin-top: calc((1.55em - 0.5rem) / 2 - 0.04em);
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-glass-soft);
    border: 1px solid var(--color-glass-soft-edge);
    box-shadow: inset 0 1px 0 var(--color-glass-soft-spec);
  }


  /* --- Gallery picture lights ------------------------------------------
   *
   * A slim fitting mounted on each card's top edge that switches on as the
   * card arrives, pours warm light down the pane and stays on.
   *
   * --v is how far the lamp is switched on (0..1) and --pour is how far the
   * light has run down the card (0..1). Both default to 1 on the card itself,
   * so with no JS, a thrown error, or reduced motion the section is simply
   * lit; the script opts IN to darkness by putting .js-lights on the section
   * before it measures anything. A reveal that hides content unless a script
   * rescues it is a reveal that eventually eats the content.
   *
   * The card keeps its glass. The brief's sample sets an opaque fill to hold
   * text contrast, but the wash is a layer INSIDE the pane and composites over
   * whatever the pane's own background is, so opacity buys nothing here and
   * would cost the backdrop blur this section was built around. */
  .stage {
    --v: 1;
    --pour: 1;
  }
  .js-lights .stage {
    --v: 0;
    --pour: 0;
  }

  .pl-inner {
    position: relative;
    z-index: 1;
    /* Never below half: the copy dims as the lamp comes up, it does not
       arrive with it. */
    opacity: calc(0.5 + 0.5 * var(--v));
  }

  /* The wash. clip-path is what makes the light POUR rather than fade: the
     layer is fully drawn from the start and revealed top down, so the leading
     edge travels the pane instead of the whole pane brightening at once. */
  .pl-wash {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: var(--v);
    clip-path: inset(0 0 calc((1 - var(--pour)) * 100%) 0 round var(--radius-lg));
    background:
      radial-gradient(ellipse 70% 38% at 50% 0%, rgba(255, 226, 188, 0.35), rgba(255, 220, 180, 0.105) 60%, transparent 80%),
      linear-gradient(to bottom, rgba(255, 232, 204, 0.118), rgba(255, 232, 204, 0.033) 50%, transparent 78%);
  }
  /* Side by side the cards are wider and shorter, so the pool has to be
     squatter or it runs off the sides before it reaches the copy. The class is
     set from the measured layout, never from a width. */
  .is-row .pl-wash {
    background:
      radial-gradient(ellipse 62% 48% at 50% 0%, rgba(255, 226, 188, 0.35), rgba(255, 220, 180, 0.105) 60%, transparent 80%),
      linear-gradient(to bottom, rgba(255, 232, 204, 0.118), rgba(255, 232, 204, 0.033) 50%, transparent 78%);
  }

  /* The pane's top edge catching the light. */
  .pl-edge {
    position: absolute;
    left: 10%;
    right: 10%;
    top: -1px;
    height: 1px;
    pointer-events: none;
    opacity: var(--v);
    background: linear-gradient(90deg, transparent, rgba(255, 226, 190, 0.95), transparent);
  }

  /* The fitting. Same two colours as the torch: the cream stroke and the one
     ember accent, so it reads as another object from the same drawing. */
  .pl-lamp {
    position: absolute;
    left: 50%;
    top: -30px;
    width: 56%;
    height: 30px;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .pl-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 9px;
    border-radius: 5px;
    background: #0b0908;
    border: 1.6px solid var(--color-cream, #efe8dc);
    box-sizing: border-box;
  }
  .pl-bar::after {
    content: '';
    position: absolute;
    left: 9%;
    right: 9%;
    bottom: -1.6px;
    height: 2px;
    border-radius: 2px;
    background: #fff1dc;
    opacity: var(--v);
    box-shadow: 0 2px 14px 4px rgba(255, 220, 180, calc(var(--v) * 0.85));
  }
  .pl-band {
    position: absolute;
    left: 7%;
    top: 2px;
    width: 6px;
    height: 2px;
    background: var(--color-ember, #c65a31);
  }
  .pl-stem {
    position: absolute;
    left: 50%;
    top: 9px;
    width: 1.6px;
    height: 17px;
    margin-left: -0.8px;
    background: var(--color-cream, #efe8dc);
  }
  .pl-plate {
    position: absolute;
    left: 50%;
    top: 25px;
    width: 26px;
    height: 5px;
    margin-left: -13px;
    border-radius: 1px;
    background: #0b0908;
    border: 1.6px solid var(--color-cream, #efe8dc);
    box-sizing: border-box;
  }
  .pl-spill {
    position: absolute;
    left: -8%;
    right: -8%;
    top: 7px;
    height: 40px;
    opacity: calc(var(--v) * 0.95);
    background: radial-gradient(ellipse 50% 60% at 50% 0%, rgba(255, 224, 186, 0.38), transparent 70%);
  }

  @media (prefers-reduced-motion: reduce) {
    /* Belt and braces: the script already declines to add .js-lights, but if
       the preference changes after load nothing should be left dark. */
    .js-lights .stage {
      --v: 1;
      --pour: 1;
    }
  }

  /* Tablet and phone close the two gaps around Industries.
   *
   * min-height: 0 is the load-bearing half. `main section { min-height: 100svh }`
   * gives every section a viewport floor so its light has a screen to itself;
   * below the desktop layout these two finish well short of that, so the floor
   * was padding them out with black nobody asked for. The padding-bottom is
   * then the run-out, sized for the shorter screen.
   *
   * Only these two. The hero stretch, the torch stage and the closing gap are
   * doing real work and are left alone. */
  @media (max-width: 1023px) {
    .wyg {
      min-height: 0;
      padding-bottom: 64px;
    }
  }
  @media (max-width: 767px) {
    .wyg {
      padding-bottom: 40px;
      /* Phones only: the approach to this heading is the longest black run on
         the page, because what precedes it is a pinned screen releasing into
         it. The section rhythm is a desktop measure; here it is a thumb. */
      padding-top: 24px;
    }
  }
</style>

<script>
  /* The picture lights.
   *
   * WHICH MODE IS A QUESTION ABOUT LAYOUT, SO IT IS ASKED OF THE LAYOUT.
   * Two cards on one row want one light following the other along the row;
   * stacked, each wants its own light as it arrives. A width breakpoint only
   * guesses at which of those is on screen — it would be wrong the moment the
   * grid's breakpoint, the copy or the font changed. Comparing the two cards'
   * offsetTop asks the thing itself.
   */
  function pictureLights(section: HTMLElement) {
    const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-lamp-card]'));
    const list = section.querySelector<HTMLElement>('.wyg__stages');
    if (cards.length < 2 || !list) return;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    /* Reduced motion never goes dark in the first place, so there is nothing
       to switch on and no loop to run. */
    if (reduce.matches) return;
    section.classList.add('js-lights');

    const clamp = (x: number) => Math.max(0, Math.min(1, x));
    const easeOutCubic = (x: number) => 1 - Math.pow(1 - x, 3);

    const lit = cards.map(() => false);
    const start = cards.map(() => 0);
    let raf = 0;
    let rowMode = false;
    /* on: the section is in view and the lamps belong lit.
       gate: the fade that takes them out when it is not. Kept apart from each
       card's own switch-on so leaving mid-flicker cannot strand a card. */
    let on = false;
    let gate = 1;
    let offAt = -1;
    let stagger: ReturnType<typeof setTimeout> | undefined;

    const measure = () => {
      rowMode = Math.abs(cards[0].offsetTop - cards[1].offsetTop) < 4;
      section.classList.toggle('is-row', rowMode);
    };

    /* The switch itself: a filament catching, not a fade. */
    const vAt = (dt: number) => {
      if (dt < 45) return 0.9;
      if (dt < 90) return 0.1;
      if (dt < 135) return 0.75;
      if (dt < 180) return 0.3;
      return 0.7 + 0.3 * clamp((dt - 180) / 220);
    };
    const pourAt = (dt: number) => easeOutCubic(clamp((dt - 120) / 700));

    const frame = (now: number) => {
      if (offAt >= 0) {
        /* Going out. Everything dims together rather than each lamp running
           its own switch-off, because they are one fitting from the reader's
           side and a staggered fade would read as a fault. */
        gate = 1 - Math.min(1, (now - offAt) / 320);
        paintCards(now);
        if (gate <= 0) {
          gate = 0;
          paintCards(now);
          raf = 0;
          offAt = -1;
          return;
        }
        raf = requestAnimationFrame(frame);
        return;
      }
      let busy = false;
      busy = paintCards(now);
      raf = busy ? requestAnimationFrame(frame) : 0;
    };

    function paintCards(now: number) {
      let busy = false;
      for (let i = 0; i < cards.length; i++) {
        if (!lit[i]) continue;
        if (start[i] === 0) {
          /* Lit without a timer — switched on instantly because the page
             loaded already scrolled past. It still has to follow the gate out,
             and skipping it here is why leaving the section downwards left
             both lamps burning. */
          cards[i].style.setProperty('--v', gate.toFixed(3));
          cards[i].style.setProperty('--pour', '1');
          continue;
        }
        const dt = now - start[i];
        const v = vAt(dt);
        const pour = pourAt(dt);
        cards[i].style.setProperty('--v', (v * gate).toFixed(3));
        cards[i].style.setProperty('--pour', pour.toFixed(3));
        if (v < 1 || pour < 1) busy = true;
      }
      return busy;
    }

    /* instant: the trigger line was already behind us when the page loaded —
       an anchor, a refresh partway down, the back button. A lamp that flickers
       on for something the reader has already scrolled to reads as a glitch. */
    const switchOn = (i: number, instant: boolean) => {
      if (lit[i]) return;
      lit[i] = true;
      if (instant) {
        cards[i].style.setProperty('--v', gate.toFixed(3));
        cards[i].style.setProperty('--pour', '1');
        return;
      }
      start[i] = performance.now();
      if (!raf) raf = requestAnimationFrame(frame);
    };

    /* booted is false only for the very first evaluation after load. Hanging
       the instant path off "the first time this section is entered" instead
       meant the first real arrival — scrolling down to it — skipped the
       flicker entirely, which is the one time it most wants to play. */
    let booted = false;
    const check = () => {
      if (!on) return;
      const instant = !booted;
      if (rowMode) {
        /* One row, one event: the first lamp catches, the second follows a
           beat later, the way someone walking a gallery turns them on. */
        if (!lit[0] && cards[0].getBoundingClientRect().top < innerHeight * 0.7) {
          switchOn(0, instant);
          if (instant) switchOn(1, true);
          else stagger = setTimeout(() => switchOn(1, false), 250);
        }
      } else {
        for (let i = 0; i < cards.length; i++) {
          if (!lit[i] && cards[i].getBoundingClientRect().top < innerHeight * 0.62) {
            switchOn(i, instant);
          }
        }
      }
    };

    /* ENTERING AND LEAVING.
     *
     * The lamps used to latch: on once per visit, never off again. They now
     * behave like the fitting they are drawn as — switched off when the
     * section is behind you and struck again when you come back, flicker and
     * all. The switch-on is only skipped on the very first evaluation of a
     * page that loaded already scrolled past this section, where a flicker for
     * something the reader has not arrived at reads as a glitch.
     *
     * Hysteresis, or a section edge parked on the threshold strobes. */
    function enter() {
      if (on) return;
      on = true;
      offAt = -1;
      gate = 1;
      /* A fresh visit, so every lamp is unlit and its timer cleared — coming
         back mid-fade must not resume a half-finished switch-on. */
      clearTimeout(stagger);
      for (let i = 0; i < cards.length; i++) {
        lit[i] = false;
        start[i] = 0;
        cards[i].style.setProperty('--v', '0');
        cards[i].style.setProperty('--pour', '0');
      }
      measure();
      check();
    }
    function leave() {
      if (!on) return;
      on = false;
      clearTimeout(stagger);
      offAt = performance.now();
      if (!raf) raf = requestAnimationFrame(frame);
    }
    function gauge() {
      const r = section.getBoundingClientRect();
      const V = innerHeight;
      if (!on && r.top < V * 0.85 && r.bottom > V * 0.15) enter();
      else if (on && (r.bottom < V * 0.1 || r.top > V * 0.95)) leave();
    }

    /* One listener, one check per frame. Nothing here ever switches a lamp
       back off, so scrolling up and down again leaves them all alone. */
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        gauge();
        check();
      });
    };

    measure();
    gauge();
    booted = true;
    addEventListener('scroll', onScroll, { passive: true });
    /* Re-measure the LAYOUT, never the lit state: a card that is already on
       stays on across a resize, and only the dark ones adopt the new mode. */
    new ResizeObserver(() => {
      measure();
      gauge();
      check();
    }).observe(list);
    document.fonts?.ready.then(() => {
      measure();
      gauge();
      check();
    });
  }

  document.querySelectorAll<HTMLElement>('.wyg').forEach(pictureLights);
</script>
