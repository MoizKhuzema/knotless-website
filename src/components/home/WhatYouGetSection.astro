---
/**
 * Section 01 — What you get.
 *
 * ONE grid for the whole section: a sticky label rail on the left, a single
 * content column on the right. The prose and the verticals used to sit on
 * different grids — 576px of prose above 1159px of verticals — and nothing
 * lined up, which is most of why the two halves read as different pages.
 *
 * THE TWO PARAGRAPHS ARE SET IDENTICALLY, on purpose. They are a pair: the
 * first is the Assessment, the second is the build. The first used to set at
 * 26px cream against the second at 18px dimmed — 1.44x the size, brighter, and
 * 2.4x the height — which said one was the argument and the other a footnote.
 * The comment justifying it admitted the real reason was density ("without a
 * step down it reads as an undifferentiated wall"), which is a density problem
 * answered with a hierarchy tool. The hairline between them marks the turn from
 * what we find to what we build; that is the hierarchy, and it is structural.
 *
 * THE VERTICALS' LEAD CARRIES THE CLAIM and now reads like it. "We specialise
 * in two verticals" is the sentence that does the differentiating, and it was
 * set at 11px — the smallest text on the page — under names at 52px, a 4.7x
 * inversion of importance. The lead is now a rail heading like the section's
 * own, and the names sit on a scale step instead of between two (52px was
 * hand-picked: the scale goes 34, 48, 60).
 */
import { WHAT_YOU_GET } from '../../data/homepage';
---

<section class="wyg" id="what-you-get">
  <div class="shell">
    <hr class="rule-measured" />

    <div class="wyg__block" data-reveal>
      <div class="wyg__rail">
        <p class="index meta r" style="--i: 0"><span>01</span></p>
        <h2 class="h-section wyg__h r" style="--i: 1">{WHAT_YOU_GET.heading}</h2>
      </div>

      <div class="wyg__prose">
        {
          WHAT_YOU_GET.body.map((para, i) => (
            <p class="wyg__p r" style={`--i: ${i + 2}`}>
              {para}
            </p>
          ))
        }
      </div>
    </div>

    <div class="wyg__block wyg__block--verticals" data-reveal>
      {/* The claim, given a heading's position rather than a caption's size. */}
      <h3 class="wyg__vhead r" style="--i: 0">{WHAT_YOU_GET.verticalsLead}</h3>

      <dl class="vlist">
        {
          WHAT_YOU_GET.verticals.map((v, i) => (
            <div class="vlist__row r" style={`--i: ${i + 1}`}>
              <dt class="vlist__name">{v.name}</dt>
              {/* Stacked, not a run of hairline-separated words. Seven services
                  flowing as one 15px line is the weakest way to present the
                  thing that proves the focus; in two columns they read as an
                  index, which is what they are. */}
              <dd class="vlist__members">
                <ul class:list={[v.members.length > 4 && 'is-two-up']}>
                  {v.members.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .rule-measured {
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .wyg {
    padding-top: var(--spacing-section-lg);
  }

  /* One grid, used twice — the prose and the verticals sit on the same two
     columns, so the section reads as a single document rather than as two. */
  .wyg__block {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 64rem) {
    .wyg__block {
      grid-template-columns: minmax(0, 20rem) minmax(0, 40rem);
      gap: 0 5rem;
      justify-content: space-between;
    }
    .wyg__rail {
      position: sticky;
      top: 8rem;
      align-self: start;
    }
  }

  .wyg__h {
    margin: 1.25rem 0 0;
  }

  /* Both paragraphs, identically. */
  .wyg__p {
    font-size: var(--text-lg);
    line-height: 1.6;
    letter-spacing: var(--tracking-tight);
    color: var(--color-cream);
    margin: 0;
  }
  .wyg__p + .wyg__p {
    margin-top: 2.25rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--color-line);
  }

  /* --- Verticals ----------------------------------------------------- */

  .wyg__block--verticals {
    margin-top: clamp(4rem, 7vw, 6rem);
  }

  /* The lead, at the scale's caption step rather than its smallest label step,
     and holding a heading's position in the rail. */
  .wyg__vhead {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-cream-dim);
  }
  @media (min-width: 64rem) {
    .wyg__vhead {
      position: sticky;
      top: 8rem;
      align-self: start;
    }
  }

  .vlist {
    margin: 0;
    border-top: 1px solid var(--color-line);
  }

  .vlist__row {
    padding: clamp(1.5rem, 2.5vw, 2rem) 0;
    border-bottom: 1px solid var(--color-line);
  }

  .vlist__name {
    font-size: var(--text-xl);
    line-height: 1.2;
    letter-spacing: var(--tracking-tight);
    color: var(--color-cream);
    margin: 0;
  }

  .vlist__members {
    margin: 1rem 0 0;
  }
  .vlist__members ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
    line-height: 2;
    color: var(--color-cream-dim);
  }
  /* Two columns only when there is enough to fill them. Property's two members
     split across two columns left one stranded at the far side of the measure,
     which reads as a mistake rather than as a layout. */
  .vlist__members ul.is-two-up {
    columns: 2;
    column-gap: 2rem;
  }
  .vlist__members li {
    break-inside: avoid;
  }

  @media (max-width: 639px) {
    .vlist__members ul.is-two-up {
      columns: 1;
    }
  }
</style>
