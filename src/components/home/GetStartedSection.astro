---
/**
 * Section 03 — How to get started. The close.
 *
 * The one light panel on a dark site. After several screens of ink, paper
 * arrives as an event — the same trick as a reversed panel on a light site,
 * run the other way round, and it lands harder because nothing else on the
 * page is light.
 *
 * Two statements, not a stepper. Numbering two things implies a process that
 * doesn't exist.
 */
import { GET_STARTED } from '../../data/homepage';
import CtaButton from '../CtaButton.astro';
---

<section class="close">
  <div class="shell">
    <div class="close__panel" data-reveal>
      <div class="close__inner">
        <span class="rule-thread close__rule r" aria-hidden="true" style="--i: 0"></span>

        <h2 class="h-section close__h r" style="--i: 1">{GET_STARTED.heading}</h2>

        <ol class="close__steps">
          {
            GET_STARTED.steps.map((step, i) => (
              <li class="close__step r" style={`--i: ${i + 2}`}>
                <span class="close__bullet" aria-hidden="true" />
                <p>{step}</p>
              </li>
            ))
          }
        </ol>

        <div class="close__cta r" style="--i: 4">
          <CtaButton href={GET_STARTED.cta.href} variant="inverse">{GET_STARTED.cta.label}</CtaButton>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .close {
    padding-top: var(--spacing-section-lg);
  }

  .close__panel {
    background-color: var(--color-invert-bg);
    color: var(--color-invert-fg);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 5vw, 6rem);
    position: relative;
  }

  /* The embossed thread texture is gone. Its mask deliberately faded it IN
     across the right 55% — it existed to fill the half of the panel nothing
     else reached, and the reason recorded for it, mirroring the hero's thread
     bundle, refers to a hero that no longer exists. overflow:hidden went with
     it: clipping that texture to the rounded corners was its only job. */

  /* The cap moves off this wrapper, which was capping the HEADING too. */
  .close__inner {
    position: relative;
  }

  /* The index rule has to flip to ink on the light panel. */
  .close__rule {
    background: linear-gradient(to right, var(--color-invert-line), transparent);
  }

  .close__h {
    color: var(--color-invert-fg);
    margin: 1.25rem 0 0;
  }

  .close__steps {
    list-style: none;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  /* ONE measure, and widening it is what fixes both faults at once.
   *
   * The cap was 44rem on the wrapper. Inside a panel with 1056px of usable
   * width at 1440 that ran the statements at 48 characters — well under the
   * 68-70 the design asks for — and left 352px, 29% of the panel, empty at the
   * same time. Both faults had one cause, so they have one fix: the same type
   * in a wider column reads longer lines AND reaches further across the panel.
   * Narrowing it to correct the measure would have taken the empty share to
   * 41%; widening it corrects both.
   *
   * 58rem, measured: 68 characters at 1024, 1280, 1440 and 1920 — on target —
   * with the residual right margin down from 29% to 12.5% at 1440, which reads
   * as margin rather than as a hole.
   *
   * On the ROW, not the paragraph, so the marker beside the text is inside the
   * same measure. */
  .close__step {
    max-width: 58rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    align-items: start;
  }
  .close__step p {
    margin: 0;
    font-size: var(--text-lead);
    line-height: 1.5;
    letter-spacing: var(--tracking-tight);
    color: var(--color-invert-fg-dim);
  }

  /* A short ember dash, not a number — the thread, one segment per statement. */
  .close__bullet {
    width: 1.75rem;
    height: 2px;
    background-color: var(--color-invert-accent);
    margin-top: 0.85em;
  }

  .close__cta {
    margin-top: clamp(2.5rem, 4vw, 3.25rem);
  }

  @media (max-width: 639px) {
    .close__step {
      gap: 0.85rem;
    }
    .close__bullet {
      width: 1rem;
      margin-top: 0.7em;
    }
    /* At phone width the lead size leaves ~18 characters a line inside the
       panel. Step it down to body so each statement reads as a sentence. */
    .close__step p {
      font-size: var(--text-base);
      line-height: 1.6;
    }
  }
</style>
