---
/**
 * Section 2 — "AI is complicated. Knotless isn't."
 * Intro + three Assessment stages (each an in-page anchor target for the nav)
 * + "How to get started" three steps. Left-aligned editorial; one terracotta
 * accent (the rule under the heading). Numerals are warm grey, not accent.
 */
import { ASSESSMENT } from '../../data/homepage';
import ArrowLink from '../ArrowLink.astro';
---

<!-- Asymmetric rhythm: generous space above the heading (separating it from the
     previous section), little below (grouping it with its content). -->
<section class="pt-section-lg">
  <div data-reveal class="max-w-text">
    <span class="accent-rule"></span>
    <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {ASSESSMENT.heading}
    </h2>
    <p class="mt-6 text-lg text-ink">{ASSESSMENT.intro}</p>
  </div>

  <!-- Stages -->
  <div class="mt-16 grid gap-px border-t border-warm-grey">
    {
      ASSESSMENT.stages.map((stage) => (
        <article
          id={stage.id}
          data-reveal
          class="scroll-mt-24 border-b border-warm-grey py-8 sm:grid sm:grid-cols-12 sm:gap-8"
        >
          <div class="sm:col-span-3">
            <span class="text-2xl font-normal tracking-tight text-ink">{stage.n}</span>
            <h3 class="mt-2 text-xl font-semibold tracking-tight text-ink">{stage.title}</h3>
          </div>
          <p class="mt-3 max-w-prose text-ink sm:col-span-9 sm:mt-0">{stage.body}</p>
        </article>
      ))
    }
  </div>

  <div data-reveal class="mt-8">
    <ArrowLink href={ASSESSMENT.readMore.href}>{ASSESSMENT.readMore.label}</ArrowLink>
  </div>

  <!-- How to get started -->
  <div data-reveal class="mt-section-lg max-w-text">
    <span class="accent-rule"></span>
    <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {ASSESSMENT.stepsHeading}
    </h2>
  </div>

  <ol class="mt-12 grid gap-12 sm:grid-cols-3">
    {
      ASSESSMENT.steps.map((step) => (
        <li data-reveal class="border-t border-warm-grey pt-5">
          <span class="text-xl font-normal tracking-tight text-ink">{step.n}</span>
          <h3 class="mt-3 text-lg font-semibold tracking-tight text-ink">{step.title}</h3>
          <p class="mt-2 text-ink">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
