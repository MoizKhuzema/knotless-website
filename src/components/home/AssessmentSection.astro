---
/**
 * Section 2 — "AI is complicated. Knotless isn't."
 * Intro + three Assessment stages (each an in-page anchor target for the nav)
 * + "How to get started" three steps. Left-aligned editorial; one terracotta
 * accent (the rule under each heading).
 *
 * Stages: un-numbered editorial rows (a terracotta marker + the stage name lead,
 * the description follows in a second column on desktop). Each row flips to an
 * Ink panel on hover — the page's quiet, tactile moment. Steps below are a
 * numbered stepper (markers + a connecting line) — vertical on mobile, horizontal
 * on desktop — kept visually distinct from the un-numbered stages.
 */
import { ASSESSMENT } from '../../data/homepage';
import ArrowLink from '../ArrowLink.astro';
---

<!-- Asymmetric rhythm: generous space above the heading (separating it from the
     previous section), little below (grouping it with its content). -->
<section id="assessment" class="scroll-mt-24 pt-section-lg">
  <div data-reveal>
    <span class="accent-rule"></span>
    <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {ASSESSMENT.heading}
    </h2>
    <p class="mt-6 max-w-text text-lg text-ink">{ASSESSMENT.intro}</p>
  </div>

  <!-- Stages: no numbers — a terracotta marker + the stage name lead, with the
       description in a second column on desktop (stacked on mobile). The whole
       row flips to Ink on hover. -->
  <div class="mt-10 border-t border-warm-grey sm:mt-14">
    {
      ASSESSMENT.stages.map((stage) => (
        <article
          id={stage.id}
          data-reveal
          class="group scroll-mt-24 border-b border-warm-grey py-6 transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-ink sm:grid sm:grid-cols-12 sm:items-baseline sm:gap-8 sm:py-7"
        >
          <h3 class="flex items-center gap-3 text-lg font-semibold tracking-tight text-ink transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:text-cream sm:col-span-4 sm:text-xl">
            <span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-terracotta" />
            {stage.title}
          </h3>
          <p class="mt-2 max-w-prose text-ink transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:text-cream sm:col-span-8 sm:mt-0">
            {stage.body}
          </p>
        </article>
      ))
    }
  </div>

  <div data-reveal class="mt-8">
    <ArrowLink href={ASSESSMENT.readMore.href}>{ASSESSMENT.readMore.label}</ArrowLink>
  </div>

  <!-- How to get started -->
  <div data-reveal class="mt-section-lg max-w-text">
    <span class="accent-rule"></span>
    <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {ASSESSMENT.stepsHeading}
    </h2>
  </div>

  {/* A numbered stepper: small markers connected by a line — vertical on mobile,
      horizontal on desktop. Deliberately distinct from the un-numbered stages. */}
  <div data-reveal class="mt-12">
    <ol class="flex flex-col sm:grid sm:grid-cols-3 sm:gap-x-12">
      {
        ASSESSMENT.steps.map((step, i) => (
          <li class="relative flex gap-5 pb-10 last:pb-0 sm:block sm:gap-0 sm:pb-0">
            {i < ASSESSMENT.steps.length - 1 && (
              <>
                {/* mobile: vertical connector down to the next marker */}
                <span
                  aria-hidden="true"
                  class="absolute bottom-0 left-[17px] top-11 w-px bg-warm-grey sm:hidden"
                />
                {/* desktop: horizontal connector across to the next marker */}
                <span
                  aria-hidden="true"
                  class="absolute left-9 top-[17px] hidden h-px -right-12 bg-warm-grey sm:block"
                />
              </>
            )}
            <span class="relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-warm-grey bg-cream text-sm font-medium text-ink">
              {i + 1}
            </span>
            <div class="min-w-0 flex-1 sm:mt-5">
              <h3 class="text-lg font-semibold tracking-tight text-ink">{step.title}</h3>
              <p class="mt-2 text-ink">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
