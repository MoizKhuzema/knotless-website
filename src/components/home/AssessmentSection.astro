---
/**
 * Section 2 — "AI is complicated. Knotless isn't."
 * Intro + three Assessment stages (each an in-page anchor target for the nav)
 * + "How to get started" three steps. Left-aligned editorial; one terracotta
 * accent (the rule under each heading).
 *
 * Editorial device: oversized warm-grey numerals carry the rhythm (scale, not
 * colour). Each stage row flips to an Ink panel on hover — the page's quiet,
 * tactile moment — using only the approved Ink/Cream pair, on the house easing.
 * Colour transitions are gentle and safe under reduced motion.
 */
import { ASSESSMENT } from '../../data/homepage';
import ArrowLink from '../ArrowLink.astro';
---

<!-- Asymmetric rhythm: generous space above the heading (separating it from the
     previous section), little below (grouping it with its content). -->
<section id="assessment" class="scroll-mt-24 pt-section-lg">
  <div data-reveal>
    <span class="accent-rule"></span>
    <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {ASSESSMENT.heading}
    </h2>
    <p class="mt-6 max-w-text text-lg text-ink">{ASSESSMENT.intro}</p>
  </div>

  <!-- Stages -->
  <div class="mt-16 border-t border-warm-grey">
    {
      ASSESSMENT.stages.map((stage) => (
        <article
          id={stage.id}
          data-reveal
          class="group -mx-4 scroll-mt-24 rounded-sm border-b border-warm-grey px-4 py-7 transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-ink sm:grid sm:grid-cols-12 sm:items-center sm:gap-8"
        >
          <div class="sm:col-span-3">
            <span class="block text-4xl font-light leading-none tracking-tight text-warm-grey transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:text-cream sm:text-5xl">
              {stage.n}
            </span>
          </div>
          <div class="mt-3 sm:col-span-9 sm:mt-0">
            <h3 class="text-xl font-semibold tracking-tight text-ink transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:text-cream">
              {stage.title}
            </h3>
            <p class="mt-2 max-w-prose text-ink transition-colors duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:text-cream">
              {stage.body}
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <div data-reveal class="mt-8">
    <ArrowLink href={ASSESSMENT.readMore.href}>{ASSESSMENT.readMore.label}</ArrowLink>
  </div>

  <!-- How to get started -->
  <div data-reveal class="mt-section-lg max-w-text">
    <span class="accent-rule"></span>
    <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {ASSESSMENT.stepsHeading}
    </h2>
  </div>

  <ol class="mt-12 grid gap-12 sm:grid-cols-3">
    {
      ASSESSMENT.steps.map((step) => (
        <li data-reveal class="border-t border-warm-grey pt-5">
          <span class="block text-4xl font-light leading-none tracking-tight text-warm-grey">
            {step.n}
          </span>
          <h3 class="mt-4 text-lg font-semibold tracking-tight text-ink">{step.title}</h3>
          <p class="mt-2 text-ink">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
