---
/**
 * Section 2 — "AI is complicated. Knotless isn't."
 * Labelled header + larger lead, three Assessment stages (each a nav anchor)
 * with oversized numerals that warm to terracotta on hover, then the labelled
 * "How to get started" steps. One terracotta accent (the header tick).
 */
import { ASSESSMENT } from '../../data/homepage';
import SectionHeader from '../SectionHeader.astro';
import ArrowLink from '../ArrowLink.astro';
---

<!-- Asymmetric rhythm: generous space above the heading (separating it from the
     previous section), little below (grouping it with its content). -->
<section class="pt-section-lg">
  <div data-reveal class="max-w-text">
    <SectionHeader label={ASSESSMENT.label} title={ASSESSMENT.heading} />
    <p class="mt-6 text-xl text-ink">{ASSESSMENT.intro}</p>
  </div>

  <!-- Stages -->
  <div class="mt-16 border-t border-warm-grey">
    {
      ASSESSMENT.stages.map((stage) => (
        <article
          id={stage.id}
          data-reveal
          class="stage group scroll-mt-28 border-b border-warm-grey py-9 sm:grid sm:grid-cols-12 sm:gap-8"
        >
          <div class="flex items-baseline gap-4 sm:col-span-4 sm:block">
            <span class="block text-4xl font-light tracking-tight text-ink transition-colors duration-300 group-hover:text-terracotta sm:text-5xl">
              {stage.n}
            </span>
            <h3 class="text-xl font-semibold tracking-tight text-ink sm:mt-3">{stage.title}</h3>
          </div>
          <p class="mt-3 max-w-prose text-ink sm:col-span-8 sm:mt-0 sm:self-center">{stage.body}</p>
        </article>
      ))
    }
  </div>

  <div data-reveal class="mt-8">
    <ArrowLink href={ASSESSMENT.readMore.href}>{ASSESSMENT.readMore.label}</ArrowLink>
  </div>

  <!-- How to get started -->
  <div data-reveal class="mt-section-lg max-w-text">
    <SectionHeader label={ASSESSMENT.stepsLabel} title={ASSESSMENT.stepsHeading} />
  </div>

  <ol class="mt-12 grid gap-12 sm:grid-cols-3">
    {
      ASSESSMENT.steps.map((step) => (
        <li data-reveal class="step group border-t border-warm-grey pt-5">
          <span class="block text-3xl font-light tracking-tight text-ink transition-colors duration-300 group-hover:text-terracotta">
            {step.n}
          </span>
          <h3 class="mt-3 text-lg font-semibold tracking-tight text-ink">{step.title}</h3>
          <p class="mt-2 text-ink">{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>
