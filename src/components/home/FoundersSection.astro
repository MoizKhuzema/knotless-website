---
/**
 * Section 02 — Who you'll be talking to.
 *
 * Two founder panels, raised off the page ground. With no photographs and no
 * case studies, the founders ARE the proof, so this section gets real
 * presence: large names in the display serif, and contact details as
 * first-class rows rather than footnotes.
 *
 * Details are labelled links with visible text — a glyph plus the readable
 * address, 44px rows, correct mailto:/tel:. Names, titles, emails and phones
 * come from site.ts.
 */
import { FOUNDERS_SECTION } from '../../data/homepage';
import { SITE } from '../../config/site';
import ArrowLink from '../ArrowLink.astro';

const dial = (phone: string) => phone.replace(/\s+/g, '');
---

<section class="founders">
  <div class="shell">
    <div data-reveal>
      <span class="rule-thread r" data-catch="line" aria-hidden="true" style="--i: 0"></span>
      <div class="founders__head">
        <h2 class="h-section r" style="--i: 1">{FOUNDERS_SECTION.heading}</h2>
        <p class="lead founders__lead r" style="--i: 2">{FOUNDERS_SECTION.lead}</p>
      </div>
    </div>

    <div class="founders__grid" data-reveal>
      {
        SITE.founders.map((f, i) => (
          <article class="fcard r" data-catch="ring" style={`--i: ${i + 1}`}>
            <div class="fcard__head">
              <h3 class="fcard__name display">{f.name}</h3>
              <p class="meta fcard__role">{f.title}</p>
            </div>

            <ul class="fcard__links">
              <li>
                <a class="flink" href={`mailto:${f.email}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M3.5 6.5 12 13l8.5-6.5" />
                  </svg>
                  <span>{f.email}</span>
                </a>
              </li>
              <li>
                <a class="flink" href={`tel:${dial(f.phone)}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7.5 3.5h-3a1.5 1.5 0 0 0-1.5 1.5C3 13 11 21 19 21a1.5 1.5 0 0 0 1.5-1.5v-3l-4-1.5-2 2.5a14 14 0 0 1-5.5-5.5L11.5 10z" />
                  </svg>
                  <span>{f.phone}</span>
                </a>
              </li>
            </ul>
          </article>
        ))
      }
    </div>

    <div class="founders__more" data-reveal>
      <div class="r">
        <ArrowLink href={FOUNDERS_SECTION.readMore.href}>{FOUNDERS_SECTION.readMore.label}</ArrowLink>
      </div>
    </div>
  </div>
</section>

<style>
  .founders {
    padding-top: var(--spacing-section-lg);
  }

  .founders__head {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .founders__lead {
    color: var(--color-cream-dim);
    max-width: 38ch;
  }

  @media (min-width: 64rem) {
    .founders__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      align-items: end;
      gap: 4rem;
    }
    .founders__lead {
      padding-bottom: 0.5rem;
    }
  }

  .founders__grid {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  @media (min-width: 48rem) {
    .founders__grid {
      /* One grid cell, the same as the stages above. The gap was a hardcoded
         1.5rem, which put these card edges 28px off the nearest grid line at
         1440 and 26px at 768 — the one section on the page not standing on its
         own grid. With an odd column count a one-cell gap leaves (n-1)/2 whole
         cells per card, so all four edges land. */
      gap: var(--grid-cell);
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* --- Card ----------------------------------------------------------- */

  /* The same pane as the stages, not .panel. These were an opaque #1a1815 slab
     at 10px radius with no blur while the section above used glass at 14px —
     two card materials on one page, for no reason either could state.

     overflow is NOT hidden any more. It was there to clip the ember thread
     that used to run along the top edge; what it was also doing was clipping
     the catch ring, which sits at inset:-1px and so lost its outer pixel on
     every card. The stages are overflow:visible for the same reason. */
  .fcard {
    position: relative;
    padding: clamp(1.25rem, 2vw, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    border-radius: var(--radius-lg);
    background-color: var(--color-glass-soft);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border: 1px solid var(--color-glass-soft-edge);
    box-shadow: inset 0 1px 0 var(--color-glass-soft-spec);
  }

  .fcard__name {
    font-size: clamp(1.875rem, 1.2rem + 2vw, 2.75rem);
    margin: 0;
    color: var(--color-cream);
  }

  /* Cream-dim, not ember. On the old panel this measured 4.38:1 — under AA,
     a real failure that had been shipping — and a job title is not a verdict,
     a figure or a call to action, which is what the accent is reserved for.
     It reads 6.86:1 now, and with the icons below it the card spends no ember
     at all: the section's only orange is the arrow on the link under it. */
  .fcard__role {
    margin: 0.6rem 0 0;
    color: var(--color-cream-dim);
  }

  .fcard__links {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .fcard__links li + li {
    border-top: 1px solid var(--color-line);
  }

  .flink {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 3.25rem; /* comfortably over the 44px floor */
    color: var(--color-cream-dim);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--dur-fast) var(--ease-out);
    word-break: break-word;
  }
  .flink svg {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
    color: var(--color-cream-dim);
    opacity: 0.7;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .flink:hover,
  .flink:focus-visible {
    color: var(--color-cream);
  }
  .flink:hover svg {
    opacity: 1;
  }
  .flink:hover span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .founders__more {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }
</style>
