---
/**
 * Section 3 — "Who you'll be talking to".
 * Narrative body (page content) + two founder blocks. Founder names and titles
 * come from src/config/site.ts, not the content file.
 */
import { FOUNDERS_SECTION } from '../../data/homepage';
import { SITE } from '../../config/site';
import ArrowLink from '../ArrowLink.astro';
---

<section class="pt-section-lg">
  <div data-reveal class="max-w-text">
    <span class="accent-rule"></span>
    <h2 class="mt-6 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {FOUNDERS_SECTION.heading}
    </h2>
  </div>

  <div data-reveal class="mt-8 max-w-prose space-y-5 text-ink">
    {FOUNDERS_SECTION.body.map((para) => <p>{para}</p>)}
  </div>

  <!-- Founder blocks (name + title from site.ts). The circular headshot
       placeholder is hidden for now (no founder photos yet). To bring it back,
       un-comment the <div> below; the h3 loses its top margin while it's hidden
       so the block sits flush. -->
  <div class="mt-12 grid grid-cols-2 gap-6 sm:mt-16 sm:gap-10">
    {
      SITE.founders.map((founder) => (
        <div data-reveal>
          {/* Headshot hidden for now — restore this block (and add back `mt-4 sm:mt-5` on the h3) when photos are ready:
          <div class="flex h-20 w-20 items-center justify-center overflow-hidden rounded-full border border-warm-grey sm:h-28 sm:w-28"></div>
          */}
          <h3 class="text-lg font-semibold tracking-tight text-ink">{founder.name}</h3>
          <p class="label mt-1.5 text-ink sm:mt-2">{founder.title}</p>
        </div>
      ))
    }
  </div>

  <div data-reveal class="mt-12">
    <ArrowLink href={FOUNDERS_SECTION.readMore.href}>{FOUNDERS_SECTION.readMore.label}</ArrowLink>
  </div>
</section>
