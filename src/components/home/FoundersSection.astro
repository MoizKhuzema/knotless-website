---
/**
 * Section 3 — who you'll be talking to.
 *
 * Heading and lead line on the .sidehead grid, then the two founders break out
 * to the full page width. That width change is deliberate: the founder blocks
 * are not prose, so the measure doesn't govern them, and §09 calls the current
 * treatment "the weakest moment on the page". This is where the people are the
 * subject, so it gets the room.
 *
 * NO BOXES. "Card" here means block, not a bordered container: a box would
 * want a hover to feel like one, and §06 forbids hover treatments on
 * non-interactive elements. Hover lives only on the two links inside each
 * block, which genuinely are interactive.
 *
 * Contact details are labelled links with visible text — a warm-grey glyph
 * followed by the readable address or number, never a bare icon. The visible
 * text IS the accessible name (no aria-label, which would risk breaking WCAG
 * 2.5.3 Label in Name); context comes from the <h3> above, which is how
 * heading navigation is meant to work.
 *
 * Names, titles, emails and phone numbers come from site.ts, not from page
 * content. No terracotta in this composition.
 */
import { FOUNDERS_SECTION } from '../../data/homepage';
import { SITE } from '../../config/site';
import ArrowLink from '../ArrowLink.astro';

/** tel: needs the bare number; the visible text keeps its spacing. */
const dial = (phone: string) => phone.replace(/\s+/g, '');
---

<section class="pt-section">
  <div class="sidehead">
    <div data-reveal>
      <h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        {FOUNDERS_SECTION.heading}
      </h2>
    </div>
    <p data-reveal class="standfirst mt-6 text-ink lg:mt-0">{FOUNDERS_SECTION.lead}</p>
  </div>

  <div class="mt-14 grid gap-10 sm:grid-cols-2 sm:gap-12">
    {
      SITE.founders.map((founder) => (
        <div data-reveal class="border-t border-warm-grey pt-6">
          <h3 class="text-lg font-semibold tracking-tight text-ink">{founder.name}</h3>
          <p class="label mt-2 text-ink">{founder.title}</p>

          {/* min-h-11 + the matching negative margin on the list keeps every
              row a 44px target (§11.9) without inflating the block. */}
          <ul class="mt-4 -mb-2 text-sm">
            <li>
              <a
                href={`mailto:${founder.email}`}
                class="founder-link inline-flex min-h-11 items-center gap-2.5 text-ink no-underline underline-offset-4 hover:underline"
              >
                <svg
                  class="founder-glyph"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="M3.5 6.5 12 13l8.5-6.5" />
                </svg>
                {founder.email}
              </a>
            </li>
            <li>
              <a
                href={`tel:${dial(founder.phone)}`}
                class="founder-link inline-flex min-h-11 items-center gap-2.5 text-ink no-underline underline-offset-4 hover:underline"
              >
                <svg
                  class="founder-glyph"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7.5 3.5h-3a1.5 1.5 0 0 0-1.5 1.5C3 13 11 21 19 21a1.5 1.5 0 0 0 1.5-1.5v-3l-4-1.5-2 2.5a14 14 0 0 1-5.5-5.5L11.5 10z" />
                </svg>
                {founder.phone}
              </a>
            </li>
          </ul>
        </div>
      ))
    }
  </div>

  <div data-reveal class="mt-14">
    <ArrowLink href={FOUNDERS_SECTION.readMore.href}>{FOUNDERS_SECTION.readMore.label}</ArrowLink>
  </div>
</section>

<style>
  /* Warm grey on the glyph only — the address stays Ink, so the readable part
     keeps full contrast and the icon sits back as the metadata it is. The
     underline on hover comes from the utility; the glyph is not underlined
     because it is not text. */
  .founder-glyph {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    color: var(--color-warm-grey);
  }
</style>
