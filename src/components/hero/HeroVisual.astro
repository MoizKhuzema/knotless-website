---
/**
 * HERO — "Strike".
 *
 * The tagline sits as a static eyebrow above the headline. The terracotta
 * strike draws in under "worth" as the single accent, and the rest of the
 * block fades up on load. All motion is opacity/transform only and disabled
 * under prefers-reduced-motion.
 */
import { HERO } from '../../data/homepage';
import { SITE } from '../../config/site';
import CtaButton from '../CtaButton.astro';
---

<section class="pt-20 pb-section sm:pt-28">
  <p class="text-label uppercase tracking-tagline text-ink">{SITE.tagline}</p>

  <h1 class="r r-1 mt-5 max-w-[16ch] text-4xl font-semibold leading-[1.04] tracking-tight text-ink sm:text-5xl">
    AI that's <span class="emph">worth</span> building.
  </h1>

  <p class="r r-2 mt-7 max-w-text text-lg text-ink">
    {HERO.subhead}
  </p>

  <div class="r r-3 mt-8">
    <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
  </div>

  <!-- Industries served — static, dot-separated, reads at a glance. -->
  <ul class="industries r r-4 mt-12 flex flex-wrap items-center border-t border-warm-grey pt-5 text-label uppercase tracking-label text-ink">
    {HERO.verticals.map((v) => <li>{v}</li>)}
  </ul>
</section>

<style>
  /* --- Dot separators between industries --- */
  .industries li + li::before {
    content: '·';
    margin: 0 0.85rem;
    color: var(--color-warm-grey);
  }

  /* --- The accent-rule echo under "worth": draws in on load --- */
  .emph {
    position: relative;
    white-space: nowrap;
  }
  .emph::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.08em;
    background-color: var(--color-terracotta);
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .r {
      opacity: 0;
      transform: translateY(12px);
      animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .r-1 { animation-delay: 0.1s; }
    .r-2 { animation-delay: 0.23s; }
    .r-3 { animation-delay: 0.36s; }
    .r-4 { animation-delay: 0.49s; }

    .emph::after {
      animation: draw 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: 0.6s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .emph::after {
      transform: scaleX(1);
    }
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes draw {
    to {
      transform: scaleX(1);
    }
  }
</style>
