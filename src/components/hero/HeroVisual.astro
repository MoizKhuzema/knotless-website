---
/**
 * HERO — "Strike" + the signature knot.
 *
 * The headline lands instantly, except the word "worth" types in; then the
 * terracotta strike draws beneath it (the one accent in this composition) and
 * the caret blinks twice and disappears. In the right column a line-art KNOT is
 * pulled straight by a hand that slides in from the edge, grips the lower end,
 * drags it down (overstretching it), then lets go so it springs back to length —
 * the brand promise ("AI Untangled") made literal. The resolved DOWNWARD arrow
 * doubles as a "scroll to the next section" control.
 *
 * Everything is opacity/transform/`d`-morph only and fully disabled under
 * prefers-reduced-motion (the word, strike and knot are simply shown resolved;
 * the scroll jump is instant). The knot is Ink only: terracotta stays reserved
 * for the strike so the hero keeps a single accent.
 */
import { HERO } from '../../data/homepage';
import { SITE } from '../../config/site';
import CtaButton from '../CtaButton.astro';

// Vertical knot (tangled) and resolved (straight line + downward arrowhead).
// IDENTICAL command structure — M, six C, then "M L L" for the head — so `d`
// interpolates cleanly. LINE is KNOT with every x pinned to the centre line, so
// the morph collapses the tangle sideways into a straight vertical drop.
const KNOT =
  'M112 28 C112 54 58 70 92 80 C126 90 132 52 144 70 C156 89 150 121 110 115 C78 110 70 85 102 95 C134 105 138 143 110 157 C84 171 112 188 112 204 M99 193 L112 205 L125 193';
const LINE =
  'M112 28 C112 54 112 70 112 80 C112 90 112 52 112 70 C112 89 112 121 112 115 C112 110 112 85 112 95 C112 105 112 143 112 157 C112 171 112 188 112 204 M99 193 L112 205 L125 193';
---

<section class="pt-20 pb-section sm:pt-28">
  <div class="grid items-center gap-x-12 gap-y-14 lg:grid-cols-[1.45fr_0.55fr]">
    <!-- Left column: positioning copy -->
    <div>
      <p class="text-label uppercase tracking-tagline text-ink">{SITE.tagline}</p>

      <h1 class="mt-5 text-4xl font-semibold leading-[1.04] tracking-tight text-ink sm:text-5xl">
        AI that's <span class="emph hero-type" data-word="worth"
          ><span class="sr-only">worth</span><span class="word" aria-hidden="true"
            ><span class="sizer">worth</span><span class="live"><span class="typed">worth</span><span class="caret"></span></span></span
          ></span
        ><br />building.
      </h1>

      <p class="r r-2 mt-7 max-w-text text-lg text-ink">
        {HERO.subhead}
      </p>

      <div class="r r-3 mt-8">
        <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
      </div>
    </div>

    <!-- Right column: the knot that untangles into a downward arrow and scrolls
         to the next section. Works without JS (anchor jump); JS upgrades it to a
         smooth scroll. The SVG is decorative; the link carries the label. -->
    <div class="r r-3 hero-knot-wrap flex justify-center">
      <a
        href="#assessment"
        class="hero-scroll inline-flex rounded-sm text-ink"
        aria-label="Scroll to the next section"
      >
        <svg
          class="hero-knot"
          viewBox="44 12 140 208"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={LINE} />
        </svg>
      </a>

      <!-- The hand that pulls the knot straight, then lets it spring back.
           Decorative; hidden by default and only ever shown by the JS
           choreography (so reduced-motion / no-JS never see it). Icon: Lucide
           "grab" (ISC). -->
      <div class="hero-hand" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <!-- Cream-filled occluder (same shape as the palm) drawn BEHIND the
               strokes: invisible on the cream page, but it masks the arrow line
               so it doesn't show through the hand's open interior while gripped. -->
          <path
            d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-4a8 8 0 0 1-8-8 2 2 0 1 1 4 0Z"
            fill="var(--color-cream)"
            stroke="none"
          />
          <path d="M18 11.5V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1.4" />
          <path d="M14 10V8a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2" />
          <path d="M10 9.9V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v5" />
          <path d="M6 14a2 2 0 0 0-2-2a2 2 0 0 0-2 2" />
          <path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-4a8 8 0 0 1-8-8 2 2 0 1 1 4 0" />
        </svg>
      </div>
    </div>
  </div>

  <!-- Industries served — static, space-separated, reads at a glance. -->
  <ul class="r r-4 mt-12 flex flex-wrap items-center gap-x-7 gap-y-2 border-t border-warm-grey pt-5 text-label uppercase tracking-label text-ink">
    {HERO.verticals.map((v) => <li>{v}</li>)}
  </ul>
</section>

<!-- is:inline so it runs during parse (pre-paint): arms the word before it can
     flash, then types after fonts load. Also arms the knot in its tangled state
     so the first paint shows the knot, then untangles it; and wires the smooth
     scroll. -->
<script is:inline>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* --- knot: a hand pulls it straight, then it springs back ---
       Timeline: knot is tangled at first paint → hand slides in from the right
       and grips the lower end → pulls down (knot untangles via CSS `d` morph +
       the SVG stretches past its length) → hand releases and retreats → the
       arrow snaps back to true length with an elastic settle. */
    const knot = document.querySelector('.hero-knot');
    const hand = document.querySelector('.hero-hand');
    const canMorphD = window.CSS && CSS.supports && CSS.supports('d', 'path("M0 0")');
    const HOUSE = 'cubic-bezier(0.22, 1, 0.36, 1)';
    const wait = (ms) => new Promise((r) => setTimeout(r, ms));

    if (knot && hand && !reduce && canMorphD) {
      knot.classList.add('is-tangled'); // first paint = knot

      const play = async () => {
        try {
          // 1. hand slides in from the right edge to grip the lower end
          await hand.animate(
            [
              { transform: 'translate(200px, -6px) rotate(10deg)', opacity: 0 },
              { transform: 'translate(0px, -6px) rotate(10deg)', opacity: 1 },
            ],
            { duration: 600, easing: HOUSE, fill: 'forwards' },
          ).finished;

          await wait(130); // a beat to "grab"

          // 2. pull down: untangle (d morph) + overstretch the arrow + hand drops
          knot.classList.remove('is-tangled');
          const stretch = knot.animate(
            [{ transform: 'scaleY(1)' }, { transform: 'scaleY(1.28)' }],
            { duration: 720, easing: HOUSE, fill: 'forwards' },
          );
          hand.animate(
            [
              { transform: 'translate(0px, -6px) rotate(10deg)' },
              { transform: 'translate(0px, 58px) rotate(10deg)' },
            ],
            { duration: 720, easing: HOUSE, fill: 'forwards' },
          );
          await stretch.finished;

          // 3. release: hand retreats off to the right; arrow springs back
          hand.animate(
            [
              { transform: 'translate(0px, 58px) rotate(10deg)', opacity: 1 },
              { transform: 'translate(210px, 58px) rotate(16deg)', opacity: 0 },
            ],
            { duration: 460, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' },
          );
          knot.animate(
            [
              { transform: 'scaleY(1.28)' },
              { transform: 'scaleY(0.93)' },
              { transform: 'scaleY(1.05)' },
              { transform: 'scaleY(0.98)' },
              { transform: 'scaleY(1)' },
            ],
            { duration: 950, easing: 'ease-out', fill: 'forwards' },
          );
        } catch (e) {
          // If anything goes wrong, leave the resolved arrow.
          knot.classList.remove('is-tangled');
        }
      };

      if (document.fonts && document.fonts.ready) document.fonts.ready.then(play);
      else play();
    }

    /* --- scroll cue: smooth-scroll to the next section --- */
    const scroll = document.querySelector('.hero-scroll');
    const target = document.querySelector('#assessment');
    if (scroll && target) {
      scroll.addEventListener('click', (e) => {
        e.preventDefault();
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    }

    /* --- "worth": typewriter word + terracotta strike --- */
    const emph = document.querySelector('.hero-type');
    if (!emph || reduce) return;
    const word = emph.getAttribute('data-word') || '';
    const typed = emph.querySelector('.typed');
    const caret = emph.querySelector('.caret');
    if (!typed || !caret || !word) return;

    // Arm immediately so "worth" doesn't appear before it types.
    typed.textContent = '';
    emph.classList.add('is-typing');
    caret.classList.add('is-on');

    const start = () => {
      let i = 0;
      const tick = () => {
        i += 1;
        typed.textContent = word.slice(0, i);
        if (i < word.length) {
          setTimeout(tick, 78);
        } else {
          emph.classList.remove('is-typing'); // strike draws (CSS transition)
          // after the strike, blink the caret twice, then remove it
          setTimeout(() => {
            caret.classList.add('is-blink');
            caret.addEventListener(
              'animationend',
              () => caret.classList.remove('is-on', 'is-blink'),
              { once: true },
            );
          }, 600);
        }
      };
      setTimeout(tick, 320); // brief beat before typing
    };

    if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
    else start();
  })();
</script>

<style define:vars={{ knot: `path("${KNOT}")`, line: `path("${LINE}")` }}>
  /* --- the knot visual / scroll cue (fills the right half of the hero) --- */
  .hero-knot-wrap {
    position: relative; /* anchor for the absolutely-positioned hand */
    display: flex;
    justify-content: center;
  }
  .hero-knot {
    display: block;
    width: 10rem; /* fixed: the <a> is shrink-to-fit, so % has no basis */
    height: auto;
    color: var(--color-ink);
    overflow: visible;
    transform-origin: top center; /* stretch pulls the lower end down */
  }
  .hero-knot path {
    d: var(--line); /* default / no-JS / reduced motion: resolved line */
    transition: d 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* The pulling hand: hidden by default; the JS choreography reveals + moves it.
     Never shown under reduced motion / no-JS. */
  .hero-hand {
    position: absolute;
    left: 50%;
    margin-left: -1.7rem; /* half of width, to centre on the arrow */
    top: 56%;
    width: 3.4rem;
    color: var(--color-ink);
    opacity: 0;
    pointer-events: none;
  }
  .hero-hand svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hero-knot.is-tangled path {
    d: var(--knot);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-knot path {
      d: var(--line);
      transition: none;
    }
  }

  /* Gentle hover/focus nudge on the scroll cue (motion-safe). */
  .hero-scroll {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-scroll:hover,
    .hero-scroll:focus-visible {
      transform: translateY(4px);
    }
  }

  /* --- "worth": typewriter word + terracotta strike --- */
  .emph {
    position: relative;
    white-space: nowrap;
  }
  /* The word reserves its final width via an invisible sizer; the live text and
     caret sit in an absolute layer over it, so typing never shifts "building." */
  .word {
    position: relative;
    display: inline-block;
  }
  .sizer {
    visibility: hidden;
  }
  .live {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
  }
  .caret {
    display: none;
    width: 0.06em;
    height: 0.9em;
    margin-left: 0.06em;
    background-color: currentColor;
    vertical-align: -0.04em;
  }
  .caret.is-on {
    display: inline-block;
  }
  /* Blink exactly twice, then JS removes the caret on animationend. */
  .caret.is-blink {
    animation: caret-blink 1.06s steps(1, end) 2;
  }

  /* The strike is shown by default (no-JS / reduced motion); while typing it's
     hidden, then transitions back in left-to-right when typing finishes. */
  .emph::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.08em;
    background-color: var(--color-terracotta);
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .emph.is-typing::after {
    transform: scaleX(0);
  }

  @keyframes caret-blink {
    0% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* --- Fade-up for the rest of the hero (not the headline) --- */
  @media (prefers-reduced-motion: no-preference) {
    .r {
      opacity: 0;
      transform: translateY(12px);
      animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .r-2 { animation-delay: 0.15s; }
    .r-3 { animation-delay: 0.28s; }
    .r-4 { animation-delay: 0.41s; }
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
