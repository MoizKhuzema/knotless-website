---
/**
 * HERO — "Strike".
 *
 * A type-led hero: the headline lands instantly, except the word "worth" types
 * in; then the terracotta strike draws beneath it (the one accent in this
 * composition), the caret blinks twice and disappears. Left-aligned editorial —
 * a single large headline carries the space, no decorative visual; the
 * whitespace is the composition.
 *
 * Motion is disabled under prefers-reduced-motion (the word + strike are shown
 * resolved). Terracotta is reserved for the strike so the hero keeps a single
 * accent.
 */
import { HERO } from '../../data/homepage';
import { SITE } from '../../config/site';
import CtaButton from '../CtaButton.astro';
---

<section class="pt-20 sm:pt-28">
  <p class="text-label uppercase tracking-tagline text-ink">{SITE.tagline}</p>

  <!-- Oversized, left-aligned headline — the page's largest type, clearly above
       every section heading at every breakpoint. Ramps smoothly so it commands
       the width on desktop without overflowing the phone/tablet columns. -->
  <h1
    class="mt-5 text-[2.4rem] font-semibold leading-[1.02] tracking-[-0.035em] text-ink min-[420px]:text-[2.9rem] sm:text-[3.75rem] md:text-[4.25rem] lg:text-[5.75rem] xl:text-[6.75rem]"
  >
    AI that's <span class="emph hero-type" data-word="worth"
      ><span class="sr-only">worth</span><span class="word" aria-hidden="true"
        ><span class="sizer">worth</span><span class="live"><span class="typed">worth</span><span class="caret"></span></span></span
      ></span
    ><br />building.
  </h1>

  <p class="r r-2 mt-8 max-w-text text-base text-ink sm:text-lg">
    {HERO.subhead}
  </p>

  <div class="r r-3 mt-8">
    <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
  </div>

  <!-- Industries served, as an even grid so it never leaves an orphaned line.
       On phones it's two compact columns set smaller than the AI UNTANGLED
       eyebrow (so it reads as quiet metadata); four columns on desktop. -->
  <ul
    class="r r-4 mt-14 grid grid-cols-2 gap-x-6 gap-y-2.5 border-t border-warm-grey pt-5 text-[0.625rem] uppercase leading-snug tracking-label text-ink sm:gap-x-8 sm:gap-y-4 sm:text-label lg:grid-cols-4"
  >
    {HERO.verticals.map((v) => <li>{v}</li>)}
  </ul>
</section>

<!-- is:inline so it runs during parse (pre-paint): arms the word before it can
     flash, then types after fonts load. -->
<script is:inline>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* --- "worth": typewriter word + terracotta strike --- */
    const emph = document.querySelector('.hero-type');
    if (!emph || reduce) return;
    const word = emph.getAttribute('data-word') || '';
    const typed = emph.querySelector('.typed');
    const caret = emph.querySelector('.caret');
    if (!typed || !caret || !word) return;

    // Arm immediately so "worth" doesn't appear before it types.
    typed.textContent = '';
    emph.classList.add('is-typing');
    caret.classList.add('is-on');

    const start = () => {
      let i = 0;
      const tick = () => {
        i += 1;
        typed.textContent = word.slice(0, i);
        if (i < word.length) {
          setTimeout(tick, 78);
        } else {
          emph.classList.remove('is-typing'); // strike draws (CSS transition)
          // after the strike, blink the caret twice, then remove it
          setTimeout(() => {
            caret.classList.add('is-blink');
            caret.addEventListener(
              'animationend',
              () => caret.classList.remove('is-on', 'is-blink'),
              { once: true },
            );
          }, 600);
        }
      };
      setTimeout(tick, 320); // brief beat before typing
    };

    if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
    else start();
  })();
</script>

<style>
  /* --- "worth": typewriter word + terracotta strike --- */
  .emph {
    position: relative;
    white-space: nowrap;
  }
  /* The word reserves its final width via an invisible sizer; the live text and
     caret sit in an absolute layer over it, so typing never shifts "building." */
  .word {
    position: relative;
    display: inline-block;
  }
  .sizer {
    visibility: hidden;
  }
  .live {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
  }
  .caret {
    display: none;
    width: 0.06em;
    height: 0.9em;
    margin-left: 0.06em;
    background-color: currentColor;
    vertical-align: -0.04em;
  }
  .caret.is-on {
    display: inline-block;
  }
  /* Blink exactly twice, then JS removes the caret on animationend. */
  .caret.is-blink {
    animation: caret-blink 1.06s steps(1, end) 2;
  }

  /* The strike is shown by default (no-JS / reduced motion); while typing it's
     hidden, then transitions back in left-to-right when typing finishes. */
  .emph::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.08em;
    background-color: var(--color-terracotta);
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .emph.is-typing::after {
    transform: scaleX(0);
  }

  @keyframes caret-blink {
    0% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* --- Fade-up for the rest of the hero (not the headline) --- */
  @media (prefers-reduced-motion: no-preference) {
    .r {
      opacity: 0;
      transform: translateY(12px);
      animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .r-2 { animation-delay: 0.15s; }
    .r-3 { animation-delay: 0.28s; }
    .r-4 { animation-delay: 0.41s; }
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
