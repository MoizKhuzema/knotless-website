---
/**
 * HERO — "Strike".
 *
 * Left-aligned editorial composition with typographic drama: the terracotta
 * strike motif is echoed as an accent rule that draws in beneath "worth" (the
 * single accent in this composition). The tagline sits as an eyebrow above the
 * headline — the wordmark itself lives in the nav, so it isn't repeated here.
 * The industry list is static for fast reading. Motion is opacity/transform
 * only and disabled under prefers-reduced-motion.
 */
import { HERO } from '../../data/homepage';
import { SITE } from '../../config/site';
import CtaButton from '../CtaButton.astro';
---

<section class="py-section">
  <p class="r r-0 text-label uppercase tracking-tagline text-ink">{SITE.tagline}</p>

  <h1 class="r r-1 mt-6 max-w-[16ch] text-4xl font-semibold leading-[1.04] tracking-tight text-ink sm:text-5xl">
    AI that's <span class="emph">worth</span> building.
  </h1>

  <p class="r r-2 mt-8 max-w-text text-lg text-ink">
    {HERO.subhead}
  </p>

  <div class="r r-3 mt-9">
    <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
  </div>

  <!-- Industries served — static, so it reads at a glance. -->
  <ul class="r r-4 mt-14 flex flex-wrap gap-x-6 gap-y-2 border-t border-warm-grey pt-5 text-label uppercase tracking-label text-ink">
    {HERO.verticals.map((v) => <li>{v}</li>)}
  </ul>
</section>

<style>
  /* The accent-rule echo under "worth": draws in on load. */
  .emph {
    position: relative;
    white-space: nowrap;
  }
  .emph::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.08em;
    background-color: var(--color-terracotta);
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: no-preference) {
    .r {
      opacity: 0;
      transform: translateY(12px);
      animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .r-0 { animation-delay: 0.05s; }
    .r-1 { animation-delay: 0.18s; }
    .r-2 { animation-delay: 0.31s; }
    .r-3 { animation-delay: 0.44s; }
    .r-4 { animation-delay: 0.57s; }

    .emph::after {
      animation: draw 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: 0.7s;
    }
  }

  /* Reduced motion: the underline is simply present, no draw. */
  @media (prefers-reduced-motion: reduce) {
    .emph::after {
      transform: scaleX(1);
    }
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes draw {
    to {
      transform: scaleX(1);
    }
  }
</style>
