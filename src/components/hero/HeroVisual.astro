---
/**
 * HERO — "Strike" + the signature knot.
 *
 * Left column: the headline lands instantly, except the word "worth" types in;
 * then the terracotta strike draws beneath it (the one accent in this
 * composition). Right column: a line-art KNOT that, on load, untangles into a
 * single straight line with an arrowhead — the brand promise ("AI Untangled")
 * made literal, in the same path-morph language as ArrowLink.
 *
 * Everything is opacity/transform/`d`-morph only and fully disabled under
 * prefers-reduced-motion (the word, strike and knot are simply shown resolved).
 * The knot is Ink only: terracotta stays reserved for the strike so the hero
 * keeps a single accent.
 */
import { HERO } from '../../data/homepage';
import { SITE } from '../../config/site';
import CtaButton from '../CtaButton.astro';

// Knot (tangled) and resolved (straight line + arrowhead). IDENTICAL command
// structure — M, six C, then "M L L" for the head — so `d` morphs cleanly.
const KNOT =
  'M28 112 C70 112 96 58 112 92 C128 126 66 132 96 144 C126 156 178 150 168 110 C160 78 120 70 136 102 C152 134 214 138 236 110 C258 84 286 112 312 112 M294 99 L314 112 L294 125';
// Same command structure as KNOT (M + six C + arrowhead) with every y flattened
// to the baseline — so the morph collapses the tangle straight down into a line.
const LINE =
  'M28 112 C70 112 96 112 112 112 C128 112 66 112 96 112 C126 112 178 112 168 112 C160 112 120 112 136 112 C152 112 214 112 236 112 C258 112 286 112 312 112 M294 99 L314 112 L294 125';
---

<section class="pt-20 pb-section sm:pt-28">
  <div class="grid items-center gap-x-12 gap-y-14 lg:grid-cols-[1.05fr_0.95fr]">
    <!-- Left column: positioning copy -->
    <div>
      <p class="text-label uppercase tracking-tagline text-ink">{SITE.tagline}</p>

      <h1 class="mt-5 max-w-[16ch] text-4xl font-semibold leading-[1.04] tracking-tight text-ink sm:text-5xl">
        AI that's <span class="emph hero-type" data-word="worth"
          ><span class="sr-only">worth</span><span class="word" aria-hidden="true"
            ><span class="sizer">worth</span><span class="live"><span class="typed">worth</span><span class="caret"></span></span></span
          ></span
        > building.
      </h1>

      <p class="r r-2 mt-7 max-w-text text-lg text-ink">
        {HERO.subhead}
      </p>

      <div class="r r-3 mt-8">
        <CtaButton href={HERO.cta.href}>{HERO.cta.label}</CtaButton>
      </div>
    </div>

    <!-- Right column: the knot that untangles. Decorative; the headline carries
         the meaning, so it's aria-hidden. -->
    <div class="r r-3 hero-knot-wrap">
      <svg
        class="hero-knot"
        viewBox="0 0 340 224"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={LINE} />
      </svg>
    </div>
  </div>

  <!-- Industries served — static, space-separated, reads at a glance. -->
  <ul class="r r-4 mt-12 flex flex-wrap items-center gap-x-7 gap-y-2 border-t border-warm-grey pt-5 text-label uppercase tracking-label text-ink">
    {HERO.verticals.map((v) => <li>{v}</li>)}
  </ul>
</section>

<!-- is:inline so it runs during parse (pre-paint): arms the word before it can
     flash, then types after fonts load. Also arms the knot in its tangled state
     so the first paint shows the knot, then untangles it. -->
<script is:inline>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* --- knot: arm tangled (pre-paint), then untangle --- */
    const knot = document.querySelector('.hero-knot');
    const canMorphD = window.CSS && CSS.supports && CSS.supports('d', 'path("M0 0")');
    if (knot && !reduce && canMorphD) {
      knot.classList.add('is-tangled'); // first paint = knot
      const untangle = () => {
        // next frame so the tangled state paints before the transition starts
        requestAnimationFrame(() =>
          requestAnimationFrame(() => knot.classList.remove('is-tangled')),
        );
      };
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(untangle);
      else untangle();
    }

    /* --- "worth": typewriter word + terracotta strike --- */
    const emph = document.querySelector('.hero-type');
    if (!emph || reduce) return;
    const word = emph.getAttribute('data-word') || '';
    const typed = emph.querySelector('.typed');
    const caret = emph.querySelector('.caret');
    if (!typed || !caret || !word) return;

    // Arm immediately so "worth" doesn't appear before it types.
    typed.textContent = '';
    emph.classList.add('is-typing');
    caret.classList.add('is-on');

    const start = () => {
      let i = 0;
      const tick = () => {
        i += 1;
        typed.textContent = word.slice(0, i);
        if (i < word.length) {
          setTimeout(tick, 78);
        } else {
          emph.classList.remove('is-typing'); // strike draws (CSS transition)
          // after the strike, leave the caret blinking at the end of "worth"
          setTimeout(() => caret.classList.add('is-blink'), 600);
        }
      };
      setTimeout(tick, 320); // brief beat before typing
    };

    if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
    else start();
  })();
</script>

<style define:vars={{ knot: `path("${KNOT}")`, line: `path("${LINE}")` }}>
  /* --- the knot visual --- */
  .hero-knot-wrap {
    display: flex;
    justify-content: center;
  }
  .hero-knot {
    width: 100%;
    max-width: 24rem;
    height: auto;
    color: var(--color-ink);
    overflow: visible;
  }
  .hero-knot path {
    d: var(--line); /* default / no-JS / reduced motion: resolved line */
    transition: d 1.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-knot.is-tangled path {
    d: var(--knot);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-knot path {
      d: var(--line);
      transition: none;
    }
  }

  /* --- "worth": typewriter word + terracotta strike --- */
  .emph {
    position: relative;
    white-space: nowrap;
  }
  /* The word reserves its final width via an invisible sizer; the live text and
     caret sit in an absolute layer over it, so typing never shifts "building." */
  .word {
    position: relative;
    display: inline-block;
  }
  .sizer {
    visibility: hidden;
  }
  .live {
    position: absolute;
    left: 0;
    top: 0;
    white-space: nowrap;
  }
  .caret {
    display: none;
    width: 0.06em;
    height: 0.9em;
    margin-left: 0.06em;
    background-color: currentColor;
    vertical-align: -0.04em;
  }
  .caret.is-on {
    display: inline-block;
  }
  .caret.is-blink {
    animation: caret-blink 1.06s steps(1, end) infinite;
  }

  /* The strike is shown by default (no-JS / reduced motion); while typing it's
     hidden, then transitions back in left-to-right when typing finishes. */
  .emph::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.08em;
    background-color: var(--color-terracotta);
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .emph.is-typing::after {
    transform: scaleX(0);
  }

  @keyframes caret-blink {
    0% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* --- Fade-up for the rest of the hero (not the headline) --- */
  @media (prefers-reduced-motion: no-preference) {
    .r {
      opacity: 0;
      transform: translateY(12px);
      animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .r-2 { animation-delay: 0.15s; }
    .r-3 { animation-delay: 0.28s; }
    .r-4 { animation-delay: 0.41s; }
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
