---
/**
 * A quiet text link whose trailing glyph is a knot that untangles into a
 * rightward arrow on hover / keyboard focus.
 *
 * The text already shifts Ink → Terracotta on hover; the SVG stroke is
 * currentColor, so the knot picks up the same colour — one coordinated accent.
 *
 * Motion: the path's `d` morphs between two states that share an identical
 * command structure (M C C C L M L L), so the knot visually pulls straight into
 * the arrow. ~360ms on the house easing. (stroke-dashoffset can only draw a
 * fixed shape, not reshape it, so a `d` morph is the correct tool here.)
 *
 * Accessibility / robustness:
 *  - SVG is aria-hidden; the link text carries the meaning.
 *  - prefers-reduced-motion: the clean arrow is shown statically, no animation.
 *  - :focus-visible triggers the same resolve as hover.
 *  - The resting knot already has an arrowhead, so it's clear and directional on
 *    touch / no-hover devices and in browsers without CSS `d` support.
 *
 *   <ArrowLink href="/about">Read more about us</ArrowLink>
 */
import { href as withBase } from '../lib/href';

interface Props {
  href: string;
  /** Use on Ink/reversed sections (Cream text instead of Ink). */
  onInk?: boolean;
}
const { href, onInk = false } = Astro.props;

// Resting (knot, option 5) and resolved (clean arrow). Same command structure.
const REST = 'M3 12 C8 12 6 7 10 8 C13 9 11 13 8 12 C5 11 14 11 17 12 L21 12 M17 9 L21 12 L17 15';
const ARROW = 'M3 12 C7 12 9 12 11 12 C13 12 15 12 16 12 C18 12 20 12 21 12 L21 12 M15 7 L21 12 L15 17';
---

<a
  href={withBase(href)}
  class:list={[
    'arrow-link font-medium no-underline transition-colors',
    onInk ? 'text-cream hover:text-terracotta' : 'text-ink hover:text-terracotta',
  ]}
>
  <slot /><svg
    class="arrow-link__knot"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={REST} />
  </svg>
</a>

<style define:vars={{ rest: `path("${REST}")`, arrow: `path("${ARROW}")` }}>
  .arrow-link__knot {
    display: inline-block;
    width: 1.45em;
    height: 1em;
    margin-left: 0.4em;
    /* centre the glyph on the text's optical middle, not the line box */
    vertical-align: middle;
    overflow: visible;
  }

  .arrow-link__knot path {
    d: var(--rest);
    transition: d 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .arrow-link:hover .arrow-link__knot path,
  .arrow-link:focus-visible .arrow-link__knot path {
    d: var(--arrow);
  }

  /* Touch devices can't hover, so the knot would never resolve. Instead, resolve
     it to the arrow when the link's section scrolls into view (reusing the
     global [data-reveal] reveal). The d-transition still animates the morph. */
  @media (hover: none) {
    :global([data-reveal].is-visible) .arrow-link__knot path {
      d: var(--arrow);
    }
  }

  /* Reduced motion: show the resolved arrow, no morph. */
  @media (prefers-reduced-motion: reduce) {
    .arrow-link__knot path {
      d: var(--arrow);
      transition: none;
    }
  }
</style>
