---
/**
 * A quiet text link. The trailing arrow slides out of the right edge while a
 * second slides in behind it, and an ember rule draws under the label — the
 * same left-to-right gesture the rest of the site uses.
 *
 * Row is 44px+, so it is a real tap target. Reduced motion keeps the rule and
 * drops the slide.
 */
import { href as withBase } from '../lib/href';

interface Props {
  href: string;
  /** Use inside the contrast panel, whichever ground it has. */
  onPaper?: boolean;
}
const { href, onPaper = false } = Astro.props;
---

<a href={withBase(href)} class:list={['alink', onPaper && 'alink--paper']}>
  <span class="alink__txt"><slot /></span>
  <span class="alink__arrows" aria-hidden="true">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 8h11M9 4l4 4-4 4" />
    </svg>
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 8h11M9 4l4 4-4 4" />
    </svg>
  </span>
</a>

<style>
  .alink {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    color: var(--color-cream);
    text-decoration: none;
    /* --text-sm, not --text-meta: the micro-label pass moved every other label
       to 13px and missed this one, which left it at 11px on desktop and 10px on
       a phone — the smallest type on the site, on a link. */
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .alink--paper {
    color: var(--color-invert-fg);
  }

  .alink__txt {
    position: relative;
  }
  /* The rule under the label: the strike again, at link scale. */
  .alink__txt::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.45em;
    height: 1px;
    background-color: var(--color-ember);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .alink:hover .alink__txt::after,
  .alink:focus-visible .alink__txt::after {
    transform: scaleX(1);
  }

  /* Two arrows on a track: the first leaves right, the second arrives from
     the left, so the glyph reads as continuing rather than jiggling. */
  .alink__arrows {
    position: relative;
    display: block;
    width: 1rem;
    height: 1rem;
    overflow: hidden;
    color: var(--color-ember);
  }
  .alink__arrows svg {
    position: absolute;
    inset: 0;
    width: 1rem;
    height: 1rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .alink__arrows svg:last-child {
    transform: translateX(-120%);
  }
  .alink:hover .alink__arrows svg:first-child,
  .alink:focus-visible .alink__arrows svg:first-child {
    transform: translateX(120%);
  }
  .alink:hover .alink__arrows svg:last-child,
  .alink:focus-visible .alink__arrows svg:last-child {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .alink__arrows svg {
      transition: none;
    }
    .alink__arrows svg:last-child {
      display: none;
    }
    .alink:hover .alink__arrows svg:first-child,
    .alink:focus-visible .alink__arrows svg:first-child {
      transform: none;
    }
  }
</style>
